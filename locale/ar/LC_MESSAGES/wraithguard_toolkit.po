msgid "tes3cmd clean"
msgstr "tes3cmd clean"

msgid "Clean %(count)d plugin file?\n\nEach is staged into a private 'Data Files' with its masters so tes3cmd sees the full VFS; plugins whose masters can't be found are skipped. A one-time .preclean.bak copy of each modified file is kept."
msgid_plural "Clean %(count)d plugin files?\n\nEach is staged into a private 'Data Files' with its masters so tes3cmd sees the full VFS; plugins whose masters can't be found are skipped. A one-time .preclean.bak copy of each modified file is kept."
msgstr[0] "تنظيف %(count)d ملف إضافة؟\n\nيُجهّز كل منها في «Data Files» خاص مع ملفاته الرئيسية ليرى tes3cmd الـ VFS الكامل؛ تُتخطى الإضافات التي لا يمكن إيجاد ملفاتها الرئيسية. تُحفظ نسخة .preclean.bak لمرة واحدة من كل ملف معدّل."
msgstr[1] "تنظيف %(count)d ملف إضافة؟\n\nيُجهّز كل منها في «Data Files» خاص مع ملفاته الرئيسية ليرى tes3cmd الـ VFS الكامل؛ تُتخطى الإضافات التي لا يمكن إيجاد ملفاتها الرئيسية. تُحفظ نسخة .preclean.bak لمرة واحدة من كل ملف معدّل."
msgstr[2] "تنظيف %(count)d ملفَّي إضافة؟\n\nيُجهّز كل منها في «Data Files» خاص مع ملفاته الرئيسية ليرى tes3cmd الـ VFS الكامل؛ تُتخطى الإضافات التي لا يمكن إيجاد ملفاتها الرئيسية. تُحفظ نسخة .preclean.bak لمرة واحدة من كل ملف معدّل."
msgstr[3] "تنظيف %(count)d ملفات إضافة؟\n\nيُجهّز كل منها في «Data Files» خاص مع ملفاته الرئيسية ليرى tes3cmd الـ VFS الكامل؛ تُتخطى الإضافات التي لا يمكن إيجاد ملفاتها الرئيسية. تُحفظ نسخة .preclean.bak لمرة واحدة من كل ملف معدّل."
msgstr[4] "تنظيف %(count)d ملف إضافة؟\n\nيُجهّز كل منها في «Data Files» خاص مع ملفاته الرئيسية ليرى tes3cmd الـ VFS الكامل؛ تُتخطى الإضافات التي لا يمكن إيجاد ملفاتها الرئيسية. تُحفظ نسخة .preclean.bak لمرة واحدة من كل ملف معدّل."
msgstr[5] "تنظيف %(count)d ملف إضافة؟\n\nيُجهّز كل منها في «Data Files» خاص مع ملفاته الرئيسية ليرى tes3cmd الـ VFS الكامل؛ تُتخطى الإضافات التي لا يمكن إيجاد ملفاتها الرئيسية. تُحفظ نسخة .preclean.bak لمرة واحدة من كل ملف معدّل."

msgid "tes3cmd %(command)s running..."
msgstr "tes3cmd %(command)s قيد التشغيل…"

msgid "  Engine: %(command)s"
msgstr "  المحرك: %(command)s"

msgid "  Staging dir: %(path)s"
msgstr "  دليل التجهيز: %(path)s"

msgid "  SKIPPED: could not stage '%(name)s'."
msgstr "  تم التخطي: تعذّر تجهيز «%(name)s»."

msgid "  SKIPPED: master(s) not found in any data folder: %(names)s -- cleaning without the masters present gives wrong results."
msgstr "  تم التخطي: لم يُعثر على الملفات الرئيسية في أي مجلد بيانات: %(names)s -- التنظيف دون وجود الملفات الرئيسية يعطي نتائج خاطئة."

msgid "  (exit code %(code)d) -- original NOT touched"
msgstr "  (رمز الخروج %(code)d) -- الأصل لم يُمس"

msgid "  no changes -- already clean"
msgstr "  لا تغييرات -- نظيف بالفعل"

msgid "  cleaned: %(before)d -> %(after)d bytes (backup: %(backup)s)"
msgstr "  تم التنظيف: %(before)d -> %(after)d بايت (نسخة احتياطية: %(backup)s)"

msgid "  ERROR: %(error)s"
msgstr "  خطأ: %(error)s"

msgid "tes3cmd clean: %(changed)d cleaned, %(clean)d already clean, %(skipped)d skipped (missing masters), %(failed)d failed."
msgstr "tes3cmd clean: تم تنظيف %(changed)d، نظيف بالفعل %(clean)d، تم تخطي %(skipped)d (ملفات رئيسية مفقودة)، فشل %(failed)d."


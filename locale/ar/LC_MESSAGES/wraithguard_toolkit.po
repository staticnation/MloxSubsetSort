msgstr "فشل فحص النسخ الاحتياطية: %(error)s"

msgid "%(count)d backup file. Restore copies the backup over its original; Delete removes the backup file itself."
msgid_plural "%(count)d backup files. Restore copies the backup over its original; Delete removes the backup file itself."
msgstr[0] "%(count)d ملف نسخة احتياطية. الاستعادة تنسخ النسخة فوق أصلها؛ الحذف يزيل ملف النسخة نفسه."
msgstr[1] "%(count)d ملف نسخة احتياطية. الاستعادة تنسخ النسخة فوق أصلها؛ الحذف يزيل ملف النسخة نفسه."

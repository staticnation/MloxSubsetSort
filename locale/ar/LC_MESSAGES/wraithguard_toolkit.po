msgstr "شغّل «1. الترتيب» أولًا لأعرف ترتيب التحميل النشط."

msgid "tes3cmd: added %(count)d list mod(s)"
msgstr "tes3cmd: تمت إضافة %(count)d إضافة من القائمة"

msgid "Set the plugin-order.yml path on the main tab first."
msgstr "عيّن مسار plugin-order.yml في علامة التبويب الرئيسية أولًا."

msgid "Couldn't read plugin-order.yml: %(error)s"
msgstr "تعذّرت قراءة plugin-order.yml: %(error)s"

msgid "tes3cmd: added %(count)d needs-cleaning plugin"
msgid_plural "tes3cmd: added %(count)d needs-cleaning plugins"
msgstr[0] "tes3cmd: تمت إضافة %(count)d إضافة تحتاج تنظيفًا"
msgstr[1] "tes3cmd: تمت إضافة %(count)d إضافة تحتاج تنظيفًا"
msgstr[2] "tes3cmd: تمت إضافة %(count)d إضافتين تحتاجان تنظيفًا"
msgstr[3] "tes3cmd: تمت إضافة %(count)d إضافات تحتاج تنظيفًا"

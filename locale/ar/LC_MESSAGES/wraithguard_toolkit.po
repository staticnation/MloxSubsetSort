msgstr "«%(path)s» غير موجود. أصلح المسار أو امسحه للاكتشاف التلقائي."

msgid "tes3cmd"
msgstr "tes3cmd"

msgid "tes3cmd not found. Browse to the compiled tes3cmd.exe (MOMW Tools Pack)."
msgstr "لم يُعثر على tes3cmd. استعرض للوصول إلى tes3cmd.exe المُترجم (MOMW Tools Pack)."


msgstr "استعادة"

msgid "Copy %(count)d backup over its original (overwriting it)?"
msgid_plural "Copy %(count)d backups over their originals (overwriting them)?"
msgstr[0] "نسخ %(count)d نسخة احتياطية فوق أصلها (الكتابة فوقه)؟"
msgstr[1] "نسخ %(count)d نسخة احتياطية فوق أصلها (الكتابة فوقه)؟"
msgstr[2] "نسخ %(count)d نسختين احتياطيتين فوق أصليهما (الكتابة فوقهما)؟"
msgstr[3] "نسخ %(count)d نسخ احتياطية فوق أصولها (الكتابة فوقها)؟"
msgstr[4] "نسخ %(count)d نسخة احتياطية فوق أصولها (الكتابة فوقها)؟"
msgstr[5] "نسخ %(count)d نسخة احتياطية فوق أصولها (الكتابة فوقها)؟"


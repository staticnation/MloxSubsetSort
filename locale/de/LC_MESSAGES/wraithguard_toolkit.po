msgstr[1] "  HINWEIS: Datenpfad-Einfügungen gefunden, aber nicht sortiert (--sort-data-paths übergeben, um sie einzuschließen): %(count)d Pfade"

msgid "  %(file)s: %(plugins)d content plugin(s), %(paths)d data path(s)"
msgstr "  %(file)s: %(plugins)d Content-Plugin(s), %(paths)d Datenpfad(e)"

msgid "  Loaded %(count)d plugin entry from %(file)s"
msgid_plural "  Loaded %(count)d plugin entries from %(file)s"
msgstr[0] "  %(count)d Plugin-Eintrag aus %(file)s geladen"
msgstr[1] "  %(count)d Plugin-Einträge aus %(file)s geladen"

msgid "  WARNING: could not read plugin-order.yml (%(error)s) -- skipping yml checks."
msgstr "  WARNUNG: plugin-order.yml konnte nicht gelesen werden (%(error)s) -- yml-Prüfungen werden übersprungen."

msgid "  '%(list)s': %(count)d curated plugin on this list"
msgid_plural "  '%(list)s': %(count)d curated plugins on this list"
msgstr[0] "  '%(list)s': %(count)d kuratiertes Plugin auf dieser Liste"
msgstr[1] "  '%(list)s': %(count)d kuratierte Plugins auf dieser Liste"

msgid "  WARNING: no plugins found for list '%(list)s' in the yml -- check the list name spelling. Curated-set checks skipped."
msgstr "  WARNUNG: keine Plugins für die Liste '%(list)s' in der yml gefunden -- prüfe die Schreibweise des Listennamens. Prüfungen des kuratierten Satzes übersprungen."

msgid "  Excluded %(count)d curated plugin from the sort: %(names)s"
msgid_plural "  Excluded %(count)d curated plugins from the sort: %(names)s"
msgstr[0] "  %(count)d kuratiertes Plugin von der Sortierung ausgeschlossen: %(names)s"
msgstr[1] "  %(count)d kuratierte Plugins von der Sortierung ausgeschlossen: %(names)s"

msgid "\n  Already in cfg, will be repositioned within it: %(names)s"
msgstr "\n  Bereits in cfg, wird darin neu positioniert: %(names)s"


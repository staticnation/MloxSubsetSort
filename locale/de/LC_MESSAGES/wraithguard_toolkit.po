msgstr "  Engine: %(engine)s"

msgid "native esp reader (field-level)"
msgstr "nativer ESP-Leser (feldweise)"

msgid "\n  Wrote conflict report: %(path)s"
msgstr "\n  Konfliktbericht geschrieben: %(path)s"

msgid "could not write conflict CSV: %(error)s"
msgstr "Konflikt-CSV konnte nicht geschrieben werden: %(error)s"

msgid "  Scanned %(scanned)d plugin(s): %(exterior)d exterior + %(interior)d interior cell(s) touched."
msgstr "  %(scanned)d Plugin(s) gescannt: %(exterior)d Außen- + %(interior)d Innenzelle(n) berührt."

msgid "  Wrote cell map: %(path)s  (open it in a browser)"
msgstr "  Zellkarte geschrieben: %(path)s  (in einem Browser öffnen)"

msgid "could not write cell map: %(error)s"
msgstr "Zellkarte konnte nicht geschrieben werden: %(error)s"

msgid "  Scanned %(scanned)d plugin(s); %(cells)d interior cell(s), %(grids)d interior pathgrid(s)."
msgstr "  %(scanned)d Plugin(s) gescannt; %(cells)d Innenzelle(n), %(grids)d Innen-Pfadgitter."

msgid "\n  No lint findings."
msgstr "\n  Keine Prüfbefunde."

msgid "\n  Wrote resource report: %(path)s"
msgstr "\n  Ressourcenbericht geschrieben: %(path)s"

msgid "could not write resource CSV: %(error)s"
msgstr "Ressourcen-CSV konnte nicht geschrieben werden: %(error)s"

msgid "  Pass --sort-data-paths to enable:"
msgstr "  Übergib --sort-data-paths zum Aktivieren:"

msgid "  <-- inserted"
msgstr "  <-- eingefügt"

msgid "UNMANAGED (ORPHAN) ENTRIES FROM openmw.cfg"
msgstr "NICHT VERWALTETE (VERWAISTE) EINTRÄGE AUS openmw.cfg"

msgid "  %(count)d orphan plugin pulled from openmw.cfg"
msgid_plural "  %(count)d orphan plugins pulled from openmw.cfg"
msgstr[0] "  %(count)d verwaistes Plugin aus openmw.cfg übernommen"
msgstr[1] "  %(count)d verwaiste Plugins aus openmw.cfg übernommen"

msgid "  No unmanaged plugins found -- every content= plugin in the cfg is on the list or in your customizations."
msgstr "  Keine nicht verwalteten Plugins gefunden -- jedes content=-Plugin in der cfg ist auf der Liste oder in deinen Anpassungen."

msgid "groundcover declared by this run"
msgstr "von diesem Lauf deklarierter groundcover"

msgid "  These are written as groundcover= rather than content=. Their data= folders are inserted normally -- OpenMW has to find the file."
msgstr "  Diese werden als groundcover= statt content= geschrieben. Ihre data=-Ordner werden normal eingefügt -- OpenMW muss die Datei finden."

msgid "groundcover plugins held back"
msgstr "zurückgehaltene groundcover-Plugins"

msgid "%(count)d plugin in your subset is already declared as groundcover in openmw.cfg, so it was NOT added to content=:"
msgid_plural "%(count)d plugins in your subset are already declared as groundcover in openmw.cfg, so they were NOT added to content=:"
msgstr[0] "%(count)d Plugin in deiner Teilmenge ist in openmw.cfg bereits als groundcover deklariert und wurde daher NICHT zu content= hinzugefügt:"
msgstr[1] "%(count)d Plugins in deiner Teilmenge sind in openmw.cfg bereits als groundcover deklariert und wurden daher NICHT zu content= hinzugefügt:"

msgid "  Their groundcover= lines are untouched and their data= paths are still written, so the grass stays enabled -- as grass. Loading one as content= too would spawn every blade as a real object."
msgstr "  Ihre groundcover=-Zeilen bleiben unberührt und ihre data=-Pfade werden weiterhin geschrieben, sodass das Gras aktiviert bleibt -- als Gras. Eines zusätzlich als content= zu laden, würde jeden Halm als echtes Objekt spawnen."

msgid "  openmw.cfg left untouched (pass --write-cfg to patch it directly)"
msgstr "  openmw.cfg unberührt gelassen (übergib --write-cfg, um sie direkt zu patchen)"

msgid "  WARNING: configurator preview failed: %(error)s"
msgstr "  WARNUNG: Configurator-Vorschau fehlgeschlagen: %(error)s"

msgid "\n  DRY RUN: would write %(path)s\n%(toml)s"
msgstr "\n  PROBELAUF: würde %(path)s schreiben\n%(toml)s"

msgid "  Wrote corrected customizations: %(path)s"
msgstr "  Korrigierte Anpassungen geschrieben: %(path)s"

msgid "  Plugins sorted:        %(count)d"
msgstr "  Plugins sortiert:       %(count)d"

msgid "  Data paths inserted:   %(count)d"
msgstr "  Datenpfade eingefügt:   %(count)d"

msgid "  Rule warnings raised:  %(count)d"
msgstr "  Regelwarnungen:         %(count)d"

msgid "  plugin-order.yml warnings: %(count)d"
msgstr "  plugin-order.yml-Warnungen: %(count)d"

msgid "  openmw.cfg written:    %(answer)s"
msgstr "  openmw.cfg geschrieben: %(answer)s"

msgid "yes"
msgstr "ja"

msgid "no"
msgstr "nein"

msgid "  customizations.toml written: %(answer)s"
msgstr "  customizations.toml geschrieben: %(answer)s"

msgid "Rule files (priority = order below, last = highest -- drag rows to reorder)"
msgstr "Regeldateien (Priorität = Reihenfolge unten, letzte = höchste -- Zeilen zum Umordnen ziehen)"

msgid "mlox rule files (mlox_base.txt, mlox_user.txt, ...), applied in this order.\nLater files can override/extend earlier ones -- put mlox_base.txt first and your own mlox_user.txt last. Drag rows to reorder, or use the buttons."
msgstr "mlox-Regeldateien (mlox_base.txt, mlox_user.txt, …), in dieser Reihenfolge angewendet.\nSpätere Dateien können frühere überschreiben/erweitern -- setze mlox_base.txt zuerst und deine eigene mlox_user.txt zuletzt. Zeilen zum Umordnen ziehen oder die Schaltflächen nutzen."

msgid "Add File(s)..."
msgstr "Datei(en) hinzufügen …"

msgid "Browse for one or more mlox rule .txt files to add to the list."
msgstr "Wähle eine oder mehrere mlox-Regel-.txt-Dateien zum Hinzufügen zur Liste."

msgid "Remove Selected"
msgstr "Auswahl entfernen"

msgid "Remove the selected rule file from the list (doesn't delete anything on disk)."
msgstr "Entferne die ausgewählte Regeldatei aus der Liste (löscht nichts auf der Festplatte)."

msgid "Move Up"
msgstr "Nach oben"

msgid "Move the selected rule file earlier (lower priority)."
msgstr "Verschiebe die ausgewählte Regeldatei nach vorne (niedrigere Priorität)."

msgid "Move Down"
msgstr "Nach unten"

msgid "Move the selected rule file later (higher priority)."
msgstr "Verschiebe die ausgewählte Regeldatei nach hinten (höhere Priorität)."

msgid "New Rule..."
msgstr "Neue Regel …"

msgid "Write your own mlox [Order]/[NearStart]/[NearEnd] rule without knowing the syntax: pick plugins (or grab the selected rows from the plugin panel), preview the rule, and append it to a personal rules file that loads LAST so it wins conflicts. This is how rules for modern mods get made -- consider contributing good ones upstream."
msgstr "Schreibe deine eigene mlox-[Order]/[NearStart]/[NearEnd]-Regel, ohne die Syntax zu kennen: Plugins auswählen (oder die ausgewählten Zeilen aus dem Plugin-Panel übernehmen), die Regel in der Vorschau ansehen und an eine persönliche Regeldatei anhängen, die ZULETZT lädt, sodass sie Konflikte gewinnt. So entstehen Regeln für moderne Mods -- erwäge, gute davon upstream beizutragen."

msgid "Update Rules..."
msgstr "Regeln aktualisieren …"

msgid "Download the CURRENT mlox_base.txt / mlox_user.txt from the actively maintained rules repo (github.com/%(repo)s -- the same source plox uses, and mlox 1.1+ auto-updates from) over the matching files in this list. The old files are kept as timestamped .bak copies. Files with other names (your personal rules) are never touched. Source URL configurable via Sources..."
msgstr "Lade die AKTUELLE mlox_base.txt / mlox_user.txt aus dem aktiv gepflegten Regel-Repo (github.com/%(repo)s -- dieselbe Quelle, die plox nutzt und von der sich mlox 1.1+ automatisch aktualisiert) über die passenden Dateien in dieser Liste. Die alten Dateien werden als mit Zeitstempel versehene .bak-Kopien behalten. Dateien mit anderen Namen (deine persönlichen Regeln) werden nie berührt. Quell-URL über Quellen … konfigurierbar."

msgid "Sources..."
msgstr "Quellen …"

msgid "Configure WHERE 'Update Rules...' and the plugin-order.yml 'Update...' button download from -- point them at a fork or mirror if upstream moves. Blank fields use the built-in defaults."
msgstr "Konfiguriere, WOHER 'Regeln aktualisieren …' und die plugin-order.yml-'Aktualisieren …'-Schaltfläche herunterladen -- verweise sie auf einen Fork oder Spiegel, falls upstream umzieht. Leere Felder nutzen die eingebauten Standardwerte."

msgid "(install tkinterdnd2 to drag files in from your file manager)"
msgstr "(installiere tkinterdnd2, um Dateien aus deinem Dateimanager hereinzuziehen)"

msgid "Choose a folder for the mlox rule files"
msgstr "Wähle einen Ordner für die mlox-Regeldateien"

msgid "Update rules"
msgstr "Regeln aktualisieren"

msgid "Download the current mlox rules from github.com/%(repo)s?\n\n%(files)s\n\nThey don't exist yet -- they'll be created here."
msgstr "Die aktuellen mlox-Regeln von github.com/%(repo)s herunterladen?\n\n%(files)s\n\nSie existieren noch nicht -- sie werden hier erstellt."

msgid "Download the current rules from github.com/%(repo)s over these files?\n\n%(age)s\n\nTimestamped .bak copies of the old files are kept."
msgstr "Die aktuellen Regeln von github.com/%(repo)s über diese Dateien herunterladen?\n\n%(age)s\n\nMit Zeitstempel versehene .bak-Kopien der alten Dateien werden behalten."

msgid "Move the selected row(s) one position earlier. Works with a multi-selection; you can also drag a contiguous block up with the mouse."
msgstr "Verschiebe die ausgewählte(n) Zeile(n) eine Position nach vorne. Funktioniert mit Mehrfachauswahl; du kannst auch einen zusammenhängenden Block mit der Maus nach oben ziehen."

msgid "Move the selected row(s) one position later. Works with a multi-selection; you can also drag a contiguous block down with the mouse."
msgstr "Verschiebe die ausgewählte(n) Zeile(n) eine Position nach hinten. Funktioniert mit Mehrfachauswahl; du kannst auch einen zusammenhängenden Block mit der Maus nach unten ziehen."

msgid "Disable / Enable"
msgstr "Deaktivieren / Aktivieren"

msgid "Opt the selected row in or out of the load order. Disabled rows are dimmed and marked, and are left out of Export: a custom item is simply not inserted, and an item already in your openmw.cfg gets a removeContent/removeData entry in the emitted TOML so it's durably removed. Double-click a row to toggle it too."
msgstr "Nimm die ausgewählte Zeile in die Ladereihenfolge auf oder heraus. Deaktivierte Zeilen werden gedimmt und markiert und beim Export weggelassen: ein eigenes Element wird einfach nicht eingefügt, und ein bereits in deiner openmw.cfg vorhandenes Element erhält im erzeugten TOML einen removeContent/removeData-Eintrag, sodass es dauerhaft entfernt wird. Doppelklick auf eine Zeile schaltet sie ebenfalls um."

msgid "Discard any manual dragging and restore the order from the last Sort (your disable/enable choices are kept)."
msgstr "Verwirf jegliches manuelle Ziehen und stelle die Reihenfolge aus der letzten Sortierung wieder her (deine Aktivieren/Deaktivieren-Entscheidungen bleiben erhalten)."

msgid "Plugin load order -- drag to override mlox (red = touched by this sort, purple = master problem)"
msgstr "Plugin-Ladereihenfolge -- ziehen, um mlox zu überstimmen (rot = von dieser Sortierung berührt, violett = Master-Problem)"

msgid "Data path order -- drag to adjust (highlighted = your custom paths)"
msgstr "Datenpfad-Reihenfolge -- ziehen zum Anpassen (hervorgehoben = deine eigenen Pfade)"

msgid "Drag & drop is unavailable (tkinterdnd2 or its tkdnd library is missing) -- use the Browse buttons below."
msgstr "Drag & Drop ist nicht verfügbar (tkinterdnd2 oder seine tkdnd-Bibliothek fehlt) -- nutze die Durchsuchen-Schaltflächen unten."

msgid "Required. The openmw.cfg to read the current content= and data= order from, and (if 'Write openmw.cfg directly' is checked) to patch."
msgstr "Erforderlich. Die openmw.cfg, aus der die aktuelle content=- und data=-Reihenfolge gelesen wird und die (falls 'openmw.cfg direkt schreiben' angehakt ist) gepatcht wird."

msgid "A momw-configurator/umo customizations TOML to pull the plugin/data-path subset from automatically. Optional if you provide a subset file instead -- provide both and they're combined."
msgstr "Eine momw-configurator/umo-customizations-TOML, aus der die Plugin-/Datenpfad-Teilmenge automatisch gezogen wird. Optional, wenn du stattdessen eine Teilmengen-Datei angibst -- gib beide an, und sie werden kombiniert."

msgid "A plain text file (one plugin filename or data folder path per line, '#' comments allowed) or a minimal TOML with subset=[...]/data=[...]. Combined with --emit-toml, this alone is enough to generate a brand new customizations.toml with no existing one required."
msgstr "Eine reine Textdatei (ein Plugin-Dateiname oder Datenordnerpfad pro Zeile, '#'-Kommentare erlaubt) oder eine minimale TOML mit subset=[...]/data=[...]. Zusammen mit --emit-toml reicht dies allein aus, um eine brandneue customizations.toml zu erzeugen, ohne dass eine vorhandene nötig ist."

msgid "Where to write a corrected customizations.toml (sorted insert blocks, re-anchored). Disabled when 'write directly back' below is checked."
msgstr "Wohin eine korrigierte customizations.toml geschrieben wird (sortierte Einfügeblöcke, neu verankert). Deaktiviert, wenn 'direkt zurückschreiben' unten angehakt ist."

msgid "list name (optional):"
msgstr "Listenname (optional):"

msgid "MOMW's plugin-order.yml (source of truth for which plugins belong to which curated list). With the list name above set, curated plugins for that list are excluded from the sort (never reordered) so only your custom additions are touched, and read-only warnings are emitted: redundant, orphan, needs-cleaning, and a base-order drift check. PyYAML used if installed, else a built-in parser."
msgstr "MOMWs plugin-order.yml (die Quelle der Wahrheit, welche Plugins zu welcher kuratierten Liste gehören). Mit dem oben gesetzten Listennamen werden kuratierte Plugins dieser Liste von der Sortierung ausgeschlossen (nie umgeordnet), sodass nur deine eigenen Ergänzungen berührt werden, und es werden schreibgeschützte Warnungen ausgegeben: redundant, verwaist, needs-cleaning und eine Basis-Reihenfolge-Abweichungsprüfung. PyYAML wird genutzt, falls installiert, sonst ein eingebauter Parser."

msgid "Write directly back to customizations.toml (overwrite in place; a .bak-<timestamp> copy is made first unless backups are disabled below)"
msgstr "Direkt in die customizations.toml zurückschreiben (an Ort und Stelle überschreiben; zuerst wird eine .bak-<Zeitstempel>-Kopie erstellt, sofern Sicherungen unten nicht deaktiviert sind)"

msgid "Instead of writing to a separate file above, overwrite the customizations.toml given above in place. A timestamped backup is made first (unless disabled), and you'll get a confirmation prompt before it actually happens."
msgstr "Statt in eine separate Datei oben zu schreiben, die oben angegebene customizations.toml an Ort und Stelle überschreiben. Zuerst wird eine mit Zeitstempel versehene Sicherung erstellt (sofern nicht deaktiviert), und du erhältst eine Bestätigungsabfrage, bevor es tatsächlich passiert."

msgid "Options"
msgstr "Optionen"

msgid "Dry run (preview only, don't write files)"
msgstr "Probelauf (nur Vorschau, keine Dateien schreiben)"

msgid "When checked, Export shows exactly what it would write without touching any files. Uncheck when you're ready to actually save."
msgstr "Wenn angehakt, zeigt der Export genau, was er schreiben würde, ohne Dateien zu berühren. Hake es ab, wenn du bereit bist, tatsächlich zu speichern."

msgid "Write openmw.cfg directly"
msgstr "openmw.cfg direkt schreiben"

msgid "Patch the content=/data= lines in openmw.cfg in place on Export. A .bak-<timestamp> copy is made first unless backups are disabled."
msgstr "Patche die content=-/data=-Zeilen in openmw.cfg beim Export an Ort und Stelle. Zuerst wird eine .bak-<Zeitstempel>-Kopie erstellt, sofern Sicherungen nicht deaktiviert sind."

msgid "Sort data= paths too"
msgstr "Auch data=-Pfade sortieren"

msgid "mlox has no concept of data= folder order -- this positions new data= paths using an explicit after/before anchor if you wrote one, or by scanning the folder for plugins and anchoring next to their neighbor in the sorted content= order. Off by default so a plugin-only run can't surprise-reorder data= too. Also required for the data path order panel to populate."
msgstr "mlox kennt kein Konzept der data=-Ordnerreihenfolge -- dies positioniert neue data=-Pfade mit einem expliziten after/before-Anker, falls du einen geschrieben hast, oder indem der Ordner nach Plugins durchsucht und neben deren Nachbarn in der sortierten content=-Reihenfolge verankert wird. Standardmäßig aus, damit ein reiner Plugin-Lauf data= nicht überraschend mit umordnen kann. Außerdem nötig, damit sich das Datenpfad-Reihenfolge-Panel füllt."

msgid "Skip .bak backup of openmw.cfg"
msgstr "Keine .bak-Sicherung von openmw.cfg"

msgid "Skip making a timestamped backup before overwriting openmw.cfg and/or an in-place customizations.toml. Not recommended."
msgstr "Überspringe das Erstellen einer mit Zeitstempel versehenen Sicherung vor dem Überschreiben von openmw.cfg und/oder einer customizations.toml an Ort und Stelle. Nicht empfohlen."

msgid "Skip mlox Conflict/Requires/Note warnings"
msgstr "mlox-Conflict/Requires/Note-Warnungen überspringen"

msgid "Skip evaluating [Conflict]/[Requires]/[Note] rules against the sorted plugin list. This is purely informational and read-only either way -- it never changes the computed order or what gets written, only whether warnings get printed."
msgstr "Überspringe das Auswerten von [Conflict]/[Requires]/[Note]-Regeln gegen die sortierte Plugin-Liste. Dies ist rein informativ und so oder so schreibgeschützt -- es ändert nie die berechnete Reihenfolge oder das, was geschrieben wird, nur ob Warnungen ausgegeben werden."

msgid "Create subset text document (on Scan)"
msgstr "Teilmengen-Textdokument erstellen (beim Scan)"

msgid "Controls what 'Scan...' does with its result. Checked: write the scanned list to a .txt subset file you choose, and load it (the file stays on disk for reuse). Unchecked: keep the scanned list in memory just for this session and feed it straight to the sort -- nothing is written to disk."
msgstr "Steuert, was 'Scan …' mit seinem Ergebnis tut. Angehakt: schreibe die gescannte Liste in eine von dir gewählte .txt-Teilmengen-Datei und lade sie (die Datei bleibt zur Wiederverwendung auf der Festplatte). Nicht angehakt: behalte die gescannte Liste nur für diese Sitzung im Speicher und übergib sie direkt an die Sortierung -- nichts wird auf die Festplatte geschrieben."

msgid "Pull unmanaged (orphan) plugins from openmw.cfg"
msgstr "Nicht verwaltete (verwaiste) Plugins aus openmw.cfg übernehmen"

msgid "Also sort the content= plugins ALREADY in openmw.cfg that nothing manages -- neither the curated list (plugin-order.yml) nor your customizations.toml. Their current cfg order is kept as the starting order until the sort repositions them. Base masters (Morrowind/Tribunal/Bloodmoon) are never touched. Works on its own (no subset file needed) or alongside one.\n\ndata= paths are left exactly as openmw.cfg has them: they are already in the cfg's own data= order, and there is no reliable way to tell a path the list manages from one you added, so pulling them would reorder the whole VFS."
msgstr "Sortiere auch die content=-Plugins, die BEREITS in openmw.cfg sind und die nichts verwaltet -- weder die kuratierte Liste (plugin-order.yml) noch deine customizations.toml. Ihre aktuelle cfg-Reihenfolge wird als Startreihenfolge beibehalten, bis die Sortierung sie neu positioniert. Basis-Master (Morrowind/Tribunal/Bloodmoon) werden nie berührt. Funktioniert allein (keine Teilmengen-Datei nötig) oder zusammen mit einer.\n\ndata=-Pfade bleiben genau so, wie openmw.cfg sie hat: sie sind bereits in der eigenen data=-Reihenfolge der cfg, und es gibt keine zuverlässige Möglichkeit, einen von der Liste verwalteten Pfad von einem selbst hinzugefügten zu unterscheiden, daher würde ihr Übernehmen das gesamte VFS umordnen."

msgid "Exclude from conflict / cell scans:"
msgstr "Von Konflikt-/Zellscans ausschließen:"

msgid "Declare as groundcover:"
msgstr "Als groundcover deklarieren:"

msgid "Keep tes3conv JSON dump"
msgstr "tes3conv-JSON-Ausgabe behalten"

msgid "Tidy old HTML views"
msgstr "Alte HTML-Ansichten aufräumen"

msgid "Every conflict map, terrain view and path grid is written to its own timestamped file so you can compare two of them side by side -- which means they pile up, and one map can be several megabytes.\n\nChecked: on exit, the newest 3 of each kind are kept and older ones removed (with their data folders). Only files this tool generated are ever touched -- never anything you saved yourself with a name of your own choosing.\n\nUnchecked: nothing is ever deleted."
msgstr "Jede Konfliktkarte, Geländeansicht und jedes Pfadgitter wird in eine eigene, mit Zeitstempel versehene Datei geschrieben, sodass du zwei davon nebeneinander vergleichen kannst -- was bedeutet, dass sie sich anhäufen, und eine Karte kann mehrere Megabyte groß sein.\n\nAngehakt: beim Beenden werden die neuesten 3 jeder Art behalten und ältere entfernt (samt ihren Datenordnern). Nur von diesem Werkzeug erzeugte Dateien werden je berührt -- nie etwas, das du selbst unter einem eigenen Namen gespeichert hast.\n\nNicht angehakt: es wird nie etwas gelöscht."

msgid "tes3conv conversions are written to disk (not held in RAM) and read per-plugin, so big load orders don't blow up memory. They always go to a 'tes3conv_json' folder next to the app and are reused within a run -- so Check Conflicts then Cell Map won't re-run tes3conv (a plugin is only re-converted if it changed). This box just decides what happens on exit: checked = keep that folder (reused next launch too); unchecked = delete it when you close the app."
msgstr "tes3conv-Konvertierungen werden auf die Festplatte geschrieben (nicht im RAM gehalten) und pro Plugin gelesen, damit große Ladereihenfolgen den Speicher nicht sprengen. Sie landen immer in einem 'tes3conv_json'-Ordner neben der App und werden innerhalb eines Laufs wiederverwendet -- sodass Konflikte prüfen und dann Zellkarte tes3conv nicht erneut ausführen (ein Plugin wird nur neu konvertiert, wenn es sich geändert hat). Dieses Kästchen entscheidet nur, was beim Beenden passiert: angehakt = diesen Ordner behalten (auch beim nächsten Start wiederverwendet); nicht angehakt = ihn beim Schließen der App löschen."

msgid "Verbose Merged Lands log"
msgstr "Ausführliches Merged-Lands-Protokoll"

msgid "Checked: a Merge Lands run also names every plugin that carries a .mergedlands.toml and exactly what it sets (per layer: on/off and the conflict strategy), and lists every plugin it could not read -- rather than the headline counts. For working out why a merge did what it did.\n\nUnchecked: the normal summary log."
msgstr "Angehakt: ein Merge-Lands-Lauf nennt außerdem jedes Plugin, das eine .mergedlands.toml trägt, und genau, was es setzt (pro Ebene: an/aus und die Konfliktstrategie), und listet jedes Plugin auf, das nicht gelesen werden konnte -- statt der Kopfzahlen. Um herauszufinden, warum ein Merge tat, was er tat.\n\nNicht angehakt: das normale Zusammenfassungs-Protokoll."

msgid "Log"
msgstr "Protokoll"

msgid "Full output from the last Sort and/or Export. Color key: green = a plugin/path this sort inserted or moved, orange = a heads-up (mlox warning, or a rule your curated cfg order overrode), blue = a section header, bright red = an error worth checking. Plain text = frozen base rows left untouched. Colors follow the syntax highlighting theme picked below."
msgstr "Vollständige Ausgabe der letzten Sortierung und/oder des Exports. Farbschlüssel: grün = ein Plugin/Pfad, das/den diese Sortierung eingefügt oder verschoben hat, orange = ein Hinweis (mlox-Warnung oder eine Regel, die deine kuratierte cfg-Reihenfolge überstimmt hat), blau = eine Abschnittsüberschrift, hellrot = ein Fehler, der eine Prüfung wert ist. Klartext = eingefrorene Basiszeilen, unberührt gelassen. Die Farben folgen dem unten gewählten Syntaxhervorhebungs-Design."

msgid "Clear Log"
msgstr "Protokoll leeren"

msgid "Clear the log panel. Doesn't affect the order panels or any files."
msgstr "Leert das Protokoll-Panel. Betrifft weder die Reihenfolge-Panels noch Dateien."

msgid "Save Log As..."
msgstr "Protokoll speichern unter …"

msgid "Save the current log contents to a text file."
msgstr "Speichert den aktuellen Protokollinhalt in eine Textdatei."

msgid "Theme:"
msgstr "Design:"

msgid "Color theme for the whole GUI: window/button colors, syntax highlighting here in the Log panel, and the field-diff JSON viewer (Check Conflicts -> double-click a field). Switching re-themes everything immediately, including any windows already open. Built-in: Dracula, Monokai, Atom One Dark, Gruvbox Dark, plus anything you've imported."
msgstr "Farbdesign für die gesamte GUI: Fenster-/Schaltflächenfarben, Syntaxhervorhebung hier im Protokoll-Panel und der Feld-Diff-JSON-Betrachter (Konflikte prüfen -> Doppelklick auf ein Feld). Ein Wechsel gestaltet alles sofort neu, auch bereits geöffnete Fenster. Eingebaut: Dracula, Monokai, Atom One Dark, Gruvbox Dark, plus alles, was du importiert hast."

msgid "Import Theme..."
msgstr "Design importieren …"

msgid "Import a custom theme from a JSON file (background/foreground/select/section/warn/error/ok/inserted/dim as hex colors, plus an optional \"chrome\" object for explicit window/button colors) or a base16 scheme file (.yaml/.yml/.json with base00..base0F -- e.g. from the atelierbram/syntax-highlighting or chriskempson/base16 scheme repos). Window colors not given explicitly are derived from the background. Imported themes are saved and appear in the dropdown from then on."
msgstr "Importiere ein eigenes Design aus einer JSON-Datei (background/foreground/select/section/warn/error/ok/inserted/dim als Hex-Farben, plus ein optionales \"chrome\"-Objekt für explizite Fenster-/Schaltflächenfarben) oder einer base16-Schema-Datei (.yaml/.yml/.json mit base00..base0F -- z. B. aus den Schema-Repos atelierbram/syntax-highlighting oder chriskempson/base16). Nicht explizit angegebene Fensterfarben werden aus dem Hintergrund abgeleitet. Importierte Designs werden gespeichert und erscheinen von da an im Dropdown."

msgid "Clear Memory"
msgstr "Speicher leeren"

msgid "Forget every plugin/folder added by hand (drag-drop or the Add buttons) and any scan result held only in memory (not saved to a .txt) -- none of that is shown anywhere on screen, and it otherwise keeps accumulating for the rest of the session. Does not touch any files."
msgstr "Vergiss jedes von Hand hinzugefügte Plugin/jeden Ordner (Drag-and-Drop oder die Hinzufügen-Schaltflächen) und jedes nur im Speicher gehaltene Scan-Ergebnis (nicht in einer .txt gespeichert) -- nichts davon wird irgendwo auf dem Bildschirm angezeigt, und es häuft sich sonst für den Rest der Sitzung an. Berührt keine Dateien."

msgid "Help"
msgstr "Hilfe"

msgid "Open the program's own documentation -- the Quick start (what to click, in order) or the Read me (every option, in detail) -- rendered as a readable page with a contents sidebar. Works offline; nothing is downloaded."
msgstr "Öffne die programmeigene Dokumentation -- den Schnellstart (was in welcher Reihenfolge zu klicken ist) oder die Lies-mich (jede Option im Detail) -- als lesbare Seite mit Inhalts-Seitenleiste dargestellt. Funktioniert offline; nichts wird heruntergeladen."

msgid "Log syntax highlighting: %(name)s"
msgstr "Protokoll-Syntaxhervorhebung: %(name)s"

msgid "Import syntax highlighting theme"
msgstr "Syntaxhervorhebungs-Design importieren"

msgid "Import failed"
msgstr "Import fehlgeschlagen"

msgid "Couldn't import that theme:\n\n%(error)s"
msgstr "Dieses Design konnte nicht importiert werden:\n\n%(error)s"

msgid "Imported and applied theme: %(name)s"
msgstr "Design importiert und angewendet: %(name)s"

msgid "Theme imported"
msgstr "Design importiert"

msgid "Imported \"%(name)s\" and set it as the active log theme."
msgstr "\"%(name)s\" importiert und als aktives Protokoll-Design gesetzt."

msgid "Missing input"
msgstr "Fehlende Eingabe"

msgid "Select the mods folder to scan"
msgstr "Wähle den zu durchsuchenden Mods-Ordner"

msgid "Save generated subset file as"
msgstr "Erzeugte Teilmengen-Datei speichern unter"

msgid "Scanning mods folder..."
msgstr "Durchsuche Mods-Ordner …"

msgid "Scan complete -- %(folders)d folder(s), %(plugins)d plugin(s). Subset file loaded."
msgstr "Scan abgeschlossen -- %(folders)d Ordner, %(plugins)d Plugin(s). Teilmengen-Datei geladen."

msgid "Scan complete -- %(folders)d folder(s), %(plugins)d plugin(s). Held in memory (no file written)."
msgstr "Scan abgeschlossen -- %(folders)d Ordner, %(plugins)d Plugin(s). Im Speicher gehalten (keine Datei geschrieben)."

msgid "Add plugin..."
msgstr "Plugin hinzufügen …"

msgid "Include a plugin the Scan missed -- e.g. one sitting outside a recognised mod folder. It joins your custom subset on the next Sort. You can also drag a plugin file onto the list above from your file manager."
msgstr "Schließe ein vom Scan übersehenes Plugin ein -- z. B. eines außerhalb eines erkannten Mod-Ordners. Es kommt bei der nächsten Sortierung zu deiner eigenen Teilmenge. Du kannst auch eine Plugin-Datei aus deinem Dateimanager auf die Liste oben ziehen."

msgid "(install tkinterdnd2 to drag a plugin in)"
msgstr "(installiere tkinterdnd2, um ein Plugin hereinzuziehen)"

msgid "Add data folder..."
msgstr "Datenordner hinzufügen …"

msgid "Include a folder the Scan missed -- e.g. an OpenMW Lua mod with a non-standard layout (no meshes/textures/... folder and no plugin). It joins your data paths on the next Sort; tick 'Sort data= paths too' to place it in the load order. You can also drag a folder onto the list above from your file manager."
msgstr "Schließe einen vom Scan übersehenen Ordner ein -- z. B. einen OpenMW-Lua-Mod mit unüblichem Aufbau (kein meshes/textures/…-Ordner und kein Plugin). Er kommt bei der nächsten Sortierung zu deinen Datenpfaden; hake 'Auch data=-Pfade sortieren' an, um ihn in der Ladereihenfolge zu platzieren. Du kannst auch einen Ordner aus deinem Dateimanager auf die Liste oben ziehen."

msgid "(install tkinterdnd2 to drag a folder in)"
msgstr "(installiere tkinterdnd2, um einen Ordner hereinzuziehen)"

msgid "Select a data folder to add"
msgstr "Wähle einen hinzuzufügenden Datenordner"

msgid "Select plugin(s) to add"
msgstr "Wähle hinzuzufügende Plugin(s)"

msgid "Plugins"
msgstr "Plugins"

msgid "Added plugin"
msgstr "Plugin hinzugefügt"

msgid "Already added"
msgstr "Bereits hinzugefügt"

msgid "Added data folder"
msgstr "Datenordner hinzugefügt"

msgid "  Tick 'Sort data= paths too' to place it."
msgstr "  Hake 'Auch data=-Pfade sortieren' an, um ihn zu platzieren."

msgid "Not a plugin or folder: %(path)s"
msgstr "Kein Plugin oder Ordner: %(path)s"

msgid "Nothing to clear."
msgstr "Nichts zu leeren."

msgid "%(n)d manual plugin(s)"
msgstr "%(n)d manuelle(s) Plugin(s)"

msgid "%(n)d manual data folder(s)"
msgstr "%(n)d manuelle(r) Datenordner"

msgid "the in-memory scan result"
msgstr "das Scan-Ergebnis im Speicher"

msgid "Clear memory?"
msgstr "Speicher leeren?"

msgid "This forgets everything added by hand this session and any scan result held in memory (not written to a subset file):\n\n%(summary)s\n\nThey will no longer be included on the next Sort. This does not touch the subset file field, remembered paths, or any file on disk. Continue?"
msgstr "Dies vergisst alles, was in dieser Sitzung von Hand hinzugefügt wurde, und jedes im Speicher gehaltene Scan-Ergebnis (nicht in eine Teilmengen-Datei geschrieben):\n\n%(summary)s\n\nSie werden bei der nächsten Sortierung nicht mehr einbezogen. Dies berührt weder das Teilmengen-Datei-Feld, gemerkte Pfade noch irgendeine Datei auf der Festplatte. Fortfahren?"

msgid "Cleared: %(summary)s"
msgstr "Geleert: %(summary)s"

msgid "%(what)s (%(n)d added, applied on Sort): %(value)s"
msgstr "%(what)s (%(n)d hinzugefügt, bei Sortierung angewendet): %(value)s"

msgid "Sorting..."
msgstr "Sortiere …"

msgid ", %(count)d yml warning(s)"
msgstr ", %(count)d yml-Warnung(en)"

msgid "Sorted %(plugins)d plugin(s), %(warnings)d rule warning(s)%(yml)s. Drag to adjust, then Export."
msgstr "%(plugins)d Plugin(s) sortiert, %(warnings)d Regelwarnung(en)%(yml)s. Zum Anpassen ziehen, dann Exportieren."

msgid "openmw.cfg changed"
msgstr "openmw.cfg geändert"

msgid "openmw.cfg has changed on disk since you ran '1. Sort' (did momw-configurator re-run?).\n\nThe order on screen was computed against the OLD contents. It's safer to re-Sort first.\n\nExport anyway?"
msgstr "openmw.cfg hat sich auf der Festplatte geändert, seit du '1. Sortieren' ausgeführt hast (hat momw-configurator erneut gelaufen?).\n\nDie Reihenfolge auf dem Bildschirm wurde gegen den ALTEN Inhalt berechnet. Es ist sicherer, zuerst neu zu sortieren.\n\nTrotzdem exportieren?"

msgid "Overwrite customizations.toml?"
msgstr "customizations.toml überschreiben?"

msgid "This will overwrite:\n%(path)s\n\nin place%(note)s. Continue?"
msgstr "Dies überschreibt:\n%(path)s\n\nan Ort und Stelle%(note)s. Fortfahren?"

msgid "Exporting..."
msgstr "Exportiere …"

msgid "Export done -- cfg written: %(cfg)s, toml written: %(toml)s."
msgstr "Export fertig -- cfg geschrieben: %(cfg)s, toml geschrieben: %(toml)s."

msgid "Building cell map..."
msgstr "Erstelle Zellkarte …"

msgid "\n\nThis REPLACES the existing %(name)s."
msgstr "\n\nDies ERSETZT das vorhandene %(name)s."

msgid "Build Merged Lands.esp?"
msgstr "Merged Lands.esp erstellen?"

msgid "A new plugin will be written to:\n%(path)s\n\nIt carries terrain only -- no references, objects or scripts -- so everything placed in those cells stays where it is. Your mods are NOT modified, and deleting the merged plugin restores your previous behaviour completely.\n\nLoad it LAST, and back up your saves before playing with it the first time.%(existing)s\n\nYes: write it here.   No: choose a different folder."
msgstr "Ein neues Plugin wird geschrieben nach:\n%(path)s\n\nEs trägt nur Gelände -- keine Referenzen, Objekte oder Skripte -- sodass alles, was in diesen Zellen platziert ist, dort bleibt, wo es ist. Deine Mods werden NICHT verändert, und das Löschen des zusammengeführten Plugins stellt dein vorheriges Verhalten vollständig wieder her.\n\nLade es ZULETZT und sichere deine Spielstände, bevor du das erste Mal damit spielst.%(existing)s\n\nJa: hierhin schreiben.   Nein: einen anderen Ordner wählen."

msgid "Merging land..."
msgstr "Führe Land zusammen …"

msgid "Folder not found"
msgstr "Ordner nicht gefunden"

msgid "%(path)s no longer exists. Please choose where to write."
msgstr "%(path)s existiert nicht mehr. Bitte wähle, wohin geschrieben werden soll."

msgid "Data Files not found"
msgstr "Data-Files nicht gefunden"

msgid "Could not work out which folder holds your plugins, so there is no sensible place to put the merged plugin. Use 'Merged Lands folder...' to choose one."
msgstr "Es ließ sich nicht ermitteln, welcher Ordner deine Plugins enthält, daher gibt es keinen sinnvollen Ort für das zusammengeführte Plugin. Nutze 'Merged-Lands-Ordner …', um einen zu wählen."

msgid "Where should Merged Lands.esp be written?"
msgstr "Wohin soll Merged Lands.esp geschrieben werden?"

msgid "Not a data folder"
msgstr "Kein Datenordner"

msgid "%(path)s is not one of the folders OpenMW reads, so it will not find the merged plugin there.\n\nAdd this line to openmw.cfg:\n\ndata=\"%(path)s\"\n\nand put 'content=%(name)s' last."
msgstr "%(path)s ist keiner der Ordner, die OpenMW liest, daher findet es das zusammengeführte Plugin dort nicht.\n\nFüge diese Zeile zu openmw.cfg hinzu:\n\ndata=\"%(path)s\"\n\nund setze 'content=%(name)s' zuletzt."

msgid " MERGE LANDS"
msgstr " LAND ZUSAMMENFÜHREN"

msgid "Merge produced nothing to write."
msgstr "Die Zusammenführung ergab nichts zu schreiben."

msgid "Merged Lands written: %(cells)d cell(s)."
msgstr "Merged Lands geschrieben: %(cells)d Zelle(n)."

msgid "Merge failed -- see log."
msgstr "Zusammenführung fehlgeschlagen – siehe Protokoll."

msgid "%(contested)d vertex/vertices were edited by more than one mod; the later one in your load order won each."
msgstr "%(contested)d Vertex/Vertices wurden von mehr als einem Mod bearbeitet; der jeweils spätere in deiner Ladereihenfolge hat gewonnen."

msgid "%(major)d were blended far from a mod's intent where a .mergedlands.toml asked to Resolve."
msgstr "%(major)d wurden weit von der Absicht eines Mods entfernt vermischt, wo eine .mergedlands.toml um Resolve bat."

msgid "Merged Lands built"
msgstr "Merged Lands erstellt"

msgid "Written to:\n%(path)s\n\nEnable it and place it LAST in your load order.\n\n%(cells)d land record(s), %(textures)d land texture(s).\n%(detail)s"
msgstr "Geschrieben nach:\n%(path)s\n\nAktiviere es und platziere es ZULETZT in deiner Ladereihenfolge.\n\n%(cells)d Land-Datensatz/-sätze, %(textures)d Land-Textur(en).\n%(detail)s"

msgid "Pick a plugin to write a .mergedlands.toml for"
msgstr "Wähle ein Plugin, für das eine .mergedlands.toml geschrieben werden soll"

msgid "Morrowind plugins"
msgstr "Morrowind-Plugins"

msgid "Existing .mergedlands.toml could not be read"
msgstr "Vorhandene .mergedlands.toml konnte nicht gelesen werden"

msgid "%(name)s will be replaced from defaults:\n\n%(err)s"
msgstr "%(name)s wird durch Standardwerte ersetzt:\n\n%(err)s"

msgid "Merge settings: %(name)s"
msgstr "Zusammenführungs-Einstellungen: %(name)s"

msgid "Choose how %(name)s's landscape edits merge. Uncheck a layer to keep this plugin from touching it; set a strategy for how its edits resolve where they collide with another mod. The defaults behave as if there were no file."
msgstr "Wähle, wie sich die Landschaftsänderungen von %(name)s zusammenführen. Hake eine Ebene ab, um dieses Plugin von ihr fernzuhalten; lege eine Strategie fest, wie seine Änderungen aufgelöst werden, wo sie mit einem anderen Mod kollidieren. Die Standardwerte verhalten sich, als gäbe es keine Datei."

msgid "meta_type:"
msgstr "meta_type:"

msgid "Patch = a hand-written settings file (the usual choice). Auto = default behaviour. MergedLands marks a plugin the tool generated so a re-run ignores it -- do not set that on an ordinary mod."
msgstr "Patch = eine handgeschriebene Einstellungsdatei (die übliche Wahl). Auto = Standardverhalten. MergedLands markiert ein vom Werkzeug erzeugtes Plugin, sodass ein erneuter Lauf es ignoriert -- setze das nicht bei einem gewöhnlichen Mod."

msgid "Layers"
msgstr "Ebenen"

msgid "include"
msgstr "einschließen"

msgid "layer"
msgstr "Ebene"

msgid "conflict strategy"
msgstr "Konfliktstrategie"

msgid "Vertex heights -- and the normals stored with them."
msgstr "Vertex-Höhen -- und die damit gespeicherten Normalen."

msgid "Baked vertex colours (terrain lighting)."
msgstr "Eingebackene Vertex-Farben (Geländebeleuchtung)."

msgid "Which land texture paints each square."
msgstr "Welche Land-Textur jedes Feld bemalt."

msgid "The low-resolution world-map heightmap."
msgstr "Die niedrig aufgelöste Weltkarten-Höhenkarte."

msgid "Auto = later plugin wins for entries it changed Â· Overwrite = this plugin wins collisions Â· Ignore = keep the earlier edit Â· Resolve = blend conflicting numbers Â· Curvature = structure-weighted blend (ours)."
msgstr "Auto = späteres Plugin gewinnt für Einträge, die es geändert hat · Overwrite = dieses Plugin gewinnt Kollisionen · Ignore = die frühere Änderung behalten · Resolve = widersprüchliche Zahlen mischen · Curvature = strukturgewichtete Mischung (unsere)."

msgid "Preview:"
msgstr "Vorschau:"

msgid "Write .mergedlands.toml"
msgstr ".mergedlands.toml schreiben"

msgid "Could not write .mergedlands.toml"
msgstr ".mergedlands.toml konnte nicht geschrieben werden"

msgid "Wrote %(name)s."
msgstr "%(name)s geschrieben."

msgid "Merge settings written"
msgstr "Zusammenführungs-Einstellungen geschrieben"

msgid "Wrote:\n%(path)s\n\nRun Merge Lands to apply it."
msgstr "Geschrieben:\n%(path)s\n\nFühre Land zusammenführen aus, um es anzuwenden."

msgid " CELL MAP"
msgstr " ZELLKARTE"

msgid "native esp reader"
msgstr "nativer ESP-Leser"

msgid "  %(exterior)d exterior + %(interior)d interior cell(s) touched across %(scanned)d plugin(s)."
msgstr "  %(exterior)d Außen- + %(interior)d Innenzelle(n) über %(scanned)d Plugin(s) berührt."

msgid "  Map written to: %(path)s"
msgstr "  Karte geschrieben nach: %(path)s"

msgid "Cell map ready (%(exterior)d exterior, %(interior)d interior)."
msgstr "Zellkarte bereit (%(exterior)d außen, %(interior)d innen)."

msgid "Open in browser"
msgstr "Im Browser öffnen"

msgid "(inline render failed -- use 'Open in browser'. The 3D and nav views need a real browser engine.)"
msgstr "(Inline-Darstellung fehlgeschlagen -- nutze 'Im Browser öffnen'. Die 3D- und Navigationsansichten benötigen eine echte Browser-Engine.)"

msgid "Save HTML..."
msgstr "HTML speichern …"

msgid "(inline render failed - use 'Open in browser' for the full map)"
msgstr "(Inline-Darstellung fehlgeschlagen -- nutze 'Im Browser öffnen' für die vollständige Karte)"

msgid "Save cell map"
msgstr "Zellkarte speichern"

msgid "Cell map saved: %(path)s"
msgstr "Zellkarte gespeichert: %(path)s"

msgid "If upstream moves or a new fork takes over, point the updaters at the new location here. Blank = built-in defaults. Downloads are always validated before anything is overwritten."
msgstr "Falls upstream umzieht oder ein neuer Fork übernimmt, verweise die Updater hier auf den neuen Ort. Leer = eingebaute Standardwerte. Downloads werden immer validiert, bevor etwas überschrieben wird."

msgid "mlox rules URL template:"
msgstr "mlox-Regel-URL-Vorlage:"

msgid "Where 'Update Rules...' downloads from. Must contain {name}, which is replaced with mlox_base.txt / mlox_user.txt per file.\nDefault: %(url)s"
msgstr "Woher 'Regeln aktualisieren …' herunterlädt. Muss {name} enthalten, das pro Datei durch mlox_base.txt / mlox_user.txt ersetzt wird.\nStandard: %(url)s"

msgid "default: %(url)s"
msgstr "Standard: %(url)s"

msgid "plugin-order.yml URL:"
msgstr "plugin-order.yml-URL:"

msgid "Where the plugin-order.yml 'Update...' button downloads from. Blank tries the built-in candidates in order.\nDefault: %(url)s"
msgstr "Woher die plugin-order.yml-'Aktualisieren …'-Schaltfläche herunterlädt. Leer probiert die eingebauten Kandidaten der Reihe nach.\nStandard: %(url)s"

msgid "default: %(url)s..."
msgstr "Standard: %(url)s …"

msgid "Download sources"
msgstr "Quellen herunterladen"

msgid "The rules URL template must contain {name} (it's replaced with the rule filename)."
msgstr "Die Regel-URL-Vorlage muss {name} enthalten (es wird durch den Regel-Dateinamen ersetzt)."

msgid "Reset to defaults"
msgstr "Auf Standard zurücksetzen"

msgid "Save & Close"
msgstr "Speichern & schließen"

msgid "New mlox rule"
msgstr "Neue mlox-Regel"

msgid "rules file:"
msgstr "Regeldatei:"

msgid "Personal rules file the rule is appended to (created with a header if new). Use your OWN file, not mlox_base/mlox_user -- those get overwritten by 'Update Rules...'. It's auto-added to the rule-files list LAST, so your rules win conflicts."
msgstr "Persönliche Regeldatei, an die die Regel angehängt wird (mit einem Header erstellt, falls neu). Nutze deine EIGENE Datei, nicht mlox_base/mlox_user -- die werden von 'Regeln aktualisieren …' überschrieben. Sie wird automatisch ZULETZT zur Regeldatei-Liste hinzugefügt, sodass deine Regeln Konflikte gewinnen."

msgid "Rule type"
msgstr "Regeltyp"

msgid "Plugins (order matters for [Order])"
msgstr "Plugins (Reihenfolge wichtig für [Order])"

msgid "From plugin panel"
msgstr "Aus dem Plugin-Panel"

msgid "Add the rows currently SELECTED in the main plugin-order panel, in their displayed order (Ctrl/Shift-click there to multi-select first)."
msgstr "Füge die aktuell im Haupt-Plugin-Reihenfolge-Panel AUSGEWÄHLTEN Zeilen in ihrer angezeigten Reihenfolge hinzu (dort zuerst mit Strg/Umschalt-Klick mehrere auswählen)."

msgid "Group as ANY"
msgstr "Als ANY gruppieren"

msgid "Wrap the SELECTED plugins in an [ANY ...] group, for a rule that is satisfied by whichever of several versions someone has installed -- the shape the guidelines use for mods with an XB edition, a Tribunal edition and so on.\n\nSelect the grouped entry and press again to ungroup."
msgstr "Fasse die AUSGEWÄHLTEN Plugins in einer [ANY …]-Gruppe zusammen, für eine Regel, die erfüllt ist, sobald irgendeine von mehreren Versionen installiert ist -- die Form, die die Richtlinien für Mods mit einer XB-Edition, einer Tribunal-Edition usw. verwenden.\n\nWähle den gruppierten Eintrag und drücke erneut, um die Gruppierung aufzuheben."

msgid "Type a plugin filename and press Enter. mlox wildcards are allowed: ? for one character, * for any run, <VER> for a version number -- though the guidelines ask for these to be used sparingly, since expanding them is slow."
msgstr "Gib einen Plugin-Dateinamen ein und drücke Enter. mlox-Platzhalter sind erlaubt: ? für ein Zeichen, * für eine beliebige Folge, <VER> für eine Versionsnummer -- die Richtlinien bitten jedoch, diese sparsam zu verwenden, da ihr Auflösen langsam ist."

msgid "Add"
msgstr "Hinzufügen"

msgid "Message and source"
msgstr "Meldung und Quelle"

msgid "message:"
msgstr "Meldung:"

msgid "What to tell the person, and what to do about it. Ordering rules carry no message; the warning rules are much less useful without one.\n\nA message containing ']' is written in the block form automatically, because a ']' would otherwise close the rule label early."
msgstr "Was der Person gesagt werden soll und was dagegen zu tun ist. Sortierregeln tragen keine Meldung; die Warnregeln sind ohne eine viel weniger nützlich.\n\nEine Meldung, die ']' enthält, wird automatisch in Blockform geschrieben, da ein ']' sonst das Regel-Label zu früh schließen würde."

msgid "(Ref:) source:"
msgstr "(Ref:) Quelle:"

msgid "Where this rule's claim comes from: a readme filename, a forum post, a URL. The guidelines ask for one on every rule so that someone else can check it, or correct it.\n\nA URL gets whitespace before the closing parenthesis automatically -- pages that auto-link URLs otherwise swallow the ')' into the link."
msgstr "Woher die Behauptung dieser Regel stammt: ein Readme-Dateiname, ein Forenbeitrag, eine URL. Die Richtlinien bitten bei jeder Regel um eine, damit jemand anderes sie prüfen oder korrigieren kann.\n\nEine URL erhält automatisch Leerraum vor der schließenden Klammer -- Seiten, die URLs automatisch verlinken, verschlucken sonst das ')' in den Link."

msgid "@section:"
msgstr "@section:"

msgid "Optional heading written above the rule. The rule-base groups rules into sections, roughly one per mod, to keep the file navigable."
msgstr "Optionale Überschrift über der Regel. Die Regelbasis gruppiert Regeln in Abschnitte, etwa einen pro Mod, um die Datei navigierbar zu halten."

msgid "highlight:"
msgstr "Hervorhebung:"

msgid "none"
msgstr "keine"

msgid "%(mark)s = %(meaning)s"
msgstr "%(mark)s = %(meaning)s"

msgid "; comment:"
msgstr "; Kommentar:"

msgid "A ';' comment written above the rule. mlox strips these before reading."
msgstr "Ein ';'-Kommentar über der Regel. mlox entfernt diese vor dem Einlesen."

msgid "Preview"
msgstr "Vorschau"

msgid "Append rule"
msgstr "Regel anhängen"

msgid "Write the rule to the file above. Refused while there is an error: mlox silently discards a rule it cannot use, so this is the only place you would find out.\n\nWarnings do not block -- they are the guidelines' advice, not the parser's requirements."
msgstr "Schreibe die Regel in die Datei oben. Verweigert, solange ein Fehler vorliegt: mlox verwirft eine unbrauchbare Regel stillschweigend, daher ist dies der einzige Ort, an dem du es erfahren würdest.\n\nWarnungen blockieren nicht -- sie sind der Rat der Richtlinien, nicht die Anforderungen des Parsers."

msgid "Rule guide"
msgstr "Regel-Leitfaden"

msgid "Open the rule reference: what each rule kind says, how expressions nest, and the conventions the rule-base follows.\n\nIt opens in your browser, so it can sit beside this window while you work."
msgstr "Öffne die Regelreferenz: was jede Regelart aussagt, wie Ausdrücke verschachtelt sind und welchen Konventionen die Regelbasis folgt.\n\nSie öffnet sich in deinem Browser, sodass sie neben diesem Fenster stehen kann, während du arbeitest."

msgid "No problems. This rule follows the guidelines.\n"
msgstr "Keine Probleme. Diese Regel folgt den Richtlinien.\n"

msgid "Select row(s) in the plugin-order panel first."
msgstr "Wähle zuerst Zeile(n) im Plugin-Reihenfolge-Panel."

msgid "Personal rules file"
msgstr "Persönliche Regeldatei"

msgid "New rule"
msgstr "Neue Regel"

msgid "Set a rules file first."
msgstr "Lege zuerst eine Regeldatei fest."

msgid "Don't append personal rules to mlox_base.txt / mlox_user.txt -- 'Update Rules...' overwrites those. Pick your own file (e.g. mlox_my_rules.txt)."
msgstr "Hänge persönliche Regeln nicht an mlox_base.txt / mlox_user.txt an -- 'Regeln aktualisieren …' überschreibt diese. Wähle deine eigene Datei (z. B. mlox_my_rules.txt)."

msgid "Rule conflicts with the curated order"
msgstr "Regel steht im Konflikt mit der kuratierten Reihenfolge"

msgid "This [Order] rule contradicts the frozen curated (MOMW) order for:\n\n%(pairs)s\n\nmlox will DISCARD those orderings (it never reorders the curated list), so the rule won't take effect for them. Write it anyway?"
msgstr "Diese [Order]-Regel widerspricht der eingefrorenen kuratierten (MOMW-)Reihenfolge für:\n\n%(pairs)s\n\nmlox VERWIRFT diese Anordnungen (es ordnet die kuratierte Liste nie um), daher wird die Regel dafür nicht wirksam. Trotzdem schreiben?"

msgid "Rule appended to %(file)s. Re-run '1. Sort' to apply it."
msgstr "Regel an %(file)s angehängt. Führe '1. Sortieren' erneut aus, um sie anzuwenden."

msgid "Update %(name)s"
msgstr "%(name)s aktualisieren"

msgid "Save %(name)s as"
msgstr "%(name)s speichern als"

msgid "the file doesn't exist yet -- it will be created"
msgstr "die Datei existiert noch nicht -- sie wird erstellt"

msgid "your copy is ~%(days)d day(s) old"
msgstr "deine Kopie ist ~%(days)d Tag(e) alt"

msgid "Download the current %(name)s from MOMW?\n\n%(age)s.\n\nThe download is validated before anything is written; a timestamped .bak of the old file is kept."
msgstr "Die aktuelle %(name)s von MOMW herunterladen?\n\n%(age)s.\n\nDer Download wird validiert, bevor etwas geschrieben wird; eine mit Zeitstempel versehene .bak der alten Datei wird behalten."

msgid "Downloading %(name)s..."
msgstr "Lade %(name)s herunter …"

msgid "Run '1. Sort' first so there's a load order to check against."
msgstr "Führe zuerst '1. Sortieren' aus, damit es eine Ladereihenfolge gibt, gegen die geprüft werden kann."

msgid "Choose an OpenMW save"
msgstr "Wähle einen OpenMW-Spielstand"

msgid "Save check failed: %(error)s"
msgstr "Spielstand-Prüfung fehlgeschlagen: %(error)s"

msgid "Save check: %(count)d missing dependency! See the log."
msgid_plural "Save check: %(count)d missing dependencies! See the log."
msgstr[0] "Spielstand-Prüfung: %(count)d fehlende Abhängigkeit! Siehe Protokoll."
msgstr[1] "Spielstand-Prüfung: %(count)d fehlende Abhängigkeiten! Siehe Protokoll."

msgid "Save Check"
msgstr "Spielstand-Prüfung"

msgid "Save check: all %(count)d dependencies present."
msgstr "Spielstand-Prüfung: alle %(count)d Abhängigkeiten vorhanden."

msgid "%(file)s: all %(count)d content files it needs are in the current load order. Safe to export."
msgstr "%(file)s: alle %(count)d benötigten Content-Dateien sind in der aktuellen Ladereihenfolge. Sicher zu exportieren."

msgid "Quick start"
msgstr "Schnellstart"

msgid "Read me"
msgstr "Lies mich"

msgid "Writing mlox rules"
msgstr "mlox-Regeln schreiben"

msgid "Documentation not found"
msgstr "Dokumentation nicht gefunden"

msgid "%(name)s was not found next to the program.\n\nIt ships alongside the app; if this is a build made without it, the same document is in the project folder."
msgstr "%(name)s wurde nicht neben dem Programm gefunden.\n\nEs wird mit der App ausgeliefert; falls dies ein ohne es erstellter Build ist, liegt dasselbe Dokument im Projektordner."

msgid "Could not open documentation"
msgstr "Dokumentation konnte nicht geöffnet werden"

msgid "%(name)s could not be rendered:\n%(error)s"
msgstr "%(name)s konnte nicht dargestellt werden:\n%(error)s"

msgid "Set openmw.cfg (or run a Sort) so I know where to look."
msgstr "Lege openmw.cfg fest (oder führe eine Sortierung aus), damit ich weiß, wo ich suchen soll."

msgid "Scanning for backups..."
msgstr "Suche nach Sicherungen …"

msgid "Found %(count)d backup file."
msgid_plural "Found %(count)d backup files."
msgstr[0] "%(count)d Sicherungsdatei gefunden."
msgstr[1] "%(count)d Sicherungsdateien gefunden."

msgid "Backup scan failed: %(error)s"
msgstr "Sicherungs-Scan fehlgeschlagen: %(error)s"

msgid "%(count)d backup file. Restore copies the backup over its original; Delete removes the backup file itself."
msgid_plural "%(count)d backup files. Restore copies the backup over its original; Delete removes the backup file itself."
msgstr[0] "%(count)d Sicherungsdatei. Wiederherstellen kopiert die Sicherung über ihr Original; Löschen entfernt die Sicherungsdatei selbst."
msgstr[1] "%(count)d Sicherungsdateien. Wiederherstellen kopiert die Sicherung über ihr Original; Löschen entfernt die Sicherungsdatei selbst."

msgid "Restore"
msgstr "Wiederherstellen"

msgid "Copy %(count)d backup over its original (overwriting it)?"
msgid_plural "Copy %(count)d backups over their originals (overwriting them)?"
msgstr[0] "%(count)d Sicherung über ihr Original kopieren (und es überschreiben)?"
msgstr[1] "%(count)d Sicherungen über ihre Originale kopieren (und sie überschreiben)?"

msgid "Restored %(count)d backup%(failed)s. Re-run '1. Sort' to refresh checks."
msgid_plural "Restored %(count)d backups%(failed)s. Re-run '1. Sort' to refresh checks."
msgstr[0] "%(count)d Sicherung wiederhergestellt%(failed)s. Führe '1. Sortieren' erneut aus, um die Prüfungen zu aktualisieren."
msgstr[1] "%(count)d Sicherungen wiederhergestellt%(failed)s. Führe '1. Sortieren' erneut aus, um die Prüfungen zu aktualisieren."

msgid ", %(fail)d failed"
msgstr ", %(fail)d fehlgeschlagen"

msgid "Delete"
msgstr "Löschen"

msgid "Permanently delete %(count)d backup file?"
msgid_plural "Permanently delete %(count)d backup files?"
msgstr[0] "%(count)d Sicherungsdatei endgültig löschen?"
msgstr[1] "%(count)d Sicherungsdateien endgültig löschen?"

msgid "Deleted %(count)d backup file."
msgid_plural "Deleted %(count)d backup files."
msgstr[0] "%(count)d Sicherungsdatei gelöscht."
msgstr[1] "%(count)d Sicherungsdateien gelöscht."

msgid "Restore Selected"
msgstr "Auswahl wiederherstellen"

msgid "Delete Selected"
msgstr "Auswahl löschen"

msgid "Refresh"
msgstr "Aktualisieren"

msgid "Linting plugins..."
msgstr "Prüfe Plugins …"

msgid " LINT (tes3lint-style checks, native)"
msgstr " PRÜFUNG (tes3lint-artige Prüfungen, nativ)"

msgid "\n  No lint findings. Clean bill of health."
msgstr "\n  Keine Prüfbefunde. Alles in Ordnung."

msgid "Lint: %(count)d finding. See the log."
msgid_plural "Lint: %(count)d findings. See the log."
msgstr[0] "Prüfung: %(count)d Befund. Siehe Protokoll."
msgstr[1] "Prüfung: %(count)d Befunde. Siehe Protokoll."

msgid "Lint: no findings."
msgstr "Prüfung: keine Befunde."

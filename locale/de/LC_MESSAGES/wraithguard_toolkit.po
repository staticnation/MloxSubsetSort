msgstr "  Header-Master für %(have)d von %(total)d eigenen Plugin(s) gelesen."

msgid "\n  No [Conflict]/[Requires]/[Note] warnings triggered."
msgstr "\n  Keine [Conflict]/[Requires]/[Note]-Warnungen ausgelöst."

msgid "\n  No plugin-order.yml warnings."
msgstr "\n  Keine plugin-order.yml-Warnungen."

msgid "  (plugin files not reachable from the data folders; can't read headers)"
msgstr "  (Plugin-Dateien von den Datenordnern aus nicht erreichbar; Header können nicht gelesen werden)"

msgid "  All masters present and correctly ordered."
msgstr "  Alle Master vorhanden und korrekt angeordnet."

msgid "master check failed: %(error)s"
msgstr "Master-Prüfung fehlgeschlagen: %(error)s"

msgid "\n[STALE] '%(artifact)s' is older than %(count)d active plugin (e.g. %(examples)s%(more)s) -- re-run momw-configurator so it gets rebuilt against the current load order."
msgid_plural "\n[STALE] '%(artifact)s' is older than %(count)d active plugins (e.g. %(examples)s%(more)s) -- re-run momw-configurator so it gets rebuilt against the current load order."
msgstr[0] "\n[VERALTET] '%(artifact)s' ist älter als %(count)d aktives Plugin (z. B. %(examples)s%(more)s) -- führe momw-configurator erneut aus, damit es gegen die aktuelle Ladereihenfolge neu erstellt wird."
msgstr[1] "\n[VERALTET] '%(artifact)s' ist älter als %(count)d aktive Plugins (z. B. %(examples)s%(more)s) -- führe momw-configurator erneut aus, damit es gegen die aktuelle Ladereihenfolge neu erstellt wird."

msgid "  (excluded %(count)d plugin by --exclude)"
msgid_plural "  (excluded %(count)d plugins by --exclude)"
msgstr[0] "  (%(count)d Plugin durch --exclude ausgeschlossen)"
msgstr[1] "  (%(count)d Plugins durch --exclude ausgeschlossen)"

msgid "  Keeping tes3conv JSON dump in: %(path)s"
msgstr "  tes3conv-JSON-Ausgabe wird behalten in: %(path)s"


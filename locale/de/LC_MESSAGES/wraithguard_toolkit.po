msgid "  Inferred anchor for '%(value)s': %(mode)s '%(anchor)s' (via plugin %(via)s)"
msgstr "  Abgeleiteter Anker für '%(value)s': %(mode)s '%(anchor)s' (über Plugin %(via)s)"

msgid "NOTE: '%(value)s' already present in data= list -- skipping duplicate insert."
msgstr "HINWEIS: '%(value)s' ist bereits in der data=-Liste vorhanden -- doppeltes Einfügen wird übersprungen."

msgid "NOTE: '%(value)s' has no after/before anchor -- appending at end of data= list."
msgstr "HINWEIS: '%(value)s' hat keinen after/before-Anker -- wird ans Ende der data=-Liste angehängt."

msgid "WARNING: anchor '%(anchor)s' not found among existing data= paths for '%(value)s' -- appending at end instead."
msgstr "WARNUNG: Anker '%(anchor)s' wurde unter den vorhandenen data=-Pfaden für '%(value)s' nicht gefunden -- wird stattdessen ans Ende angehängt."

msgid "WARNING: anchor '%(anchor)s' in the emitted TOML matches %(count)d openmw.cfg lines -- momw-configurator errors on ambiguous matches. Colliding lines: %(lines)s%(more)s"
msgstr "WARNUNG: Anker '%(anchor)s' im erzeugten TOML passt auf %(count)d openmw.cfg-Zeilen -- momw-configurator bricht bei mehrdeutigen Treffern ab. Kollidierende Zeilen: %(lines)s%(more)s"

msgid "WARNING: remove entry '%(entry)s' matches %(count)d openmw.cfg lines -- momw-configurator removes ALL of them, silently. Colliding lines: %(lines)s%(more)s"
msgstr "WARNUNG: Entfernen-Eintrag '%(entry)s' passt auf %(count)d openmw.cfg-Zeilen -- momw-configurator entfernt ALLE davon, stillschweigend. Kollidierende Zeilen: %(lines)s%(more)s"

msgid "Scanning for conflicts..."
msgstr "Suche nach Konflikten …"

msgid " TES3 RECORD CONFLICTS (read-only)"
msgstr " TES3-DATENSATZKONFLIKTE (schreibgeschützt)"

msgid "  Engine: tes3conv (%(path)s) -- field-level diffs available."
msgstr "  Engine: tes3conv (%(path)s) -- feldweise Unterschiede verfügbar."

msgid "Conflicts: %(count)d record(s), %(involved)d involving your mods. See the Conflicts window."
msgstr "Konflikte: %(count)d Datensatz/-sätze, %(involved)d mit Beteiligung deiner Mods. Siehe das Konflikte-Fenster."

msgid "No data= folders to scan."
msgstr "Keine data=-Ordner zum Durchsuchen."

msgid "Scanning data folders for file conflicts..."
msgstr "Durchsuche Datenordner nach Dateikonflikten …"

msgid " DATA-PATH RESOURCE (VFS) CONFLICTS"
msgstr " DATENPFAD-RESSOURCEN (VFS)-KONFLIKTE"

msgid "Resource conflicts: %(count)d file(s). See the window."
msgstr "Ressourcenkonflikte: %(count)d Datei(en). Siehe das Fenster."

msgid "%(conflicts)d loose-file conflict(s) across %(dirs)d folder(s), %(files)d file(s) - %(involved)d involve your custom data paths (â). Later folder wins - reorder the data-path panel to change it."
msgstr "%(conflicts)d Lose-Datei-Konflikt(e) über %(dirs)d Ordner, %(files)d Datei(en) -- %(involved)d betreffen deine eigenen Datenpfade (→). Der spätere Ordner gewinnt -- ordne das Datenpfad-Panel um, um das zu ändern."

msgid "Only my paths"
msgstr "Nur meine Pfade"

msgid "Search:"
msgstr "Suche:"

msgid "Filter by file path or winning folder. Enter jumps to the next match (Shift+Enter: previous) and scrolls it into view."
msgstr "Nach Dateipfad oder gewinnendem Ordner filtern. Enter springt zum nächsten Treffer (Umschalt+Enter: vorheriger) und scrollt ihn ins Bild."

msgid "Select a file to see every folder that provides it, in load order.\nSelecting a mesh (.nif) also reads it and describes what each provider contains -- shapes, textures, collision, animation -- and what the winning mesh loses. Rows marked ! in the second column already have a finding."
msgstr "Wähle eine Datei, um jeden Ordner zu sehen, der sie bereitstellt, in Ladereihenfolge.\nBei Auswahl eines Meshes (.nif) wird es außerdem gelesen und beschrieben, was jeder Anbieter enthält -- Formen, Texturen, Kollision, Animation -- und was das gewinnende Mesh verliert. Mit ! in der zweiten Spalte markierte Zeilen haben bereits einen Befund."

msgid "Save report (CSV)..."
msgstr "Bericht speichern (CSV) …"


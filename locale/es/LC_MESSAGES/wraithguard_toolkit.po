msgstr "NOTA: «%(value)s» ya está presente en la lista data= -- se omite la inserción duplicada."

msgid "NOTE: '%(value)s' has no after/before anchor -- appending at end of data= list."
msgstr "NOTA: «%(value)s» no tiene ancla after/before -- se añade al final de la lista data=."

msgid "WARNING: anchor '%(anchor)s' not found among existing data= paths for '%(value)s' -- appending at end instead."
msgstr "ADVERTENCIA: ancla «%(anchor)s» no encontrada entre las rutas data= existentes de «%(value)s» -- se añade al final en su lugar."


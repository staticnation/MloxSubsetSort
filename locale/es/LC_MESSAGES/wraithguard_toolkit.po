msgstr "Comando"

msgid "extra arguments:"
msgstr "argumentos adicionales:"

msgid "Optional extra tes3cmd switches, e.g. --instances for clean, --author/--description for header. Passed through verbatim."
msgstr "Modificadores adicionales opcionales de tes3cmd, p. ej. --instances para clean, --author/--description para la cabecera. Se pasan literalmente."

msgid "Run"
msgstr "Ejecutar"

msgid "Output streams to the main Log. Modifying commands ask for confirmation first; tes3cmd makes its own backups."
msgstr "La salida va al Registro principal. Los comandos que modifican piden confirmación primero; tes3cmd hace sus propias copias de seguridad."

msgid "Run '1. Sort' first so I know which mods are yours."
msgstr "Ejecuta primero «1. Ordenar» para que sepa qué mods son tuyos."

msgid "tes3cmd: added %(count)d of your mods"
msgstr "tes3cmd: %(count)d de tus mods añadidos"

msgid " (%(count)d file not found in the data folders)"
msgid_plural " (%(count)d files not found in the data folders)"
msgstr[0] " (%(count)d archivo no encontrado en las carpetas de datos)"
msgstr[1] " (%(count)d archivos no encontrados en las carpetas de datos)"

msgid "Run '1. Sort' first so I know the active load order."
msgstr "Ejecuta primero «1. Ordenar» para que conozca el orden de carga activo."

msgid "tes3cmd: added %(count)d list mod(s)"
msgstr "tes3cmd: %(count)d mod(s) de la lista añadidos"


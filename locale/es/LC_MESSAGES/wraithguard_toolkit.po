msgstr[1] "tes3cmd: %(count)d plugins por limpiar añadidos"

msgid "Choose plugin file(s)"
msgstr "Elegir archivos de plugin"

msgid "Resync master sizes"
msgstr "Resincronizar tamaños de masters"

msgid "Rewrite the recorded master sizes in %(count)d plugin file to match the installed masters?\n\nOnly the 8-byte size fields change; a one-time .masterfix.bak copy of each file is kept."
msgid_plural "Rewrite the recorded master sizes in %(count)d plugin files to match the installed masters?\n\nOnly the 8-byte size fields change; a one-time .masterfix.bak copy of each file is kept."
msgstr[0] "¿Reescribir los tamaños de master registrados en %(count)d archivo de plugin para coincidir con los masters instalados?\n\nSolo cambian los campos de tamaño de 8 bytes; se conserva una copia .masterfix.bak única de cada archivo."
msgstr[1] "¿Reescribir los tamaños de master registrados en %(count)d archivos de plugin para coincidir con los masters instalados?\n\nSolo cambian los campos de tamaño de 8 bytes; se conserva una copia .masterfix.bak única de cada archivo."

msgid "Resyncing master sizes..."
msgstr "Resincronizando tamaños de masters…"

msgid "'%(path)s' does not exist. Fix the path or clear it to auto-detect."
msgstr "«%(path)s» no existe. Corrige la ruta o vacíala para la detección automática."

msgid "tes3cmd"
msgstr "tes3cmd"

msgid "tes3cmd not found. Browse to the compiled tes3cmd.exe (MOMW Tools Pack)."
msgstr "tes3cmd no encontrado. Navega hasta el tes3cmd.exe compilado (MOMW Tools Pack)."

msgid "Add at least one plugin file first."
msgstr "Añade primero al menos un archivo de plugin."

msgid "tes3cmd clean"
msgstr "tes3cmd clean"

msgid "Clean %(count)d plugin file?\n\nEach is staged into a private 'Data Files' with its masters so tes3cmd sees the full VFS; plugins whose masters can't be found are skipped. A one-time .preclean.bak copy of each modified file is kept."
msgid_plural "Clean %(count)d plugin files?\n\nEach is staged into a private 'Data Files' with its masters so tes3cmd sees the full VFS; plugins whose masters can't be found are skipped. A one-time .preclean.bak copy of each modified file is kept."
msgstr[0] "¿Limpiar %(count)d archivo de plugin?\n\nCada uno se prepara en un «Data Files» privado con sus masters para que tes3cmd vea todo el VFS; los plugins cuyos masters no se encuentran se omiten. Se conserva una copia .preclean.bak única de cada archivo modificado."
msgstr[1] "¿Limpiar %(count)d archivos de plugin?\n\nCada uno se prepara en un «Data Files» privado con sus masters para que tes3cmd vea todo el VFS; los plugins cuyos masters no se encuentran se omiten. Se conserva una copia .preclean.bak única de cada archivo modificado."

msgid "tes3cmd %(command)s running..."
msgstr "tes3cmd %(command)s en ejecución…"

msgid "  Engine: %(command)s"
msgstr "  Motor: %(command)s"

msgid "  Staging dir: %(path)s"
msgstr "  Directorio de preparación: %(path)s"


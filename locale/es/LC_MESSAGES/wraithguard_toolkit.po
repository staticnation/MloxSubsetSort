msgid "  Scanned %(scanned)d plugin(s): %(exterior)d exterior + %(interior)d interior cell(s) touched."
msgstr "  %(scanned)d plugin(s) analizados: %(exterior)d exterior(es) + %(interior)d interior(es) tocadas."

msgid "  Wrote cell map: %(path)s  (open it in a browser)"
msgstr "  Mapa de celdas escrito: %(path)s  (ábrelo en un navegador)"

msgid "could not write cell map: %(error)s"
msgstr "no se pudo escribir el mapa de celdas: %(error)s"

msgid "  Scanned %(scanned)d plugin(s); %(cells)d interior cell(s), %(grids)d interior pathgrid(s)."
msgstr "  %(scanned)d plugin(s) analizados; %(cells)d celda(s) interior(es), %(grids)d rejilla(s) de rutas interior(es)."

msgid "\n  No lint findings."
msgstr "\n  Sin hallazgos de análisis."

msgid "\n  Wrote resource report: %(path)s"
msgstr "\n  Informe de recursos escrito: %(path)s"

msgid "could not write resource CSV: %(error)s"
msgstr "no se pudo escribir el CSV de recursos: %(error)s"

msgid "  Pass --sort-data-paths to enable:"
msgstr "  Pasa --sort-data-paths para activar:"

msgid "  <-- inserted"
msgstr "  <-- insertado"

msgid "UNMANAGED (ORPHAN) ENTRIES FROM openmw.cfg"
msgstr "ENTRADAS NO GESTIONADAS (HUÉRFANAS) DE openmw.cfg"

msgid "  %(count)d orphan plugin pulled from openmw.cfg"
msgid_plural "  %(count)d orphan plugins pulled from openmw.cfg"
msgstr[0] "  %(count)d plugin huérfano recuperado de openmw.cfg"
msgstr[1] "  %(count)d plugins huérfanos recuperados de openmw.cfg"

msgid "  No unmanaged plugins found -- every content= plugin in the cfg is on the list or in your customizations."
msgstr "  No se encontraron plugins no gestionados -- cada plugin content= de la cfg está en la lista o en tus personalizaciones."

msgid "groundcover declared by this run"
msgstr "groundcover declarado por esta ejecución"

msgid "  These are written as groundcover= rather than content=. Their data= folders are inserted normally -- OpenMW has to find the file."
msgstr "  Estos se escriben como groundcover= en vez de content=. Sus carpetas data= se insertan normalmente -- OpenMW tiene que encontrar el archivo."

msgid "groundcover plugins held back"
msgstr "plugins groundcover retenidos"

msgid "%(count)d plugin in your subset is already declared as groundcover in openmw.cfg, so it was NOT added to content=:"
msgid_plural "%(count)d plugins in your subset are already declared as groundcover in openmw.cfg, so they were NOT added to content=:"
msgstr[0] "%(count)d plugin de tu subconjunto ya está declarado como groundcover en openmw.cfg, así que NO se añadió a content=:"
msgstr[1] "%(count)d plugins de tu subconjunto ya están declarados como groundcover en openmw.cfg, así que NO se añadieron a content=:"

msgid "  Their groundcover= lines are untouched and their data= paths are still written, so the grass stays enabled -- as grass. Loading one as content= too would spawn every blade as a real object."
msgstr "  Sus líneas groundcover= quedan intactas y sus rutas data= se siguen escribiendo, así que la hierba sigue activada -- como hierba. Cargar uno también como content= haría aparecer cada brizna como un objeto real."

msgid "  openmw.cfg left untouched (pass --write-cfg to patch it directly)"
msgstr "  openmw.cfg sin tocar (pasa --write-cfg para parchearlo directamente)"

msgid "  WARNING: configurator preview failed: %(error)s"
msgstr "  ADVERTENCIA: la vista previa del configurador falló: %(error)s"

msgid "\n  DRY RUN: would write %(path)s\n%(toml)s"
msgstr "\n  SIMULACIÓN: escribiría %(path)s\n%(toml)s"

msgid "  Wrote corrected customizations: %(path)s"
msgstr "  Personalizaciones corregidas escritas: %(path)s"

msgid "  Plugins sorted:        %(count)d"
msgstr "  Plugins ordenados:      %(count)d"

msgid "  Data paths inserted:   %(count)d"
msgstr "  Rutas de datos insertadas: %(count)d"

msgid "  Rule warnings raised:  %(count)d"
msgstr "  Advertencias de reglas: %(count)d"

msgid "  plugin-order.yml warnings: %(count)d"
msgstr "  Advertencias de plugin-order.yml: %(count)d"

msgid "  openmw.cfg written:    %(answer)s"
msgstr "  openmw.cfg escrito:     %(answer)s"

msgid "yes"
msgstr "sí"

msgid "no"
msgstr "no"

msgid "  customizations.toml written: %(answer)s"
msgstr "  customizations.toml escrito: %(answer)s"

msgid "Rule files (priority = order below, last = highest -- drag rows to reorder)"
msgstr "Archivos de reglas (prioridad = orden de abajo, último = más alta -- arrastra las filas para reordenar)"

msgid "mlox rule files (mlox_base.txt, mlox_user.txt, ...), applied in this order.\nLater files can override/extend earlier ones -- put mlox_base.txt first and your own mlox_user.txt last. Drag rows to reorder, or use the buttons."
msgstr "Archivos de reglas mlox (mlox_base.txt, mlox_user.txt, …), aplicados en este orden.\nLos archivos posteriores pueden sobrescribir/ampliar los anteriores -- pon mlox_base.txt primero y tu propio mlox_user.txt al final. Arrastra las filas para reordenar, o usa los botones."

msgid "Add File(s)..."
msgstr "Añadir archivos…"

msgid "Browse for one or more mlox rule .txt files to add to the list."
msgstr "Examina para añadir uno o más archivos .txt de reglas mlox a la lista."

msgid "Remove Selected"
msgstr "Quitar selección"

msgid "Remove the selected rule file from the list (doesn't delete anything on disk)."
msgstr "Quitar el archivo de reglas seleccionado de la lista (no borra nada del disco)."

msgid "Move Up"
msgstr "Subir"

msgid "Move the selected rule file earlier (lower priority)."
msgstr "Mover el archivo de reglas seleccionado antes (prioridad menor)."

msgid "Move Down"
msgstr "Bajar"

msgid "Move the selected rule file later (higher priority)."
msgstr "Mover el archivo de reglas seleccionado después (prioridad mayor)."

msgid "New Rule..."
msgstr "Nueva regla…"

msgid "Write your own mlox [Order]/[NearStart]/[NearEnd] rule without knowing the syntax: pick plugins (or grab the selected rows from the plugin panel), preview the rule, and append it to a personal rules file that loads LAST so it wins conflicts. This is how rules for modern mods get made -- consider contributing good ones upstream."
msgstr "Escribe tu propia regla mlox [Order]/[NearStart]/[NearEnd] sin conocer la sintaxis: elige plugins (o toma las filas seleccionadas del panel de plugins), previsualiza la regla, y añádela a un archivo de reglas personal que se cargue en ÚLTIMO lugar para ganar los conflictos. Así se crean las reglas de los mods modernos -- considera contribuir las buenas río arriba."

msgid "Update Rules..."
msgstr "Actualizar reglas…"

msgid "Download the CURRENT mlox_base.txt / mlox_user.txt from the actively maintained rules repo (github.com/%(repo)s -- the same source plox uses, and mlox 1.1+ auto-updates from) over the matching files in this list. The old files are kept as timestamped .bak copies. Files with other names (your personal rules) are never touched. Source URL configurable via Sources..."
msgstr "Descargar los mlox_base.txt / mlox_user.txt ACTUALES del repositorio de reglas mantenido activamente (github.com/%(repo)s -- la misma fuente que usa plox, y desde la que mlox 1.1+ se actualiza) sobre los archivos correspondientes de esta lista. Los archivos antiguos se conservan como copias .bak con marca de tiempo. Los archivos con otros nombres (tus reglas personales) nunca se tocan. URL de origen configurable vía Fuentes…"

msgid "Sources..."
msgstr "Fuentes…"

msgid "Configure WHERE 'Update Rules...' and the plugin-order.yml 'Update...' button download from -- point them at a fork or mirror if upstream moves. Blank fields use the built-in defaults."
msgstr "Configurar DE DÓNDE descargan «Actualizar reglas…» y el botón «Actualizar…» de plugin-order.yml -- apúntalos a un fork o espejo si el origen se muda. Los campos vacíos usan los valores predeterminados integrados."

msgid "(install tkinterdnd2 to drag files in from your file manager)"
msgstr "(instala tkinterdnd2 para arrastrar archivos desde tu gestor de archivos)"

msgid "Choose a folder for the mlox rule files"
msgstr "Elige una carpeta para los archivos de reglas mlox"

msgid "Update rules"
msgstr "Actualizar reglas"

msgid "Download the current mlox rules from github.com/%(repo)s?\n\n%(files)s\n\nThey don't exist yet -- they'll be created here."
msgstr "¿Descargar las reglas mlox actuales de github.com/%(repo)s?\n\n%(files)s\n\nAún no existen -- se crearán aquí."

msgid "Download the current rules from github.com/%(repo)s over these files?\n\n%(age)s\n\nTimestamped .bak copies of the old files are kept."
msgstr "¿Descargar las reglas actuales de github.com/%(repo)s sobre estos archivos?\n\n%(age)s\n\nSe conservan copias .bak con marca de tiempo de los archivos antiguos."

msgid "Move the selected row(s) one position earlier. Works with a multi-selection; you can also drag a contiguous block up with the mouse."
msgstr "Mover la(s) fila(s) seleccionada(s) una posición antes. Funciona con selección múltiple; también puedes arrastrar un bloque contiguo hacia arriba con el ratón."

msgid "Move the selected row(s) one position later. Works with a multi-selection; you can also drag a contiguous block down with the mouse."
msgstr "Mover la(s) fila(s) seleccionada(s) una posición después. Funciona con selección múltiple; también puedes arrastrar un bloque contiguo hacia abajo con el ratón."

msgid "Disable / Enable"
msgstr "Desactivar / Activar"

msgid "Opt the selected row in or out of the load order. Disabled rows are dimmed and marked, and are left out of Export: a custom item is simply not inserted, and an item already in your openmw.cfg gets a removeContent/removeData entry in the emitted TOML so it's durably removed. Double-click a row to toggle it too."
msgstr "Incluir o excluir la fila seleccionada del orden de carga. Las filas desactivadas se atenúan y marcan, y se excluyen del Export: un elemento personalizado simplemente no se inserta, y un elemento ya en tu openmw.cfg recibe una entrada removeContent/removeData en el TOML emitido para quitarse de forma duradera. Doble clic en una fila también la alterna."

msgid "Discard any manual dragging and restore the order from the last Sort (your disable/enable choices are kept)."
msgstr "Descartar cualquier arrastre manual y restaurar el orden de la última Ordenación (tus elecciones de activar/desactivar se conservan)."

msgid "Plugin load order -- drag to override mlox (red = touched by this sort, purple = master problem)"
msgstr "Orden de carga de plugins -- arrastra para anular mlox (rojo = tocado por esta ordenación, morado = problema de master)"

msgid "Data path order -- drag to adjust (highlighted = your custom paths)"
msgstr "Orden de rutas de datos -- arrastra para ajustar (resaltado = tus rutas personalizadas)"

msgid "Drag & drop is unavailable (tkinterdnd2 or its tkdnd library is missing) -- use the Browse buttons below."
msgstr "Arrastrar y soltar no está disponible (falta tkinterdnd2 o su biblioteca tkdnd) -- usa los botones Examinar de abajo."

msgid "Required. The openmw.cfg to read the current content= and data= order from, and (if 'Write openmw.cfg directly' is checked) to patch."
msgstr "Obligatorio. El openmw.cfg del que leer el orden content= y data= actual y (si «Escribir openmw.cfg directamente» está marcado) a parchear."

msgid "A momw-configurator/umo customizations TOML to pull the plugin/data-path subset from automatically. Optional if you provide a subset file instead -- provide both and they're combined."
msgstr "Un TOML de personalizaciones de momw-configurator/umo del que sacar automáticamente el subconjunto de plugins/rutas de datos. Opcional si proporcionas un archivo de subconjunto en su lugar -- proporciona ambos y se combinan."

msgid "A plain text file (one plugin filename or data folder path per line, '#' comments allowed) or a minimal TOML with subset=[...]/data=[...]. Combined with --emit-toml, this alone is enough to generate a brand new customizations.toml with no existing one required."
msgstr "Un archivo de texto plano (un nombre de archivo de plugin o ruta de carpeta de datos por línea, comentarios «#» permitidos) o un TOML mínimo con subset=[...]/data=[...]. Combinado con --emit-toml, esto por sí solo basta para generar un customizations.toml nuevo sin que se requiera uno existente."

msgid "Where to write a corrected customizations.toml (sorted insert blocks, re-anchored). Disabled when 'write directly back' below is checked."
msgstr "Dónde escribir un customizations.toml corregido (bloques de inserción ordenados, reanclados). Desactivado cuando «reescribir directamente» de abajo está marcado."

msgid "list name (optional):"
msgstr "nombre de la lista (opcional):"

msgid "MOMW's plugin-order.yml (source of truth for which plugins belong to which curated list). With the list name above set, curated plugins for that list are excluded from the sort (never reordered) so only your custom additions are touched, and read-only warnings are emitted: redundant, orphan, needs-cleaning, and a base-order drift check. PyYAML used if installed, else a built-in parser."
msgstr "El plugin-order.yml de MOMW (la fuente de verdad de qué plugins pertenecen a qué lista curada). Con el nombre de lista de arriba definido, los plugins curados de esa lista se excluyen de la ordenación (nunca se reordenan) para que solo se toquen tus adiciones personalizadas, y se emiten advertencias de solo lectura: redundante, huérfano, needs-cleaning y una comprobación de deriva del orden base. Se usa PyYAML si está instalado, si no un analizador integrado."

msgid "Write directly back to customizations.toml (overwrite in place; a .bak-<timestamp> copy is made first unless backups are disabled below)"
msgstr "Reescribir directamente en customizations.toml (sobrescribir en el sitio; primero se hace una copia .bak-<marca de tiempo> salvo que las copias estén desactivadas abajo)"

msgid "Instead of writing to a separate file above, overwrite the customizations.toml given above in place. A timestamped backup is made first (unless disabled), and you'll get a confirmation prompt before it actually happens."
msgstr "En vez de escribir en un archivo aparte de arriba, sobrescribir en el sitio el customizations.toml indicado arriba. Primero se hace una copia con marca de tiempo (salvo que esté desactivada), y tendrás una confirmación antes de que ocurra de verdad."

msgid "Options"
msgstr "Opciones"

msgid "Dry run (preview only, don't write files)"
msgstr "Simulación (solo vista previa, no escribe archivos)"

msgid "When checked, Export shows exactly what it would write without touching any files. Uncheck when you're ready to actually save."
msgstr "Cuando está marcado, el Export muestra exactamente lo que escribiría sin tocar ningún archivo. Desmárcalo cuando estés listo para guardar de verdad."

msgid "Write openmw.cfg directly"
msgstr "Escribir openmw.cfg directamente"

msgid "Patch the content=/data= lines in openmw.cfg in place on Export. A .bak-<timestamp> copy is made first unless backups are disabled."
msgstr "Parchear en el sitio las líneas content=/data= de openmw.cfg al Exportar. Primero se hace una copia .bak-<marca de tiempo> salvo que las copias estén desactivadas."

msgid "Sort data= paths too"
msgstr "Ordenar también las rutas data="

msgid "mlox has no concept of data= folder order -- this positions new data= paths using an explicit after/before anchor if you wrote one, or by scanning the folder for plugins and anchoring next to their neighbor in the sorted content= order. Off by default so a plugin-only run can't surprise-reorder data= too. Also required for the data path order panel to populate."
msgstr "mlox no tiene concepto del orden de carpetas data= -- esto posiciona las nuevas rutas data= con un ancla after/before explícita si escribiste una, o analizando la carpeta en busca de plugins y anclándola junto a su vecino en el orden content= ordenado. Desactivado por defecto para que una ejecución solo de plugins no reordene data= por sorpresa. También requerido para que el panel de orden de rutas de datos se rellene."

msgid "Skip .bak backup of openmw.cfg"
msgstr "Omitir la copia .bak de openmw.cfg"

msgid "Skip making a timestamped backup before overwriting openmw.cfg and/or an in-place customizations.toml. Not recommended."
msgstr "Omitir hacer una copia con marca de tiempo antes de sobrescribir openmw.cfg y/o un customizations.toml en el sitio. No recomendado."

msgid "Skip mlox Conflict/Requires/Note warnings"
msgstr "Omitir las advertencias Conflict/Requires/Note de mlox"

msgid "Skip evaluating [Conflict]/[Requires]/[Note] rules against the sorted plugin list. This is purely informational and read-only either way -- it never changes the computed order or what gets written, only whether warnings get printed."
msgstr "Omitir la evaluación de las reglas [Conflict]/[Requires]/[Note] contra la lista de plugins ordenada. Es puramente informativo y de solo lectura de todos modos -- nunca cambia el orden calculado ni lo que se escribe, solo si se imprimen o no las advertencias."

msgid "Create subset text document (on Scan)"
msgstr "Crear documento de texto de subconjunto (al Analizar)"

msgid "Controls what 'Scan...' does with its result. Checked: write the scanned list to a .txt subset file you choose, and load it (the file stays on disk for reuse). Unchecked: keep the scanned list in memory just for this session and feed it straight to the sort -- nothing is written to disk."
msgstr "Controla lo que «Analizar…» hace con su resultado. Marcado: escribir la lista analizada en un archivo de subconjunto .txt que elijas, y cargarla (el archivo queda en el disco para reutilizar). Sin marcar: mantener la lista analizada en memoria solo para esta sesión y pasarla directamente a la ordenación -- no se escribe nada en el disco."

msgid "Pull unmanaged (orphan) plugins from openmw.cfg"
msgstr "Recuperar plugins no gestionados (huérfanos) de openmw.cfg"

msgid "Also sort the content= plugins ALREADY in openmw.cfg that nothing manages -- neither the curated list (plugin-order.yml) nor your customizations.toml. Their current cfg order is kept as the starting order until the sort repositions them. Base masters (Morrowind/Tribunal/Bloodmoon) are never touched. Works on its own (no subset file needed) or alongside one.\n\ndata= paths are left exactly as openmw.cfg has them: they are already in the cfg's own data= order, and there is no reliable way to tell a path the list manages from one you added, so pulling them would reorder the whole VFS."
msgstr "Ordenar también los plugins content= YA en openmw.cfg que nada gestiona -- ni la lista curada (plugin-order.yml) ni tu customizations.toml. Su orden cfg actual se mantiene como orden de partida hasta que la ordenación los reposiciona. Los masters base (Morrowind/Tribunal/Bloodmoon) nunca se tocan. Funciona por sí solo (sin archivo de subconjunto) o junto a uno.\n\nLas rutas data= se dejan exactamente como openmw.cfg las tiene: ya están en el propio orden data= de la cfg, y no hay forma fiable de distinguir una ruta gestionada por la lista de una que añadiste, así que recuperarlas reordenaría todo el VFS."

msgid "Exclude from conflict / cell scans:"
msgstr "Excluir de los análisis de conflictos / celdas:"

msgid "Declare as groundcover:"
msgstr "Declarar como groundcover:"

msgid "Keep tes3conv JSON dump"
msgstr "Conservar el volcado JSON de tes3conv"

msgid "Tidy old HTML views"
msgstr "Limpiar vistas HTML antiguas"

msgid "Every conflict map, terrain view and path grid is written to its own timestamped file so you can compare two of them side by side -- which means they pile up, and one map can be several megabytes.\n\nChecked: on exit, the newest 3 of each kind are kept and older ones removed (with their data folders). Only files this tool generated are ever touched -- never anything you saved yourself with a name of your own choosing.\n\nUnchecked: nothing is ever deleted."
msgstr "Cada mapa de conflictos, vista de terreno y rejilla de rutas se escribe en su propio archivo con marca de tiempo para comparar dos en paralelo -- lo que significa que se acumulan, y un mapa puede ocupar varios megabytes.\n\nMarcado: al salir, se conservan los 3 más recientes de cada tipo y se eliminan los más antiguos (con sus carpetas de datos). Solo se tocan los archivos que esta herramienta generó -- nunca algo que guardaste tú con un nombre de tu elección.\n\nSin marcar: nunca se elimina nada."

msgid "tes3conv conversions are written to disk (not held in RAM) and read per-plugin, so big load orders don't blow up memory. They always go to a 'tes3conv_json' folder next to the app and are reused within a run -- so Check Conflicts then Cell Map won't re-run tes3conv (a plugin is only re-converted if it changed). This box just decides what happens on exit: checked = keep that folder (reused next launch too); unchecked = delete it when you close the app."
msgstr "Las conversiones de tes3conv se escriben en disco (no se mantienen en RAM) y se leen por plugin, para que los órdenes de carga grandes no disparen la memoria. Siempre van a una carpeta «tes3conv_json» junto a la app y se reutilizan dentro de una ejecución -- así que Comprobar conflictos y luego Mapa de celdas no reejecutan tes3conv (un plugin solo se reconvierte si cambió). Esta casilla solo decide qué pasa al salir: marcado = conservar esa carpeta (reutilizada también al próximo inicio); sin marcar = eliminarla al cerrar la app."

msgid "Verbose Merged Lands log"
msgstr "Registro detallado de Merged Lands"

msgid "Checked: a Merge Lands run also names every plugin that carries a .mergedlands.toml and exactly what it sets (per layer: on/off and the conflict strategy), and lists every plugin it could not read -- rather than the headline counts. For working out why a merge did what it did.\n\nUnchecked: the normal summary log."
msgstr "Marcado: una ejecución de Merge Lands también nombra cada plugin que lleva un .mergedlands.toml y exactamente lo que define (por capa: activado/desactivado y la estrategia de conflicto), y lista cada plugin que no pudo leer -- en vez de los recuentos principales. Para averiguar por qué una fusión hizo lo que hizo.\n\nSin marcar: el registro de resumen normal."

msgid "Log"
msgstr "Registro"

msgid "Full output from the last Sort and/or Export. Color key: green = a plugin/path this sort inserted or moved, orange = a heads-up (mlox warning, or a rule your curated cfg order overrode), blue = a section header, bright red = an error worth checking. Plain text = frozen base rows left untouched. Colors follow the syntax highlighting theme picked below."
msgstr "Salida completa de la última Ordenación y/o Export. Clave de colores: verde = un plugin/ruta que esta ordenación insertó o movió, naranja = un aviso (advertencia de mlox, o una regla que tu orden cfg curado anuló), azul = una cabecera de sección, rojo intenso = un error que comprobar. Texto plano = filas base congeladas, dejadas intactas. Los colores siguen el tema de resaltado de sintaxis elegido abajo."

msgid "Clear Log"
msgstr "Vaciar el registro"

msgid "Clear the log panel. Doesn't affect the order panels or any files."
msgstr "Vaciar el panel del registro. No afecta ni a los paneles de orden ni a ningún archivo."

msgid "Save Log As..."
msgstr "Guardar el registro como…"

msgid "Save the current log contents to a text file."
msgstr "Guardar el contenido actual del registro en un archivo de texto."

msgid "Theme:"
msgstr "Tema:"

msgid "Color theme for the whole GUI: window/button colors, syntax highlighting here in the Log panel, and the field-diff JSON viewer (Check Conflicts -> double-click a field). Switching re-themes everything immediately, including any windows already open. Built-in: Dracula, Monokai, Atom One Dark, Gruvbox Dark, plus anything you've imported."
msgstr "Tema de color para toda la interfaz: colores de ventanas/botones, resaltado de sintaxis aquí en el panel del Registro, y el visor JSON de diferencias de campo (Comprobar conflictos -> doble clic en un campo). Cambiar re-tematiza todo al instante, incluidas las ventanas ya abiertas. Integrados: Dracula, Monokai, Atom One Dark, Gruvbox Dark, más lo que hayas importado."

msgid "Import Theme..."
msgstr "Importar tema…"

msgid "Import a custom theme from a JSON file (background/foreground/select/section/warn/error/ok/inserted/dim as hex colors, plus an optional \"chrome\" object for explicit window/button colors) or a base16 scheme file (.yaml/.yml/.json with base00..base0F -- e.g. from the atelierbram/syntax-highlighting or chriskempson/base16 scheme repos). Window colors not given explicitly are derived from the background. Imported themes are saved and appear in the dropdown from then on."
msgstr "Importar un tema personalizado desde un archivo JSON (background/foreground/select/section/warn/error/ok/inserted/dim como colores hex, más un objeto «chrome» opcional para colores de ventana/botón explícitos) o un archivo de esquema base16 (.yaml/.yml/.json con base00..base0F -- p. ej. de los repos atelierbram/syntax-highlighting o chriskempson/base16). Los colores de ventana no dados explícitamente se derivan del fondo. Los temas importados se guardan y aparecen desde entonces en el desplegable."

msgid "Clear Memory"
msgstr "Vaciar la memoria"

msgid "Forget every plugin/folder added by hand (drag-drop or the Add buttons) and any scan result held only in memory (not saved to a .txt) -- none of that is shown anywhere on screen, and it otherwise keeps accumulating for the rest of the session. Does not touch any files."
msgstr "Olvidar cada plugin/carpeta añadido a mano (arrastrar-soltar o los botones Añadir) y cualquier resultado de análisis mantenido solo en memoria (no guardado en un .txt) -- nada de eso se muestra en pantalla, y por lo demás se acumula el resto de la sesión. No toca ningún archivo."

msgid "Help"
msgstr "Ayuda"

msgid "Open the program's own documentation -- the Quick start (what to click, in order) or the Read me (every option, in detail) -- rendered as a readable page with a contents sidebar. Works offline; nothing is downloaded."
msgstr "Abrir la documentación propia del programa -- el Inicio rápido (qué pulsar, en orden) o el Léeme (cada opción en detalle) -- representada como una página legible con una barra lateral de contenido. Funciona sin conexión; no se descarga nada."

msgid "Log syntax highlighting: %(name)s"
msgstr "Resaltado de sintaxis del registro: %(name)s"

msgid "Import syntax highlighting theme"
msgstr "Importar tema de resaltado de sintaxis"

msgid "Import failed"
msgstr "Error al importar"

msgid "Couldn't import that theme:\n\n%(error)s"
msgstr "No se pudo importar ese tema:\n\n%(error)s"

msgid "Imported and applied theme: %(name)s"
msgstr "Tema importado y aplicado: %(name)s"

msgid "Theme imported"
msgstr "Tema importado"

msgid "Imported \"%(name)s\" and set it as the active log theme."
msgstr "«%(name)s» importado y definido como tema activo del registro."

msgid "Missing input"
msgstr "Falta entrada"

msgid "Select the mods folder to scan"
msgstr "Selecciona la carpeta de mods que analizar"

msgid "Save generated subset file as"
msgstr "Guardar el archivo de subconjunto generado como"

msgid "Scanning mods folder..."
msgstr "Analizando la carpeta de mods…"

msgid "Scan complete -- %(folders)d folder(s), %(plugins)d plugin(s). Subset file loaded."
msgstr "Análisis completo -- %(folders)d carpeta(s), %(plugins)d plugin(s). Archivo de subconjunto cargado."

msgid "Scan complete -- %(folders)d folder(s), %(plugins)d plugin(s). Held in memory (no file written)."
msgstr "Análisis completo -- %(folders)d carpeta(s), %(plugins)d plugin(s). Mantenido en memoria (ningún archivo escrito)."

msgid "Add plugin..."
msgstr "Añadir plugin…"

msgid "Include a plugin the Scan missed -- e.g. one sitting outside a recognised mod folder. It joins your custom subset on the next Sort. You can also drag a plugin file onto the list above from your file manager."
msgstr "Incluir un plugin que el Análisis se saltó -- p. ej. uno fuera de una carpeta de mod reconocida. Se une a tu subconjunto personalizado en la próxima Ordenación. También puedes arrastrar un archivo de plugin a la lista de arriba desde tu gestor de archivos."

msgid "(install tkinterdnd2 to drag a plugin in)"
msgstr "(instala tkinterdnd2 para arrastrar un plugin)"

msgid "Add data folder..."
msgstr "Añadir carpeta de datos…"

msgid "Include a folder the Scan missed -- e.g. an OpenMW Lua mod with a non-standard layout (no meshes/textures/... folder and no plugin). It joins your data paths on the next Sort; tick 'Sort data= paths too' to place it in the load order. You can also drag a folder onto the list above from your file manager."
msgstr "Incluir una carpeta que el Análisis se saltó -- p. ej. un mod Lua de OpenMW con una estructura no estándar (sin carpeta meshes/textures/… y sin plugin). Se une a tus rutas de datos en la próxima Ordenación; marca «Ordenar también las rutas data=» para colocarla en el orden de carga. También puedes arrastrar una carpeta a la lista de arriba desde tu gestor de archivos."

msgid "(install tkinterdnd2 to drag a folder in)"
msgstr "(instala tkinterdnd2 para arrastrar una carpeta)"

msgid "Select a data folder to add"
msgstr "Selecciona una carpeta de datos que añadir"

msgid "Select plugin(s) to add"
msgstr "Selecciona los plugins que añadir"

msgid "Plugins"
msgstr "Plugins"

msgid "Added plugin"
msgstr "Plugin añadido"

msgid "Already added"
msgstr "Ya añadido"

msgid "Added data folder"
msgstr "Carpeta de datos añadida"

msgid "  Tick 'Sort data= paths too' to place it."
msgstr "  Marca «Ordenar también las rutas data=» para colocarla."

msgid "Not a plugin or folder: %(path)s"
msgstr "No es un plugin ni una carpeta: %(path)s"

msgid "Nothing to clear."
msgstr "Nada que vaciar."

msgid "%(n)d manual plugin(s)"
msgstr "%(n)d plugin(s) manual(es)"

msgid "%(n)d manual data folder(s)"
msgstr "%(n)d carpeta(s) de datos manual(es)"

msgid "the in-memory scan result"
msgstr "el resultado de análisis en memoria"

msgid "Clear memory?"
msgstr "¿Vaciar la memoria?"

msgid "This forgets everything added by hand this session and any scan result held in memory (not written to a subset file):\n\n%(summary)s\n\nThey will no longer be included on the next Sort. This does not touch the subset file field, remembered paths, or any file on disk. Continue?"
msgstr "Esto olvida todo lo añadido a mano esta sesión y cualquier resultado de análisis mantenido en memoria (no escrito en un archivo de subconjunto):\n\n%(summary)s\n\nYa no se incluirán en la próxima Ordenación. Esto no toca ni el campo del archivo de subconjunto, ni las rutas recordadas, ni ningún archivo del disco. ¿Continuar?"

msgid "Cleared: %(summary)s"
msgstr "Vaciado: %(summary)s"

msgid "%(what)s (%(n)d added, applied on Sort): %(value)s"
msgstr "%(what)s (%(n)d añadidos, aplicados al Ordenar): %(value)s"

msgid "Sorting..."
msgstr "Ordenando…"

msgid ", %(count)d yml warning(s)"
msgstr ", %(count)d advertencia(s) yml"

msgid "Sorted %(plugins)d plugin(s), %(warnings)d rule warning(s)%(yml)s. Drag to adjust, then Export."
msgstr "%(plugins)d plugin(s) ordenados, %(warnings)d advertencia(s) de reglas%(yml)s. Arrastra para ajustar, y luego Exporta."

msgid "openmw.cfg changed"
msgstr "openmw.cfg cambió"

msgid "openmw.cfg has changed on disk since you ran '1. Sort' (did momw-configurator re-run?).\n\nThe order on screen was computed against the OLD contents. It's safer to re-Sort first.\n\nExport anyway?"
msgstr "openmw.cfg ha cambiado en el disco desde que ejecutaste «1. Ordenar» (¿se reejecutó momw-configurator?).\n\nEl orden en pantalla se calculó contra el contenido ANTIGUO. Es más seguro re-Ordenar primero.\n\n¿Exportar de todos modos?"

msgid "Overwrite customizations.toml?"
msgstr "¿Sobrescribir customizations.toml?"

msgid "This will overwrite:\n%(path)s\n\nin place%(note)s. Continue?"
msgstr "Esto sobrescribirá:\n%(path)s\n\nen el sitio%(note)s. ¿Continuar?"

msgid "Exporting..."
msgstr "Exportando…"

msgid "Export done -- cfg written: %(cfg)s, toml written: %(toml)s."
msgstr "Export hecho -- cfg escrito: %(cfg)s, toml escrito: %(toml)s."

msgid "Building cell map..."
msgstr "Construyendo el mapa de celdas…"

msgid "\n\nThis REPLACES the existing %(name)s."
msgstr "\n\nEsto REEMPLAZA el %(name)s existente."

msgid "Build Merged Lands.esp?"
msgstr "¿Construir Merged Lands.esp?"

msgid "A new plugin will be written to:\n%(path)s\n\nIt carries terrain only -- no references, objects or scripts -- so everything placed in those cells stays where it is. Your mods are NOT modified, and deleting the merged plugin restores your previous behaviour completely.\n\nLoad it LAST, and back up your saves before playing with it the first time.%(existing)s\n\nYes: write it here.   No: choose a different folder."
msgstr "Un nuevo plugin se escribirá en:\n%(path)s\n\nSolo lleva terreno -- sin referencias, objetos ni scripts -- así que todo lo colocado en esas celdas se queda donde está. Tus mods NO se modifican, y eliminar el plugin fusionado restaura por completo tu comportamiento anterior.\n\nCárgalo en ÚLTIMO lugar, y haz copia de tus partidas antes de jugar con él la primera vez.%(existing)s\n\nSí: escribirlo aquí.   No: elegir otra carpeta."

msgid "Merging land..."
msgstr "Fusionando terreno…"

msgid "Folder not found"
msgstr "Carpeta no encontrada"

msgid "%(path)s no longer exists. Please choose where to write."
msgstr "%(path)s ya no existe. Por favor, elige dónde escribir."

msgid "Data Files not found"
msgstr "Data Files no encontrado"

msgid "Could not work out which folder holds your plugins, so there is no sensible place to put the merged plugin. Use 'Merged Lands folder...' to choose one."
msgstr "No se pudo averiguar qué carpeta contiene tus plugins, así que no hay un lugar sensato para el plugin fusionado. Usa «Carpeta de Merged Lands…» para elegir uno."

msgid "Where should Merged Lands.esp be written?"
msgstr "¿Dónde debe escribirse Merged Lands.esp?"

msgid "Not a data folder"
msgstr "No es una carpeta de datos"

msgid "%(path)s is not one of the folders OpenMW reads, so it will not find the merged plugin there.\n\nAdd this line to openmw.cfg:\n\ndata=\"%(path)s\"\n\nand put 'content=%(name)s' last."
msgstr "%(path)s no es una de las carpetas que lee OpenMW, así que no encontrará ahí el plugin fusionado.\n\nAñade esta línea a openmw.cfg:\n\ndata=\"%(path)s\"\n\ny pon «content=%(name)s» al final."

msgid " MERGE LANDS"
msgstr " FUSIÓN DE TERRENOS"

msgid "Merge produced nothing to write."
msgstr "La fusión no produjo nada que escribir."

msgid "Merged Lands written: %(cells)d cell(s)."
msgstr "Merged Lands escrito: %(cells)d celda(s)."

msgid "Merge failed -- see log."
msgstr "Error en la fusión -- ver el registro."

msgid "%(contested)d vertex/vertices were edited by more than one mod; the later one in your load order won each."
msgstr "%(contested)d vértice(s) fueron editados por más de un mod; el más tardío en tu orden de carga ganó cada uno."

msgid "%(major)d were blended far from a mod's intent where a .mergedlands.toml asked to Resolve."
msgstr "%(major)d se mezclaron lejos de la intención de un mod donde un .mergedlands.toml pedía Resolve."

msgid "Merged Lands built"
msgstr "Merged Lands construido"

msgid "Written to:\n%(path)s\n\nEnable it and place it LAST in your load order.\n\n%(cells)d land record(s), %(textures)d land texture(s).\n%(detail)s"
msgstr "Escrito en:\n%(path)s\n\nActívalo y colócalo en ÚLTIMO lugar en tu orden de carga.\n\n%(cells)d registro(s) de terreno, %(textures)d textura(s) de terreno.\n%(detail)s"

msgid "Pick a plugin to write a .mergedlands.toml for"
msgstr "Elige un plugin para el que escribir un .mergedlands.toml"

msgid "Morrowind plugins"
msgstr "Plugins de Morrowind"

msgid "Existing .mergedlands.toml could not be read"
msgstr "No se pudo leer el .mergedlands.toml existente"

msgid "%(name)s will be replaced from defaults:\n\n%(err)s"
msgstr "%(name)s se reemplazará con los valores predeterminados:\n\n%(err)s"

msgid "Merge settings: %(name)s"
msgstr "Ajustes de fusión: %(name)s"

msgid "Choose how %(name)s's landscape edits merge. Uncheck a layer to keep this plugin from touching it; set a strategy for how its edits resolve where they collide with another mod. The defaults behave as if there were no file."
msgstr "Elige cómo se fusionan las ediciones de paisaje de %(name)s. Desmarca una capa para impedir que este plugin la toque; define una estrategia para cómo se resuelven sus ediciones donde colisionen con otro mod. Los valores predeterminados se comportan como si no hubiera archivo."

msgid "meta_type:"
msgstr "meta_type:"

msgid "Patch = a hand-written settings file (the usual choice). Auto = default behaviour. MergedLands marks a plugin the tool generated so a re-run ignores it -- do not set that on an ordinary mod."
msgstr "Patch = un archivo de ajustes escrito a mano (la elección habitual). Auto = comportamiento predeterminado. MergedLands marca un plugin generado por la herramienta para que una reejecución lo ignore -- no lo pongas en un mod corriente."

msgid "Layers"
msgstr "Capas"

msgid "include"
msgstr "incluir"

msgid "layer"
msgstr "capa"

msgid "conflict strategy"
msgstr "estrategia de conflicto"

msgid "Vertex heights -- and the normals stored with them."
msgstr "Alturas de vértices -- y las normales almacenadas con ellas."

msgid "Baked vertex colours (terrain lighting)."
msgstr "Colores de vértices precalculados (iluminación del terreno)."

msgid "Which land texture paints each square."
msgstr "Qué textura de terreno pinta cada cuadrado."

msgid "The low-resolution world-map heightmap."
msgstr "El mapa de alturas de baja resolución del mapa del mundo."

msgid "Auto = later plugin wins for entries it changed Â· Overwrite = this plugin wins collisions Â· Ignore = keep the earlier edit Â· Resolve = blend conflicting numbers Â· Curvature = structure-weighted blend (ours)."
msgstr "Auto = el plugin posterior gana para las entradas que cambió · Overwrite = este plugin gana las colisiones · Ignore = conservar la edición anterior · Resolve = mezclar los números en conflicto · Curvature = mezcla ponderada por la estructura (la nuestra)."

msgid "Preview:"
msgstr "Vista previa:"

msgid "Write .mergedlands.toml"
msgstr "Escribir .mergedlands.toml"

msgid "Could not write .mergedlands.toml"
msgstr "No se pudo escribir .mergedlands.toml"

msgid "Wrote %(name)s."
msgstr "%(name)s escrito."

msgid "Merge settings written"
msgstr "Ajustes de fusión escritos"

msgid "Wrote:\n%(path)s\n\nRun Merge Lands to apply it."
msgstr "Escrito:\n%(path)s\n\nEjecuta Merge Lands para aplicarlo."

msgid " CELL MAP"
msgstr " MAPA DE CELDAS"

msgid "native esp reader"
msgstr "lector esp nativo"

msgid "  %(exterior)d exterior + %(interior)d interior cell(s) touched across %(scanned)d plugin(s)."
msgstr "  %(exterior)d celda(s) exterior(es) + %(interior)d interior(es) tocadas en %(scanned)d plugin(s)."

msgid "  Map written to: %(path)s"
msgstr "  Mapa escrito en: %(path)s"

msgid "Cell map ready (%(exterior)d exterior, %(interior)d interior)."
msgstr "Mapa de celdas listo (%(exterior)d exteriores, %(interior)d interiores)."

msgid "Open in browser"
msgstr "Abrir en el navegador"

msgid "(inline render failed -- use 'Open in browser'. The 3D and nav views need a real browser engine.)"
msgstr "(el renderizado incrustado falló -- usa «Abrir en el navegador». Las vistas 3D y de navegación necesitan un motor de navegador real.)"

msgid "Save HTML..."
msgstr "Guardar HTML…"

msgid "(inline render failed - use 'Open in browser' for the full map)"
msgstr "(el renderizado incrustado falló -- usa «Abrir en el navegador» para el mapa completo)"

msgid "Save cell map"
msgstr "Guardar mapa de celdas"

msgid "Cell map saved: %(path)s"
msgstr "Mapa de celdas guardado: %(path)s"

msgid "If upstream moves or a new fork takes over, point the updaters at the new location here. Blank = built-in defaults. Downloads are always validated before anything is overwritten."
msgstr "Si el origen se muda o un nuevo fork toma el relevo, apunta los actualizadores a la nueva ubicación aquí. Vacío = valores predeterminados integrados. Las descargas se validan siempre antes de sobrescribir nada."

msgid "mlox rules URL template:"
msgstr "Plantilla de URL de reglas mlox:"

msgid "Where 'Update Rules...' downloads from. Must contain {name}, which is replaced with mlox_base.txt / mlox_user.txt per file.\nDefault: %(url)s"
msgstr "De dónde descarga «Actualizar reglas…». Debe contener {name}, que se reemplaza por mlox_base.txt / mlox_user.txt según el archivo.\nPredeterminado: %(url)s"

msgid "default: %(url)s"
msgstr "predeterminado: %(url)s"

msgid "plugin-order.yml URL:"
msgstr "URL de plugin-order.yml:"

msgid "Where the plugin-order.yml 'Update...' button downloads from. Blank tries the built-in candidates in order.\nDefault: %(url)s"
msgstr "De dónde descarga el botón «Actualizar…» de plugin-order.yml. Vacío prueba los candidatos integrados en orden.\nPredeterminado: %(url)s"

msgid "default: %(url)s..."
msgstr "predeterminado: %(url)s…"

msgid "Download sources"
msgstr "Descargar fuentes"

msgid "The rules URL template must contain {name} (it's replaced with the rule filename)."
msgstr "La plantilla de URL de reglas debe contener {name} (se reemplaza por el nombre del archivo de reglas)."

msgid "Reset to defaults"
msgstr "Restablecer valores predeterminados"

msgid "Save & Close"
msgstr "Guardar y cerrar"

msgid "New mlox rule"
msgstr "Nueva regla mlox"

msgid "rules file:"
msgstr "archivo de reglas:"

msgid "Personal rules file the rule is appended to (created with a header if new). Use your OWN file, not mlox_base/mlox_user -- those get overwritten by 'Update Rules...'. It's auto-added to the rule-files list LAST, so your rules win conflicts."
msgstr "Archivo de reglas personal al que se añade la regla (creado con una cabecera si es nuevo). Usa TU propio archivo, no mlox_base/mlox_user -- esos los sobrescribe «Actualizar reglas…». Se añade automáticamente en ÚLTIMO lugar a la lista de archivos de reglas, para que tus reglas ganen los conflictos."

msgid "Rule type"
msgstr "Tipo de regla"

msgid "Plugins (order matters for [Order])"
msgstr "Plugins (el orden importa para [Order])"

msgid "From plugin panel"
msgstr "Desde el panel de plugins"

msgid "Add the rows currently SELECTED in the main plugin-order panel, in their displayed order (Ctrl/Shift-click there to multi-select first)."
msgstr "Añadir las filas actualmente SELECCIONADAS en el panel principal de orden de plugins, en su orden mostrado (Ctrl/Mayús-clic para seleccionar varias primero)."

msgid "Group as ANY"
msgstr "Agrupar como ANY"

msgid "Wrap the SELECTED plugins in an [ANY ...] group, for a rule that is satisfied by whichever of several versions someone has installed -- the shape the guidelines use for mods with an XB edition, a Tribunal edition and so on.\n\nSelect the grouped entry and press again to ungroup."
msgstr "Envolver los plugins SELECCIONADOS en un grupo [ANY …], para una regla que se satisface con cualquiera de varias versiones instaladas -- la forma que usan las directrices para mods con edición XB, edición Tribunal, etc.\n\nSelecciona la entrada agrupada y pulsa de nuevo para desagrupar."

msgid "Type a plugin filename and press Enter. mlox wildcards are allowed: ? for one character, * for any run, <VER> for a version number -- though the guidelines ask for these to be used sparingly, since expanding them is slow."
msgstr "Escribe un nombre de archivo de plugin y pulsa Intro. Se permiten comodines mlox: ? para un carácter, * para cualquier serie, <VER> para un número de versión -- aunque las directrices piden usarlos con moderación, ya que expandirlos es lento."

msgid "Add"
msgstr "Añadir"

msgid "Message and source"
msgstr "Mensaje y fuente"

msgid "message:"
msgstr "mensaje:"

msgid "What to tell the person, and what to do about it. Ordering rules carry no message; the warning rules are much less useful without one.\n\nA message containing ']' is written in the block form automatically, because a ']' would otherwise close the rule label early."
msgstr "Qué decirle a la persona, y qué hacer al respecto. Las reglas de orden no llevan mensaje; las reglas de advertencia son mucho menos útiles sin uno.\n\nUn mensaje que contenga «]» se escribe automáticamente en forma de bloque, porque un «]» cerraría si no la etiqueta de la regla demasiado pronto."

msgid "(Ref:) source:"
msgstr "(Ref.:) fuente:"

msgid "Where this rule's claim comes from: a readme filename, a forum post, a URL. The guidelines ask for one on every rule so that someone else can check it, or correct it.\n\nA URL gets whitespace before the closing parenthesis automatically -- pages that auto-link URLs otherwise swallow the ')' into the link."
msgstr "De dónde viene la afirmación de esta regla: un nombre de archivo readme, un mensaje de foro, una URL. Las directrices piden una en cada regla para que otra persona pueda comprobarla, o corregirla.\n\nUna URL recibe automáticamente un espacio antes del paréntesis de cierre -- las páginas que enlazan URL automáticamente se tragan si no el «)» dentro del enlace."

msgid "@section:"
msgstr "@section:"

msgid "Optional heading written above the rule. The rule-base groups rules into sections, roughly one per mod, to keep the file navigable."
msgstr "Encabezado opcional escrito sobre la regla. La base de reglas agrupa las reglas en secciones, aproximadamente una por mod, para mantener el archivo navegable."

msgid "highlight:"
msgstr "resaltado:"

msgid "none"
msgstr "ninguno"

msgid "%(mark)s = %(meaning)s"
msgstr "%(mark)s = %(meaning)s"

msgid "; comment:"
msgstr "; comentario:"

msgid "A ';' comment written above the rule. mlox strips these before reading."
msgstr "Un comentario «;» escrito sobre la regla. mlox los quita antes de leer."

msgid "Preview"
msgstr "Vista previa"

msgid "Append rule"
msgstr "Añadir la regla"

msgid "Write the rule to the file above. Refused while there is an error: mlox silently discards a rule it cannot use, so this is the only place you would find out.\n\nWarnings do not block -- they are the guidelines' advice, not the parser's requirements."
msgstr "Escribir la regla en el archivo de arriba. Rechazado mientras haya un error: mlox descarta en silencio una regla que no puede usar, así que este es el único sitio donde te enterarías.\n\nLas advertencias no bloquean -- son el consejo de las directrices, no los requisitos del analizador."

msgid "Rule guide"
msgstr "Guía de reglas"

msgid "Open the rule reference: what each rule kind says, how expressions nest, and the conventions the rule-base follows.\n\nIt opens in your browser, so it can sit beside this window while you work."
msgstr "Abrir la referencia de reglas: lo que dice cada tipo de regla, cómo se anidan las expresiones y las convenciones que sigue la base de reglas.\n\nSe abre en tu navegador, para que pueda quedarse junto a esta ventana mientras trabajas."

msgid "No problems. This rule follows the guidelines.\n"
msgstr "Sin problemas. Esta regla sigue las directrices.\n"

msgid "Select row(s) in the plugin-order panel first."
msgstr "Selecciona primero una o más filas en el panel de orden de plugins."

msgid "Personal rules file"
msgstr "Archivo de reglas personal"

msgid "New rule"
msgstr "Nueva regla"

msgid "Set a rules file first."
msgstr "Define primero un archivo de reglas."

msgid "Don't append personal rules to mlox_base.txt / mlox_user.txt -- 'Update Rules...' overwrites those. Pick your own file (e.g. mlox_my_rules.txt)."
msgstr "No añadas reglas personales a mlox_base.txt / mlox_user.txt -- «Actualizar reglas…» las sobrescribe. Elige tu propio archivo (p. ej. mlox_my_rules.txt)."

msgid "Rule conflicts with the curated order"
msgstr "La regla entra en conflicto con el orden curado"

msgid "This [Order] rule contradicts the frozen curated (MOMW) order for:\n\n%(pairs)s\n\nmlox will DISCARD those orderings (it never reorders the curated list), so the rule won't take effect for them. Write it anyway?"
msgstr "Esta regla [Order] contradice el orden curado (MOMW) congelado para:\n\n%(pairs)s\n\nmlox DESCARTARÁ esas ordenaciones (nunca reordena la lista curada), así que la regla no tendrá efecto para ellas. ¿Escribirla de todos modos?"

msgid "Rule appended to %(file)s. Re-run '1. Sort' to apply it."
msgstr "Regla añadida a %(file)s. Vuelve a ejecutar «1. Ordenar» para aplicarla."

msgid "Update %(name)s"
msgstr "Actualizar %(name)s"

msgid "Save %(name)s as"
msgstr "Guardar %(name)s como"

msgid "the file doesn't exist yet -- it will be created"
msgstr "el archivo aún no existe -- se creará"

msgid "your copy is ~%(days)d day(s) old"
msgstr "tu copia tiene ~%(days)d día(s)"

msgid "Download the current %(name)s from MOMW?\n\n%(age)s.\n\nThe download is validated before anything is written; a timestamped .bak of the old file is kept."
msgstr "¿Descargar el %(name)s actual de MOMW?\n\n%(age)s.\n\nLa descarga se valida antes de escribir nada; se conserva una .bak con marca de tiempo del archivo antiguo."

msgid "Downloading %(name)s..."
msgstr "Descargando %(name)s…"

msgid "Run '1. Sort' first so there's a load order to check against."
msgstr "Ejecuta primero «1. Ordenar» para que haya un orden de carga con el que comprobar."

msgid "Choose an OpenMW save"
msgstr "Elegir una partida de OpenMW"

msgid "Save check failed: %(error)s"
msgstr "Falló la comprobación de partida: %(error)s"

msgid "Save check: %(count)d missing dependency! See the log."
msgid_plural "Save check: %(count)d missing dependencies! See the log."
msgstr[0] "Comprobación de partida: ¡%(count)d dependencia ausente! Ver el registro."
msgstr[1] "Comprobación de partida: ¡%(count)d dependencias ausentes! Ver el registro."

msgid "Save Check"
msgstr "Comprobación de partida"

msgid "Save check: all %(count)d dependencies present."
msgstr "Comprobación de partida: las %(count)d dependencias están presentes."

msgid "%(file)s: all %(count)d content files it needs are in the current load order. Safe to export."
msgstr "%(file)s: los %(count)d archivos de contenido que necesita están en el orden de carga actual. Seguro para exportar."

msgid "Quick start"
msgstr "Inicio rápido"

msgid "Read me"
msgstr "Léeme"

msgid "Writing mlox rules"
msgstr "Escribir reglas mlox"

msgid "Documentation not found"
msgstr "Documentación no encontrada"

msgid "%(name)s was not found next to the program.\n\nIt ships alongside the app; if this is a build made without it, the same document is in the project folder."
msgstr "%(name)s no se encontró junto al programa.\n\nSe distribuye con la app; si esta es una compilación hecha sin él, el mismo documento está en la carpeta del proyecto."

msgid "Could not open documentation"
msgstr "No se pudo abrir la documentación"

msgid "%(name)s could not be rendered:\n%(error)s"
msgstr "%(name)s no se pudo representar:\n%(error)s"

msgid "Set openmw.cfg (or run a Sort) so I know where to look."
msgstr "Define openmw.cfg (o ejecuta una Ordenación) para que sepa dónde buscar."

msgid "Scanning for backups..."
msgstr "Buscando copias de seguridad…"

msgid "Found %(count)d backup file."
msgid_plural "Found %(count)d backup files."
msgstr[0] "%(count)d archivo de copia de seguridad encontrado."
msgstr[1] "%(count)d archivos de copia de seguridad encontrados."

msgid "Backup scan failed: %(error)s"
msgstr "Falló el análisis de copias de seguridad: %(error)s"

msgid "%(count)d backup file. Restore copies the backup over its original; Delete removes the backup file itself."
msgid_plural "%(count)d backup files. Restore copies the backup over its original; Delete removes the backup file itself."
msgstr[0] "%(count)d archivo de copia de seguridad. Restaurar copia la copia sobre su original; Eliminar quita el propio archivo de copia."
msgstr[1] "%(count)d archivos de copia de seguridad. Restaurar copia la copia sobre su original; Eliminar quita el propio archivo de copia."

msgid "Restore"

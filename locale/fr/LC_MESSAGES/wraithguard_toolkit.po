msgstr "Évaluation des %(n)d premiers enregistrements sur %(total)d de ce groupe."

msgid "%(name)s conflicts with %(n)d plugin(s) (highlighted)."
msgstr "%(name)s est en conflit avec %(n)d plugin(s) (surlignés)."

msgid "Judging the load order -- conflicts that lose work highlight when it finishes."
msgstr "Évaluation de l'ordre de chargement -- les conflits qui perdent du travail sont surlignés à la fin."

msgid "%(name)s conflicts with nothing here."
msgstr "%(name)s n'est en conflit avec rien ici."

msgid "  (wins)"
msgstr "  (gagne)"


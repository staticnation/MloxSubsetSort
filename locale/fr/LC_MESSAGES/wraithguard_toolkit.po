msgstr "\n  Aucun avertissement plugin-order.yml."

msgid "  (plugin files not reachable from the data folders; can't read headers)"
msgstr "  (fichiers de plugin inaccessibles depuis les dossiers de données ; impossible de lire les en-têtes)"

msgid "  All masters present and correctly ordered."
msgstr "  Tous les masters présents et correctement ordonnés."

msgid "master check failed: %(error)s"
msgstr "échec de la vérification des masters : %(error)s"

msgid "\n[STALE] '%(artifact)s' is older than %(count)d active plugin (e.g. %(examples)s%(more)s) -- re-run momw-configurator so it gets rebuilt against the current load order."
msgid_plural "\n[STALE] '%(artifact)s' is older than %(count)d active plugins (e.g. %(examples)s%(more)s) -- re-run momw-configurator so it gets rebuilt against the current load order."
msgstr[0] "\n[PÉRIMÉ] « %(artifact)s » est plus ancien que %(count)d plugin actif (p. ex. %(examples)s%(more)s) -- relancez momw-configurator pour qu'il soit reconstruit contre l'ordre de chargement actuel."
msgstr[1] "\n[PÉRIMÉ] « %(artifact)s » est plus ancien que %(count)d plugins actifs (p. ex. %(examples)s%(more)s) -- relancez momw-configurator pour qu'il soit reconstruit contre l'ordre de chargement actuel."

msgid "  (excluded %(count)d plugin by --exclude)"
msgid_plural "  (excluded %(count)d plugins by --exclude)"
msgstr[0] "  (%(count)d plugin exclu par --exclude)"
msgstr[1] "  (%(count)d plugins exclus par --exclude)"

msgid "  Keeping tes3conv JSON dump in: %(path)s"
msgstr "  Conservation de l'export JSON tes3conv dans : %(path)s"

msgid "  Engine: %(engine)s"
msgstr "  Moteur : %(engine)s"

msgid "native esp reader (field-level)"
msgstr "lecteur esp natif (par champ)"

msgid "\n  Wrote conflict report: %(path)s"
msgstr "\n  Rapport de conflits écrit : %(path)s"

msgid "could not write conflict CSV: %(error)s"
msgstr "impossible d'écrire le CSV des conflits : %(error)s"

msgid "  Scanned %(scanned)d plugin(s): %(exterior)d exterior + %(interior)d interior cell(s) touched."
msgstr "  %(scanned)d plugin(s) analysés : %(exterior)d extérieure(s) + %(interior)d intérieure(s) touchées."

msgid "  Wrote cell map: %(path)s  (open it in a browser)"
msgstr "  Carte des cellules écrite : %(path)s  (ouvrez-la dans un navigateur)"

msgid "could not write cell map: %(error)s"
msgstr "impossible d'écrire la carte des cellules : %(error)s"

msgid "  Scanned %(scanned)d plugin(s); %(cells)d interior cell(s), %(grids)d interior pathgrid(s)."
msgstr "  %(scanned)d plugin(s) analysés ; %(cells)d cellule(s) intérieure(s), %(grids)d grille(s) de chemins intérieure(s)."

msgid "\n  No lint findings."
msgstr "\n  Aucun constat d'analyse."

msgid "\n  Wrote resource report: %(path)s"
msgstr "\n  Rapport de ressources écrit : %(path)s"

msgid "could not write resource CSV: %(error)s"
msgstr "impossible d'écrire le CSV des ressources : %(error)s"

msgid "  Pass --sort-data-paths to enable:"
msgstr "  Passez --sort-data-paths pour activer :"

msgid "  <-- inserted"
msgstr "  <-- inséré"

msgid "UNMANAGED (ORPHAN) ENTRIES FROM openmw.cfg"
msgstr "ENTRÉES NON GÉRÉES (ORPHELINES) DE openmw.cfg"

msgid "  %(count)d orphan plugin pulled from openmw.cfg"
msgid_plural "  %(count)d orphan plugins pulled from openmw.cfg"
msgstr[0] "  %(count)d plugin orphelin récupéré de openmw.cfg"
msgstr[1] "  %(count)d plugins orphelins récupérés de openmw.cfg"

msgid "  No unmanaged plugins found -- every content= plugin in the cfg is on the list or in your customizations."
msgstr "  Aucun plugin non géré trouvé -- chaque plugin content= de la cfg est sur la liste ou dans vos personnalisations."

msgid "groundcover declared by this run"
msgstr "groundcover déclaré par cette exécution"

msgid "  These are written as groundcover= rather than content=. Their data= folders are inserted normally -- OpenMW has to find the file."
msgstr "  Ceux-ci sont écrits en groundcover= plutôt qu'en content=. Leurs dossiers data= sont insérés normalement -- OpenMW doit trouver le fichier."

msgid "groundcover plugins held back"
msgstr "plugins groundcover retenus"

msgid "%(count)d plugin in your subset is already declared as groundcover in openmw.cfg, so it was NOT added to content=:"
msgid_plural "%(count)d plugins in your subset are already declared as groundcover in openmw.cfg, so they were NOT added to content=:"
msgstr[0] "%(count)d plugin de votre sous-ensemble est déjà déclaré comme groundcover dans openmw.cfg, il n'a donc PAS été ajouté à content= :"
msgstr[1] "%(count)d plugins de votre sous-ensemble sont déjà déclarés comme groundcover dans openmw.cfg, ils n'ont donc PAS été ajoutés à content= :"

msgid "  Their groundcover= lines are untouched and their data= paths are still written, so the grass stays enabled -- as grass. Loading one as content= too would spawn every blade as a real object."
msgstr "  Leurs lignes groundcover= sont intactes et leurs chemins data= toujours écrits, l'herbe reste donc activée -- en tant qu'herbe. En charger un aussi en content= ferait apparaître chaque brin comme un objet réel."

msgid "  openmw.cfg left untouched (pass --write-cfg to patch it directly)"
msgstr "  openmw.cfg laissé intact (passez --write-cfg pour le patcher directement)"

msgid "  WARNING: configurator preview failed: %(error)s"
msgstr "  AVERTISSEMENT : l'aperçu du configurateur a échoué : %(error)s"

msgid "\n  DRY RUN: would write %(path)s\n%(toml)s"
msgstr "\n  SIMULATION : écrirait %(path)s\n%(toml)s"

msgid "  Wrote corrected customizations: %(path)s"
msgstr "  Personnalisations corrigées écrites : %(path)s"

msgid "  Plugins sorted:        %(count)d"
msgstr "  Plugins triés :         %(count)d"

msgid "  Data paths inserted:   %(count)d"
msgstr "  Chemins de données insérés : %(count)d"

msgid "  Rule warnings raised:  %(count)d"
msgstr "  Avertissements de règles : %(count)d"

msgid "  plugin-order.yml warnings: %(count)d"
msgstr "  Avertissements plugin-order.yml : %(count)d"

msgid "  openmw.cfg written:    %(answer)s"
msgstr "  openmw.cfg écrit :      %(answer)s"

msgid "yes"
msgstr "oui"

msgid "no"
msgstr "non"

msgid "  customizations.toml written: %(answer)s"
msgstr "  customizations.toml écrit : %(answer)s"

msgid "Rule files (priority = order below, last = highest -- drag rows to reorder)"
msgstr "Fichiers de règles (priorité = ordre ci-dessous, dernier = plus haute -- glissez les lignes pour réorganiser)"

msgid "mlox rule files (mlox_base.txt, mlox_user.txt, ...), applied in this order.\nLater files can override/extend earlier ones -- put mlox_base.txt first and your own mlox_user.txt last. Drag rows to reorder, or use the buttons."
msgstr "Fichiers de règles mlox (mlox_base.txt, mlox_user.txt, …), appliqués dans cet ordre.\nLes fichiers ultérieurs peuvent remplacer/étendre les précédents -- mettez mlox_base.txt en premier et votre propre mlox_user.txt en dernier. Glissez les lignes pour réorganiser, ou utilisez les boutons."

msgid "Add File(s)..."
msgstr "Ajouter des fichiers…"

msgid "Browse for one or more mlox rule .txt files to add to the list."
msgstr "Parcourez pour ajouter un ou plusieurs fichiers .txt de règles mlox à la liste."

msgid "Remove Selected"
msgstr "Supprimer la sélection"

msgid "Remove the selected rule file from the list (doesn't delete anything on disk)."
msgstr "Retirer le fichier de règles sélectionné de la liste (ne supprime rien sur le disque)."

msgid "Move Up"
msgstr "Monter"

msgid "Move the selected rule file earlier (lower priority)."
msgstr "Déplacer le fichier de règles sélectionné plus tôt (priorité inférieure)."

msgid "Move Down"
msgstr "Descendre"

msgid "Move the selected rule file later (higher priority)."
msgstr "Déplacer le fichier de règles sélectionné plus tard (priorité supérieure)."

msgid "New Rule..."
msgstr "Nouvelle règle…"

msgid "Write your own mlox [Order]/[NearStart]/[NearEnd] rule without knowing the syntax: pick plugins (or grab the selected rows from the plugin panel), preview the rule, and append it to a personal rules file that loads LAST so it wins conflicts. This is how rules for modern mods get made -- consider contributing good ones upstream."
msgstr "Écrivez votre propre règle mlox [Order]/[NearStart]/[NearEnd] sans en connaître la syntaxe : choisissez des plugins (ou récupérez les lignes sélectionnées du panneau des plugins), prévisualisez la règle et ajoutez-la à un fichier de règles personnel qui charge en DERNIER pour gagner les conflits. C'est ainsi que naissent les règles des mods modernes -- envisagez d'en contribuer de bonnes en amont."

msgid "Update Rules..."
msgstr "Mettre à jour les règles…"

msgid "Download the CURRENT mlox_base.txt / mlox_user.txt from the actively maintained rules repo (github.com/%(repo)s -- the same source plox uses, and mlox 1.1+ auto-updates from) over the matching files in this list. The old files are kept as timestamped .bak copies. Files with other names (your personal rules) are never touched. Source URL configurable via Sources..."
msgstr "Télécharger les mlox_base.txt / mlox_user.txt ACTUELS depuis le dépôt de règles activement maintenu (github.com/%(repo)s -- la même source qu'utilise plox, et depuis laquelle mlox 1.1+ se met à jour) par-dessus les fichiers correspondants de cette liste. Les anciens fichiers sont conservés en copies .bak horodatées. Les fichiers d'autres noms (vos règles personnelles) ne sont jamais touchés. URL source configurable via Sources…"

msgid "Sources..."
msgstr "Sources…"

msgid "Configure WHERE 'Update Rules...' and the plugin-order.yml 'Update...' button download from -- point them at a fork or mirror if upstream moves. Blank fields use the built-in defaults."
msgstr "Configurer D'OÙ « Mettre à jour les règles… » et le bouton « Mettre à jour… » de plugin-order.yml téléchargent -- pointez-les vers un fork ou miroir si l'amont déménage. Les champs vides utilisent les valeurs par défaut intégrées."

msgid "(install tkinterdnd2 to drag files in from your file manager)"
msgstr "(installez tkinterdnd2 pour glisser des fichiers depuis votre gestionnaire de fichiers)"

msgid "Choose a folder for the mlox rule files"
msgstr "Choisir un dossier pour les fichiers de règles mlox"

msgid "Update rules"
msgstr "Mettre à jour les règles"

msgid "Download the current mlox rules from github.com/%(repo)s?\n\n%(files)s\n\nThey don't exist yet -- they'll be created here."
msgstr "Télécharger les règles mlox actuelles depuis github.com/%(repo)s ?\n\n%(files)s\n\nElles n'existent pas encore -- elles seront créées ici."

msgid "Download the current rules from github.com/%(repo)s over these files?\n\n%(age)s\n\nTimestamped .bak copies of the old files are kept."
msgstr "Télécharger les règles actuelles depuis github.com/%(repo)s par-dessus ces fichiers ?\n\n%(age)s\n\nDes copies .bak horodatées des anciens fichiers sont conservées."

msgid "Move the selected row(s) one position earlier. Works with a multi-selection; you can also drag a contiguous block up with the mouse."
msgstr "Déplacer la ou les lignes sélectionnées d'une position plus tôt. Fonctionne avec une sélection multiple ; vous pouvez aussi glisser un bloc contigu vers le haut à la souris."

msgid "Move the selected row(s) one position later. Works with a multi-selection; you can also drag a contiguous block down with the mouse."
msgstr "Déplacer la ou les lignes sélectionnées d'une position plus tard. Fonctionne avec une sélection multiple ; vous pouvez aussi glisser un bloc contigu vers le bas à la souris."

msgid "Disable / Enable"
msgstr "Désactiver / Activer"

msgid "Opt the selected row in or out of the load order. Disabled rows are dimmed and marked, and are left out of Export: a custom item is simply not inserted, and an item already in your openmw.cfg gets a removeContent/removeData entry in the emitted TOML so it's durably removed. Double-click a row to toggle it too."
msgstr "Inclure ou exclure la ligne sélectionnée de l'ordre de chargement. Les lignes désactivées sont atténuées et marquées, et exclues de l'Export : un élément personnalisé n'est simplement pas inséré, et un élément déjà dans votre openmw.cfg reçoit une entrée removeContent/removeData dans le TOML émis pour être durablement retiré. Double-cliquer sur une ligne la bascule aussi."

msgid "Discard any manual dragging and restore the order from the last Sort (your disable/enable choices are kept)."
msgstr "Abandonner tout glissement manuel et rétablir l'ordre du dernier Tri (vos choix d'activation/désactivation sont conservés)."

msgid "Plugin load order -- drag to override mlox (red = touched by this sort, purple = master problem)"
msgstr "Ordre de chargement des plugins -- glissez pour surpasser mlox (rouge = touché par ce tri, violet = problème de master)"

msgid "Data path order -- drag to adjust (highlighted = your custom paths)"
msgstr "Ordre des chemins de données -- glissez pour ajuster (surligné = vos chemins personnalisés)"

msgid "Drag & drop is unavailable (tkinterdnd2 or its tkdnd library is missing) -- use the Browse buttons below."
msgstr "Le glisser-déposer est indisponible (tkinterdnd2 ou sa bibliothèque tkdnd est absente) -- utilisez les boutons Parcourir ci-dessous."

msgid "Required. The openmw.cfg to read the current content= and data= order from, and (if 'Write openmw.cfg directly' is checked) to patch."
msgstr "Requis. Le openmw.cfg d'où lire l'ordre content= et data= actuel et (si « Écrire openmw.cfg directement » est coché) à patcher."

msgid "A momw-configurator/umo customizations TOML to pull the plugin/data-path subset from automatically. Optional if you provide a subset file instead -- provide both and they're combined."
msgstr "Un TOML de personnalisations momw-configurator/umo d'où tirer automatiquement le sous-ensemble plugins/chemins de données. Facultatif si vous fournissez un fichier de sous-ensemble à la place -- fournissez les deux et ils sont combinés."

msgid "A plain text file (one plugin filename or data folder path per line, '#' comments allowed) or a minimal TOML with subset=[...]/data=[...]. Combined with --emit-toml, this alone is enough to generate a brand new customizations.toml with no existing one required."
msgstr "Un fichier texte brut (un nom de fichier de plugin ou un chemin de dossier de données par ligne, commentaires « # » autorisés) ou un TOML minimal avec subset=[...]/data=[...]. Combiné à --emit-toml, cela suffit seul à générer un tout nouveau customizations.toml sans qu'un existant soit requis."

msgid "Where to write a corrected customizations.toml (sorted insert blocks, re-anchored). Disabled when 'write directly back' below is checked."
msgstr "Où écrire un customizations.toml corrigé (blocs d'insertion triés, ré-ancrés). Désactivé quand « réécrire directement » ci-dessous est coché."

msgid "list name (optional):"
msgstr "nom de la liste (facultatif) :"

msgid "MOMW's plugin-order.yml (source of truth for which plugins belong to which curated list). With the list name above set, curated plugins for that list are excluded from the sort (never reordered) so only your custom additions are touched, and read-only warnings are emitted: redundant, orphan, needs-cleaning, and a base-order drift check. PyYAML used if installed, else a built-in parser."
msgstr "Le plugin-order.yml de MOMW (la source de vérité indiquant quels plugins appartiennent à quelle liste curée). Avec le nom de liste ci-dessus défini, les plugins curés de cette liste sont exclus du tri (jamais réordonnés) pour que seuls vos ajouts personnalisés soient touchés, et des avertissements en lecture seule sont émis : redondant, orphelin, needs-cleaning et une vérification de dérive de l'ordre de base. PyYAML utilisé si installé, sinon un analyseur intégré."

msgid "Write directly back to customizations.toml (overwrite in place; a .bak-<timestamp> copy is made first unless backups are disabled below)"
msgstr "Réécrire directement dans customizations.toml (écraser sur place ; une copie .bak-<horodatage> est faite d'abord sauf si les sauvegardes sont désactivées ci-dessous)"

msgid "Instead of writing to a separate file above, overwrite the customizations.toml given above in place. A timestamped backup is made first (unless disabled), and you'll get a confirmation prompt before it actually happens."
msgstr "Au lieu d'écrire dans un fichier séparé ci-dessus, écraser sur place le customizations.toml indiqué ci-dessus. Une sauvegarde horodatée est faite d'abord (sauf si désactivée), et vous aurez une demande de confirmation avant que cela n'arrive vraiment."

msgid "Options"
msgstr "Options"

msgid "Dry run (preview only, don't write files)"
msgstr "Simulation (aperçu seulement, n'écrit pas de fichiers)"

msgid "When checked, Export shows exactly what it would write without touching any files. Uncheck when you're ready to actually save."
msgstr "Quand coché, l'Export montre exactement ce qu'il écrirait sans toucher aucun fichier. Décochez quand vous êtes prêt à réellement enregistrer."

msgid "Write openmw.cfg directly"
msgstr "Écrire openmw.cfg directement"

msgid "Patch the content=/data= lines in openmw.cfg in place on Export. A .bak-<timestamp> copy is made first unless backups are disabled."
msgstr "Patcher sur place les lignes content=/data= de openmw.cfg lors de l'Export. Une copie .bak-<horodatage> est faite d'abord sauf si les sauvegardes sont désactivées."

msgid "Sort data= paths too"
msgstr "Trier aussi les chemins data="

msgid "mlox has no concept of data= folder order -- this positions new data= paths using an explicit after/before anchor if you wrote one, or by scanning the folder for plugins and anchoring next to their neighbor in the sorted content= order. Off by default so a plugin-only run can't surprise-reorder data= too. Also required for the data path order panel to populate."
msgstr "mlox n'a aucune notion d'ordre des dossiers data= -- ceci positionne les nouveaux chemins data= avec une ancre after/before explicite si vous en avez écrit une, ou en analysant le dossier à la recherche de plugins et en l'ancrant près de leur voisin dans l'ordre content= trié. Désactivé par défaut pour qu'une exécution plugins-seuls ne réordonne pas data= par surprise. Aussi requis pour que le panneau d'ordre des chemins de données se remplisse."

msgid "Skip .bak backup of openmw.cfg"
msgstr "Ignorer la sauvegarde .bak de openmw.cfg"

msgid "Skip making a timestamped backup before overwriting openmw.cfg and/or an in-place customizations.toml. Not recommended."
msgstr "Ignorer la création d'une sauvegarde horodatée avant d'écraser openmw.cfg et/ou un customizations.toml sur place. Déconseillé."

msgid "Skip mlox Conflict/Requires/Note warnings"
msgstr "Ignorer les avertissements Conflict/Requires/Note de mlox"

msgid "Skip evaluating [Conflict]/[Requires]/[Note] rules against the sorted plugin list. This is purely informational and read-only either way -- it never changes the computed order or what gets written, only whether warnings get printed."
msgstr "Ignorer l'évaluation des règles [Conflict]/[Requires]/[Note] contre la liste de plugins triée. C'est purement informatif et en lecture seule dans tous les cas -- cela ne change jamais l'ordre calculé ni ce qui est écrit, seulement l'affichage ou non des avertissements."

msgid "Create subset text document (on Scan)"
msgstr "Créer un document texte de sous-ensemble (au Scan)"

msgid "Controls what 'Scan...' does with its result. Checked: write the scanned list to a .txt subset file you choose, and load it (the file stays on disk for reuse). Unchecked: keep the scanned list in memory just for this session and feed it straight to the sort -- nothing is written to disk."
msgstr "Contrôle ce que « Scan… » fait de son résultat. Coché : écrire la liste analysée dans un fichier de sous-ensemble .txt que vous choisissez, et le charger (le fichier reste sur le disque pour réutilisation). Décoché : garder la liste analysée en mémoire pour cette session seulement et l'envoyer directement au tri -- rien n'est écrit sur le disque."

msgid "Pull unmanaged (orphan) plugins from openmw.cfg"
msgstr "Récupérer les plugins non gérés (orphelins) de openmw.cfg"

msgid "Also sort the content= plugins ALREADY in openmw.cfg that nothing manages -- neither the curated list (plugin-order.yml) nor your customizations.toml. Their current cfg order is kept as the starting order until the sort repositions them. Base masters (Morrowind/Tribunal/Bloodmoon) are never touched. Works on its own (no subset file needed) or alongside one.\n\ndata= paths are left exactly as openmw.cfg has them: they are already in the cfg's own data= order, and there is no reliable way to tell a path the list manages from one you added, so pulling them would reorder the whole VFS."
msgstr "Trier aussi les plugins content= DÉJÀ dans openmw.cfg que rien ne gère -- ni la liste curée (plugin-order.yml) ni votre customizations.toml. Leur ordre cfg actuel est gardé comme ordre de départ jusqu'à ce que le tri les repositionne. Les masters de base (Morrowind/Tribunal/Bloodmoon) ne sont jamais touchés. Fonctionne seul (pas de fichier de sous-ensemble requis) ou avec un.\n\nLes chemins data= restent exactement tels que openmw.cfg les a : ils sont déjà dans l'ordre data= propre de la cfg, et il n'y a aucun moyen fiable de distinguer un chemin géré par la liste d'un que vous avez ajouté, les récupérer réordonnerait donc tout le VFS."

msgid "Exclude from conflict / cell scans:"
msgstr "Exclure des analyses de conflits / cellules :"

msgid "Declare as groundcover:"
msgstr "Déclarer comme groundcover :"

msgid "Keep tes3conv JSON dump"
msgstr "Conserver l'export JSON tes3conv"

msgid "Tidy old HTML views"
msgstr "Nettoyer les anciennes vues HTML"

msgid "Every conflict map, terrain view and path grid is written to its own timestamped file so you can compare two of them side by side -- which means they pile up, and one map can be several megabytes.\n\nChecked: on exit, the newest 3 of each kind are kept and older ones removed (with their data folders). Only files this tool generated are ever touched -- never anything you saved yourself with a name of your own choosing.\n\nUnchecked: nothing is ever deleted."
msgstr "Chaque carte des conflits, vue de terrain et grille de chemins est écrite dans son propre fichier horodaté pour comparer deux d'entre elles côte à côte -- ce qui veut dire qu'elles s'accumulent, et une carte peut faire plusieurs mégaoctets.\n\nCoché : à la fermeture, les 3 plus récents de chaque type sont conservés et les plus anciens supprimés (avec leurs dossiers de données). Seuls les fichiers générés par cet outil sont jamais touchés -- jamais quelque chose que vous avez enregistré vous-même sous un nom de votre choix.\n\nDécoché : rien n'est jamais supprimé."

msgid "tes3conv conversions are written to disk (not held in RAM) and read per-plugin, so big load orders don't blow up memory. They always go to a 'tes3conv_json' folder next to the app and are reused within a run -- so Check Conflicts then Cell Map won't re-run tes3conv (a plugin is only re-converted if it changed). This box just decides what happens on exit: checked = keep that folder (reused next launch too); unchecked = delete it when you close the app."
msgstr "Les conversions tes3conv sont écrites sur disque (pas gardées en RAM) et lues par plugin, pour que les grands ordres de chargement ne fassent pas exploser la mémoire. Elles vont toujours dans un dossier « tes3conv_json » à côté de l'app et sont réutilisées au sein d'une exécution -- Vérifier les conflits puis Carte des cellules ne relanceront donc pas tes3conv (un plugin n'est reconverti que s'il a changé). Cette case décide juste ce qui se passe à la fermeture : coché = garder ce dossier (réutilisé au prochain lancement aussi) ; décoché = le supprimer à la fermeture de l'app."

msgid "Verbose Merged Lands log"
msgstr "Journal Merged Lands détaillé"

msgid "Checked: a Merge Lands run also names every plugin that carries a .mergedlands.toml and exactly what it sets (per layer: on/off and the conflict strategy), and lists every plugin it could not read -- rather than the headline counts. For working out why a merge did what it did.\n\nUnchecked: the normal summary log."
msgstr "Coché : une exécution de Merge Lands nomme aussi chaque plugin porteur d'un .mergedlands.toml et exactement ce qu'il définit (par couche : activé/désactivé et la stratégie de conflit), et liste chaque plugin qu'elle n'a pas pu lire -- plutôt que les décomptes principaux. Pour comprendre pourquoi une fusion a fait ce qu'elle a fait.\n\nDécoché : le journal de résumé normal."

msgid "Log"
msgstr "Journal"

msgid "Full output from the last Sort and/or Export. Color key: green = a plugin/path this sort inserted or moved, orange = a heads-up (mlox warning, or a rule your curated cfg order overrode), blue = a section header, bright red = an error worth checking. Plain text = frozen base rows left untouched. Colors follow the syntax highlighting theme picked below."
msgstr "Sortie complète du dernier Tri et/ou Export. Légende des couleurs : vert = un plugin/chemin que ce tri a inséré ou déplacé, orange = un avertissement (mlox, ou une règle que votre ordre cfg curé a surpassée), bleu = un en-tête de section, rouge vif = une erreur à vérifier. Texte simple = lignes de base figées, laissées intactes. Les couleurs suivent le thème de coloration syntaxique choisi ci-dessous."

msgid "Clear Log"
msgstr "Effacer le journal"

msgid "Clear the log panel. Doesn't affect the order panels or any files."
msgstr "Effacer le panneau du journal. N'affecte ni les panneaux d'ordre ni aucun fichier."

msgid "Save Log As..."
msgstr "Enregistrer le journal sous…"

msgid "Save the current log contents to a text file."
msgstr "Enregistrer le contenu actuel du journal dans un fichier texte."

msgid "Theme:"
msgstr "Thème :"

msgid "Color theme for the whole GUI: window/button colors, syntax highlighting here in the Log panel, and the field-diff JSON viewer (Check Conflicts -> double-click a field). Switching re-themes everything immediately, including any windows already open. Built-in: Dracula, Monokai, Atom One Dark, Gruvbox Dark, plus anything you've imported."
msgstr "Thème de couleurs pour toute l'interface : couleurs des fenêtres/boutons, coloration syntaxique ici dans le panneau du Journal, et la visionneuse JSON de différence des champs (Vérifier les conflits -> double-clic sur un champ). Changer re-thématise tout immédiatement, y compris les fenêtres déjà ouvertes. Intégrés : Dracula, Monokai, Atom One Dark, Gruvbox Dark, plus tout ce que vous avez importé."

msgid "Import Theme..."
msgstr "Importer un thème…"

msgid "Import a custom theme from a JSON file (background/foreground/select/section/warn/error/ok/inserted/dim as hex colors, plus an optional \"chrome\" object for explicit window/button colors) or a base16 scheme file (.yaml/.yml/.json with base00..base0F -- e.g. from the atelierbram/syntax-highlighting or chriskempson/base16 scheme repos). Window colors not given explicitly are derived from the background. Imported themes are saved and appear in the dropdown from then on."
msgstr "Importer un thème personnalisé depuis un fichier JSON (background/foreground/select/section/warn/error/ok/inserted/dim en couleurs hex, plus un objet « chrome » facultatif pour des couleurs de fenêtre/bouton explicites) ou un fichier de schéma base16 (.yaml/.yml/.json avec base00..base0F -- p. ex. des dépôts atelierbram/syntax-highlighting ou chriskempson/base16). Les couleurs de fenêtre non données explicitement sont dérivées du fond. Les thèmes importés sont enregistrés et apparaissent ensuite dans la liste déroulante."

msgid "Clear Memory"
msgstr "Vider la mémoire"

msgid "Forget every plugin/folder added by hand (drag-drop or the Add buttons) and any scan result held only in memory (not saved to a .txt) -- none of that is shown anywhere on screen, and it otherwise keeps accumulating for the rest of the session. Does not touch any files."
msgstr "Oublier chaque plugin/dossier ajouté à la main (glisser-déposer ou les boutons Ajouter) et tout résultat d'analyse gardé seulement en mémoire (non enregistré dans un .txt) -- rien de tout cela n'est affiché à l'écran, et cela s'accumule sinon pour le reste de la session. Ne touche aucun fichier."

msgid "Help"
msgstr "Aide"

msgid "Open the program's own documentation -- the Quick start (what to click, in order) or the Read me (every option, in detail) -- rendered as a readable page with a contents sidebar. Works offline; nothing is downloaded."
msgstr "Ouvrir la documentation propre du programme -- le Démarrage rapide (quoi cliquer, dans l'ordre) ou le Lisez-moi (chaque option en détail) -- rendue en page lisible avec une barre latérale de sommaire. Fonctionne hors ligne ; rien n'est téléchargé."

msgid "Log syntax highlighting: %(name)s"
msgstr "Coloration syntaxique du journal : %(name)s"

msgid "Import syntax highlighting theme"
msgstr "Importer un thème de coloration syntaxique"

msgid "Import failed"
msgstr "Échec de l'import"

msgid "Couldn't import that theme:\n\n%(error)s"
msgstr "Impossible d'importer ce thème :\n\n%(error)s"

msgid "Imported and applied theme: %(name)s"
msgstr "Thème importé et appliqué : %(name)s"

msgid "Theme imported"
msgstr "Thème importé"

msgid "Imported \"%(name)s\" and set it as the active log theme."
msgstr "« %(name)s » importé et défini comme thème actif du journal."

msgid "Missing input"
msgstr "Entrée manquante"

msgid "Select the mods folder to scan"
msgstr "Sélectionner le dossier de mods à analyser"

msgid "Save generated subset file as"
msgstr "Enregistrer le fichier de sous-ensemble généré sous"

msgid "Scanning mods folder..."
msgstr "Analyse du dossier de mods…"

msgid "Scan complete -- %(folders)d folder(s), %(plugins)d plugin(s). Subset file loaded."
msgstr "Analyse terminée -- %(folders)d dossier(s), %(plugins)d plugin(s). Fichier de sous-ensemble chargé."

msgid "Scan complete -- %(folders)d folder(s), %(plugins)d plugin(s). Held in memory (no file written)."
msgstr "Analyse terminée -- %(folders)d dossier(s), %(plugins)d plugin(s). Gardé en mémoire (aucun fichier écrit)."

msgid "Add plugin..."
msgstr "Ajouter un plugin…"

msgid "Include a plugin the Scan missed -- e.g. one sitting outside a recognised mod folder. It joins your custom subset on the next Sort. You can also drag a plugin file onto the list above from your file manager."
msgstr "Inclure un plugin manqué par le Scan -- p. ex. un situé hors d'un dossier de mod reconnu. Il rejoint votre sous-ensemble personnalisé au prochain Tri. Vous pouvez aussi glisser un fichier de plugin sur la liste ci-dessus depuis votre gestionnaire de fichiers."

msgid "(install tkinterdnd2 to drag a plugin in)"
msgstr "(installez tkinterdnd2 pour glisser un plugin)"

msgid "Add data folder..."
msgstr "Ajouter un dossier de données…"

msgid "Include a folder the Scan missed -- e.g. an OpenMW Lua mod with a non-standard layout (no meshes/textures/... folder and no plugin). It joins your data paths on the next Sort; tick 'Sort data= paths too' to place it in the load order. You can also drag a folder onto the list above from your file manager."
msgstr "Inclure un dossier manqué par le Scan -- p. ex. un mod Lua OpenMW à structure non standard (pas de dossier meshes/textures/… et pas de plugin). Il rejoint vos chemins de données au prochain Tri ; cochez « Trier aussi les chemins data= » pour le placer dans l'ordre de chargement. Vous pouvez aussi glisser un dossier sur la liste ci-dessus depuis votre gestionnaire de fichiers."

msgid "(install tkinterdnd2 to drag a folder in)"
msgstr "(installez tkinterdnd2 pour glisser un dossier)"

msgid "Select a data folder to add"
msgstr "Sélectionner un dossier de données à ajouter"

msgid "Select plugin(s) to add"
msgstr "Sélectionner le(s) plugin(s) à ajouter"

msgid "Plugins"
msgstr "Plugins"

msgid "Added plugin"
msgstr "Plugin ajouté"

msgid "Already added"
msgstr "Déjà ajouté"

msgid "Added data folder"
msgstr "Dossier de données ajouté"

msgid "  Tick 'Sort data= paths too' to place it."
msgstr "  Cochez « Trier aussi les chemins data= » pour le placer."

msgid "Not a plugin or folder: %(path)s"
msgstr "Ni un plugin ni un dossier : %(path)s"

msgid "Nothing to clear."
msgstr "Rien à effacer."

msgid "%(n)d manual plugin(s)"
msgstr "%(n)d plugin(s) manuel(s)"

msgid "%(n)d manual data folder(s)"
msgstr "%(n)d dossier(s) de données manuel(s)"

msgid "the in-memory scan result"
msgstr "le résultat d'analyse en mémoire"

msgid "Clear memory?"
msgstr "Vider la mémoire ?"

msgid "This forgets everything added by hand this session and any scan result held in memory (not written to a subset file):\n\n%(summary)s\n\nThey will no longer be included on the next Sort. This does not touch the subset file field, remembered paths, or any file on disk. Continue?"
msgstr "Ceci oublie tout ce qui a été ajouté à la main cette session et tout résultat d'analyse gardé en mémoire (non écrit dans un fichier de sous-ensemble) :\n\n%(summary)s\n\nIls ne seront plus inclus au prochain Tri. Ceci ne touche ni le champ du fichier de sous-ensemble, ni les chemins mémorisés, ni aucun fichier sur le disque. Continuer ?"

msgid "Cleared: %(summary)s"
msgstr "Vidé : %(summary)s"

msgid "%(what)s (%(n)d added, applied on Sort): %(value)s"
msgstr "%(what)s (%(n)d ajoutés, appliqués au Tri) : %(value)s"

msgid "Sorting..."
msgstr "Tri…"

msgid ", %(count)d yml warning(s)"
msgstr ", %(count)d avertissement(s) yml"

msgid "Sorted %(plugins)d plugin(s), %(warnings)d rule warning(s)%(yml)s. Drag to adjust, then Export."
msgstr "%(plugins)d plugin(s) triés, %(warnings)d avertissement(s) de règles%(yml)s. Glissez pour ajuster, puis Exportez."

msgid "openmw.cfg changed"
msgstr "openmw.cfg modifié"

msgid "openmw.cfg has changed on disk since you ran '1. Sort' (did momw-configurator re-run?).\n\nThe order on screen was computed against the OLD contents. It's safer to re-Sort first.\n\nExport anyway?"
msgstr "openmw.cfg a changé sur le disque depuis que vous avez lancé « 1. Trier » (momw-configurator a-t-il été relancé ?).\n\nL'ordre à l'écran a été calculé contre l'ANCIEN contenu. Il est plus sûr de re-Trier d'abord.\n\nExporter quand même ?"

msgid "Overwrite customizations.toml?"
msgstr "Écraser customizations.toml ?"

msgid "This will overwrite:\n%(path)s\n\nin place%(note)s. Continue?"
msgstr "Ceci écrasera :\n%(path)s\n\nsur place%(note)s. Continuer ?"

msgid "Exporting..."
msgstr "Export…"

msgid "Export done -- cfg written: %(cfg)s, toml written: %(toml)s."
msgstr "Export terminé -- cfg écrit : %(cfg)s, toml écrit : %(toml)s."

msgid "Building cell map..."
msgstr "Construction de la carte des cellules…"

msgid "\n\nThis REPLACES the existing %(name)s."
msgstr "\n\nCeci REMPLACE le %(name)s existant."

msgid "Build Merged Lands.esp?"
msgstr "Construire Merged Lands.esp ?"

msgid "A new plugin will be written to:\n%(path)s\n\nIt carries terrain only -- no references, objects or scripts -- so everything placed in those cells stays where it is. Your mods are NOT modified, and deleting the merged plugin restores your previous behaviour completely.\n\nLoad it LAST, and back up your saves before playing with it the first time.%(existing)s\n\nYes: write it here.   No: choose a different folder."
msgstr "Un nouveau plugin sera écrit dans :\n%(path)s\n\nIl ne porte que du terrain -- pas de références, objets ou scripts -- tout ce qui est placé dans ces cellules reste donc où il est. Vos mods ne sont PAS modifiés, et supprimer le plugin fusionné rétablit entièrement votre comportement précédent.\n\nChargez-le en DERNIER, et sauvegardez vos parties avant d'y jouer la première fois.%(existing)s\n\nOui : l'écrire ici.   Non : choisir un autre dossier."

msgid "Merging land..."
msgstr "Fusion du terrain…"

msgid "Folder not found"
msgstr "Dossier introuvable"

msgid "%(path)s no longer exists. Please choose where to write."
msgstr "%(path)s n'existe plus. Veuillez choisir où écrire."

msgid "Data Files not found"
msgstr "Data Files introuvable"

msgid "Could not work out which folder holds your plugins, so there is no sensible place to put the merged plugin. Use 'Merged Lands folder...' to choose one."
msgstr "Impossible de déterminer quel dossier contient vos plugins, il n'y a donc pas d'endroit sensé pour le plugin fusionné. Utilisez « Dossier Merged Lands… » pour en choisir un."

msgid "Where should Merged Lands.esp be written?"
msgstr "Où Merged Lands.esp doit-il être écrit ?"

msgid "Not a data folder"
msgstr "Ce n'est pas un dossier de données"

msgid "%(path)s is not one of the folders OpenMW reads, so it will not find the merged plugin there.\n\nAdd this line to openmw.cfg:\n\ndata=\"%(path)s\"\n\nand put 'content=%(name)s' last."
msgstr "%(path)s n'est pas l'un des dossiers que lit OpenMW, il n'y trouvera donc pas le plugin fusionné.\n\nAjoutez cette ligne à openmw.cfg :\n\ndata=\"%(path)s\"\n\net mettez « content=%(name)s » en dernier."

msgid " MERGE LANDS"
msgstr " FUSION DES TERRAINS"

msgid "Merge produced nothing to write."
msgstr "La fusion n'a rien produit à écrire."

msgid "Merged Lands written: %(cells)d cell(s)."
msgstr "Merged Lands écrit : %(cells)d cellule(s)."

msgid "Merge failed -- see log."
msgstr "Échec de la fusion -- voir le journal."

msgid "%(contested)d vertex/vertices were edited by more than one mod; the later one in your load order won each."
msgstr "%(contested)d sommet(s) ont été modifiés par plus d'un mod ; le plus tardif dans votre ordre de chargement a gagné chacun."

msgid "%(major)d were blended far from a mod's intent where a .mergedlands.toml asked to Resolve."
msgstr "%(major)d ont été mélangés loin de l'intention d'un mod là où un .mergedlands.toml demandait Resolve."

msgid "Merged Lands built"
msgstr "Merged Lands construit"

msgid "Written to:\n%(path)s\n\nEnable it and place it LAST in your load order.\n\n%(cells)d land record(s), %(textures)d land texture(s).\n%(detail)s"
msgstr "Écrit dans :\n%(path)s\n\nActivez-le et placez-le en DERNIER dans votre ordre de chargement.\n\n%(cells)d enregistrement(s) de terrain, %(textures)d texture(s) de terrain.\n%(detail)s"

msgid "Pick a plugin to write a .mergedlands.toml for"
msgstr "Choisissez un plugin pour lequel écrire un .mergedlands.toml"

msgid "Morrowind plugins"
msgstr "Plugins Morrowind"

msgid "Existing .mergedlands.toml could not be read"
msgstr "Le .mergedlands.toml existant n'a pas pu être lu"

msgid "%(name)s will be replaced from defaults:\n\n%(err)s"
msgstr "%(name)s sera remplacé par les valeurs par défaut :\n\n%(err)s"

msgid "Merge settings: %(name)s"
msgstr "Paramètres de fusion : %(name)s"

msgid "Choose how %(name)s's landscape edits merge. Uncheck a layer to keep this plugin from touching it; set a strategy for how its edits resolve where they collide with another mod. The defaults behave as if there were no file."
msgstr "Choisissez comment les modifications de paysage de %(name)s fusionnent. Décochez une couche pour empêcher ce plugin d'y toucher ; définissez une stratégie de résolution là où ses modifications entrent en collision avec un autre mod. Les valeurs par défaut se comportent comme s'il n'y avait pas de fichier."

msgid "meta_type:"
msgstr "meta_type :"

msgid "Patch = a hand-written settings file (the usual choice). Auto = default behaviour. MergedLands marks a plugin the tool generated so a re-run ignores it -- do not set that on an ordinary mod."
msgstr "Patch = un fichier de paramètres écrit à la main (le choix habituel). Auto = comportement par défaut. MergedLands marque un plugin généré par l'outil pour qu'une nouvelle exécution l'ignore -- ne le mettez pas sur un mod ordinaire."

msgid "Layers"
msgstr "Couches"

msgid "include"
msgstr "inclure"

msgid "layer"
msgstr "couche"

msgid "conflict strategy"
msgstr "stratégie de conflit"

msgid "Vertex heights -- and the normals stored with them."
msgstr "Hauteurs des sommets -- et les normales stockées avec elles."

msgid "Baked vertex colours (terrain lighting)."
msgstr "Couleurs de sommets précalculées (éclairage du terrain)."

msgid "Which land texture paints each square."
msgstr "Quelle texture de terrain peint chaque carré."

msgid "The low-resolution world-map heightmap."
msgstr "La carte de hauteur basse résolution de la carte du monde."

msgid "Auto = later plugin wins for entries it changed Â· Overwrite = this plugin wins collisions Â· Ignore = keep the earlier edit Â· Resolve = blend conflicting numbers Â· Curvature = structure-weighted blend (ours)."
msgstr "Auto = le plugin ultérieur gagne pour les entrées qu'il a changées · Overwrite = ce plugin gagne les collisions · Ignore = garder la modification antérieure · Resolve = mélanger les nombres en conflit · Curvature = mélange pondéré par la structure (le nôtre)."

msgid "Preview:"
msgstr "Aperçu :"

msgid "Write .mergedlands.toml"
msgstr "Écrire .mergedlands.toml"

msgid "Could not write .mergedlands.toml"
msgstr "Impossible d'écrire .mergedlands.toml"

msgid "Wrote %(name)s."
msgstr "%(name)s écrit."

msgid "Merge settings written"
msgstr "Paramètres de fusion écrits"

msgid "Wrote:\n%(path)s\n\nRun Merge Lands to apply it."
msgstr "Écrit :\n%(path)s\n\nLancez Merge Lands pour l'appliquer."

msgid " CELL MAP"
msgstr " CARTE DES CELLULES"

msgid "native esp reader"
msgstr "lecteur esp natif"

msgid "  %(exterior)d exterior + %(interior)d interior cell(s) touched across %(scanned)d plugin(s)."
msgstr "  %(exterior)d cellule(s) extérieure(s) + %(interior)d intérieure(s) touchées sur %(scanned)d plugin(s)."

msgid "  Map written to: %(path)s"
msgstr "  Carte écrite dans : %(path)s"

msgid "Cell map ready (%(exterior)d exterior, %(interior)d interior)."
msgstr "Carte des cellules prête (%(exterior)d extérieures, %(interior)d intérieures)."

msgid "Open in browser"
msgstr "Ouvrir dans le navigateur"

msgid "(inline render failed -- use 'Open in browser'. The 3D and nav views need a real browser engine.)"
msgstr "(rendu intégré échoué -- utilisez « Ouvrir dans le navigateur ». Les vues 3D et de navigation nécessitent un vrai moteur de navigateur.)"

msgid "Save HTML..."
msgstr "Enregistrer le HTML…"

msgid "(inline render failed - use 'Open in browser' for the full map)"
msgstr "(rendu intégré échoué -- utilisez « Ouvrir dans le navigateur » pour la carte complète)"

msgid "Save cell map"
msgstr "Enregistrer la carte des cellules"

msgid "Cell map saved: %(path)s"
msgstr "Carte des cellules enregistrée : %(path)s"

msgid "If upstream moves or a new fork takes over, point the updaters at the new location here. Blank = built-in defaults. Downloads are always validated before anything is overwritten."
msgstr "Si l'amont déménage ou qu'un nouveau fork prend le relais, pointez les updaters vers le nouvel emplacement ici. Vide = valeurs par défaut intégrées. Les téléchargements sont toujours validés avant que quoi que ce soit ne soit écrasé."

msgid "mlox rules URL template:"
msgstr "Modèle d'URL des règles mlox :"

msgid "Where 'Update Rules...' downloads from. Must contain {name}, which is replaced with mlox_base.txt / mlox_user.txt per file.\nDefault: %(url)s"
msgstr "D'où « Mettre à jour les règles… » télécharge. Doit contenir {name}, remplacé par mlox_base.txt / mlox_user.txt selon le fichier.\nPar défaut : %(url)s"

msgid "default: %(url)s"
msgstr "par défaut : %(url)s"

msgid "plugin-order.yml URL:"
msgstr "URL de plugin-order.yml :"

msgid "Where the plugin-order.yml 'Update...' button downloads from. Blank tries the built-in candidates in order.\nDefault: %(url)s"
msgstr "D'où le bouton « Mettre à jour… » de plugin-order.yml télécharge. Vide essaie les candidats intégrés dans l'ordre.\nPar défaut : %(url)s"

msgid "default: %(url)s..."
msgstr "par défaut : %(url)s…"

msgid "Download sources"
msgstr "Télécharger les sources"

msgid "The rules URL template must contain {name} (it's replaced with the rule filename)."
msgstr "Le modèle d'URL des règles doit contenir {name} (il est remplacé par le nom du fichier de règles)."

msgid "Reset to defaults"
msgstr "Rétablir les valeurs par défaut"

msgid "Save & Close"
msgstr "Enregistrer et fermer"

msgid "New mlox rule"
msgstr "Nouvelle règle mlox"

msgid "rules file:"
msgstr "fichier de règles :"

msgid "Personal rules file the rule is appended to (created with a header if new). Use your OWN file, not mlox_base/mlox_user -- those get overwritten by 'Update Rules...'. It's auto-added to the rule-files list LAST, so your rules win conflicts."
msgstr "Fichier de règles personnel auquel la règle est ajoutée (créé avec un en-tête si nouveau). Utilisez VOTRE propre fichier, pas mlox_base/mlox_user -- ceux-là sont écrasés par « Mettre à jour les règles… ». Il est ajouté automatiquement en DERNIER à la liste des fichiers de règles, pour que vos règles gagnent les conflits."

msgid "Rule type"
msgstr "Type de règle"

msgid "Plugins (order matters for [Order])"
msgstr "Plugins (l'ordre compte pour [Order])"

msgid "From plugin panel"
msgstr "Depuis le panneau des plugins"

msgid "Add the rows currently SELECTED in the main plugin-order panel, in their displayed order (Ctrl/Shift-click there to multi-select first)."
msgstr "Ajouter les lignes actuellement SÉLECTIONNÉES dans le panneau principal d'ordre des plugins, dans leur ordre affiché (Ctrl/Maj-clic pour en sélectionner plusieurs d'abord)."

msgid "Group as ANY"
msgstr "Grouper en ANY"

msgid "Wrap the SELECTED plugins in an [ANY ...] group, for a rule that is satisfied by whichever of several versions someone has installed -- the shape the guidelines use for mods with an XB edition, a Tribunal edition and so on.\n\nSelect the grouped entry and press again to ungroup."
msgstr "Regrouper les plugins SÉLECTIONNÉS dans un groupe [ANY …], pour une règle satisfaite dès qu'une de plusieurs versions est installée -- la forme qu'utilisent les recommandations pour les mods ayant une édition XB, une édition Tribunal, etc.\n\nSélectionnez l'entrée groupée et appuyez de nouveau pour dégrouper."

msgid "Type a plugin filename and press Enter. mlox wildcards are allowed: ? for one character, * for any run, <VER> for a version number -- though the guidelines ask for these to be used sparingly, since expanding them is slow."
msgstr "Saisissez un nom de fichier de plugin et appuyez sur Entrée. Les jokers mlox sont autorisés : ? pour un caractère, * pour toute suite, <VER> pour un numéro de version -- les recommandations demandent toutefois d'en user avec parcimonie, car leur expansion est lente."

msgid "Add"
msgstr "Ajouter"

msgid "Message and source"
msgstr "Message et source"

msgid "message:"
msgstr "message :"

msgid "What to tell the person, and what to do about it. Ordering rules carry no message; the warning rules are much less useful without one.\n\nA message containing ']' is written in the block form automatically, because a ']' would otherwise close the rule label early."
msgstr "Quoi dire à la personne, et quoi faire à ce sujet. Les règles d'ordre ne portent pas de message ; les règles d'avertissement sont bien moins utiles sans.\n\nUn message contenant « ] » est écrit automatiquement en forme de bloc, car un « ] » fermerait sinon l'étiquette de règle trop tôt."

msgid "(Ref:) source:"
msgstr "(Réf. :) source :"

msgid "Where this rule's claim comes from: a readme filename, a forum post, a URL. The guidelines ask for one on every rule so that someone else can check it, or correct it.\n\nA URL gets whitespace before the closing parenthesis automatically -- pages that auto-link URLs otherwise swallow the ')' into the link."
msgstr "D'où vient l'affirmation de cette règle : un nom de fichier readme, un message de forum, une URL. Les recommandations en demandent une sur chaque règle pour que quelqu'un d'autre puisse la vérifier ou la corriger.\n\nUne URL reçoit automatiquement un espace avant la parenthèse fermante -- les pages qui lient automatiquement les URL avalent sinon le « ) » dans le lien."

msgid "@section:"
msgstr "@section :"

msgid "Optional heading written above the rule. The rule-base groups rules into sections, roughly one per mod, to keep the file navigable."
msgstr "En-tête facultatif écrit au-dessus de la règle. La base de règles regroupe les règles en sections, environ une par mod, pour garder le fichier navigable."

msgid "highlight:"
msgstr "surlignage :"

msgid "none"
msgstr "aucun"

msgid "%(mark)s = %(meaning)s"
msgstr "%(mark)s = %(meaning)s"

msgid "; comment:"
msgstr "; commentaire :"

msgid "A ';' comment written above the rule. mlox strips these before reading."
msgstr "Un commentaire « ; » écrit au-dessus de la règle. mlox les retire avant lecture."

msgid "Preview"
msgstr "Aperçu"

msgid "Append rule"
msgstr "Ajouter la règle"

msgid "Write the rule to the file above. Refused while there is an error: mlox silently discards a rule it cannot use, so this is the only place you would find out.\n\nWarnings do not block -- they are the guidelines' advice, not the parser's requirements."
msgstr "Écrire la règle dans le fichier ci-dessus. Refusé tant qu'il y a une erreur : mlox jette silencieusement une règle inutilisable, c'est donc le seul endroit où vous le sauriez.\n\nLes avertissements ne bloquent pas -- ce sont les conseils des recommandations, pas les exigences de l'analyseur."

msgid "Rule guide"
msgstr "Guide des règles"

msgid "Open the rule reference: what each rule kind says, how expressions nest, and the conventions the rule-base follows.\n\nIt opens in your browser, so it can sit beside this window while you work."
msgstr "Ouvrir la référence des règles : ce que dit chaque type de règle, comment les expressions s'imbriquent et les conventions que suit la base de règles.\n\nElle s'ouvre dans votre navigateur, pour rester à côté de cette fenêtre pendant que vous travaillez."

msgid "No problems. This rule follows the guidelines.\n"
msgstr "Aucun problème. Cette règle suit les recommandations.\n"

msgid "Select row(s) in the plugin-order panel first."
msgstr "Sélectionnez d'abord une ou des lignes dans le panneau d'ordre des plugins."

msgid "Personal rules file"
msgstr "Fichier de règles personnel"

msgid "New rule"
msgstr "Nouvelle règle"

msgid "Set a rules file first."
msgstr "Définissez d'abord un fichier de règles."

msgid "Don't append personal rules to mlox_base.txt / mlox_user.txt -- 'Update Rules...' overwrites those. Pick your own file (e.g. mlox_my_rules.txt)."
msgstr "N'ajoutez pas de règles personnelles à mlox_base.txt / mlox_user.txt -- « Mettre à jour les règles… » les écrase. Choisissez votre propre fichier (p. ex. mlox_my_rules.txt)."

msgid "Rule conflicts with the curated order"
msgstr "La règle est en conflit avec l'ordre curé"

msgid "This [Order] rule contradicts the frozen curated (MOMW) order for:\n\n%(pairs)s\n\nmlox will DISCARD those orderings (it never reorders the curated list), so the rule won't take effect for them. Write it anyway?"
msgstr "Cette règle [Order] contredit l'ordre curé (MOMW) figé pour :\n\n%(pairs)s\n\nmlox ÉCARTERA ces ordonnancements (il ne réordonne jamais la liste curée), la règle ne prendra donc pas effet pour eux. L'écrire quand même ?"


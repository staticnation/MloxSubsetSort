msgid "  Inferred anchor for '%(value)s': %(mode)s '%(anchor)s' (via plugin %(via)s)"
msgstr "  Ancora dedotta per «%(value)s»: %(mode)s «%(anchor)s» (tramite il plugin %(via)s)"


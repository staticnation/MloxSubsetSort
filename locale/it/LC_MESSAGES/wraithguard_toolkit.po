msgid "\n[STALE] '%(artifact)s' is older than %(count)d active plugin (e.g. %(examples)s%(more)s) -- re-run momw-configurator so it gets rebuilt against the current load order."
msgid_plural "\n[STALE] '%(artifact)s' is older than %(count)d active plugins (e.g. %(examples)s%(more)s) -- re-run momw-configurator so it gets rebuilt against the current load order."
msgstr[0] "\n[OBSOLETO] «%(artifact)s» è più vecchio di %(count)d plugin attivo (es. %(examples)s%(more)s) -- riesegui momw-configurator così viene ricostruito contro l'ordine di caricamento attuale."
msgstr[1] "\n[OBSOLETO] «%(artifact)s» è più vecchio di %(count)d plugin attivi (es. %(examples)s%(more)s) -- riesegui momw-configurator così viene ricostruito contro l'ordine di caricamento attuale."

msgid "  (excluded %(count)d plugin by --exclude)"
msgid_plural "  (excluded %(count)d plugins by --exclude)"
msgstr[0] "  (%(count)d plugin escluso da --exclude)"
msgstr[1] "  (%(count)d plugin esclusi da --exclude)"

msgid "  Keeping tes3conv JSON dump in: %(path)s"
msgstr "  Conservo l'esportazione JSON di tes3conv in: %(path)s"

msgid "  Engine: %(engine)s"
msgstr "  Motore: %(engine)s"

msgid "native esp reader (field-level)"
msgstr "lettore esp nativo (per campo)"

msgid "\n  Wrote conflict report: %(path)s"
msgstr "\n  Report dei conflitti scritto: %(path)s"

msgid "could not write conflict CSV: %(error)s"
msgstr "impossibile scrivere il CSV dei conflitti: %(error)s"

msgid "  Scanned %(scanned)d plugin(s): %(exterior)d exterior + %(interior)d interior cell(s) touched."
msgstr "  %(scanned)d plugin analizzati: %(exterior)d esterna(e) + %(interior)d interna(e) toccate."

msgid "  Wrote cell map: %(path)s  (open it in a browser)"
msgstr "  Mappa delle celle scritta: %(path)s  (aprila in un browser)"

msgid "could not write cell map: %(error)s"
msgstr "impossibile scrivere la mappa delle celle: %(error)s"

msgid "  Scanned %(scanned)d plugin(s); %(cells)d interior cell(s), %(grids)d interior pathgrid(s)."
msgstr "  %(scanned)d plugin analizzati; %(cells)d cella(e) interna(e), %(grids)d griglia(e) di percorsi interna(e)."

msgid "\n  No lint findings."
msgstr "\n  Nessun rilievo dall'analisi."

msgid "\n  Wrote resource report: %(path)s"
msgstr "\n  Report delle risorse scritto: %(path)s"

msgid "could not write resource CSV: %(error)s"
msgstr "impossibile scrivere il CSV delle risorse: %(error)s"

msgid "  <-- inserted"
msgstr "  <-- inserito"

msgid "UNMANAGED (ORPHAN) ENTRIES FROM openmw.cfg"
msgstr "VOCI NON GESTITE (ORFANE) DA openmw.cfg"

msgid "  %(count)d orphan plugin pulled from openmw.cfg"
msgid_plural "  %(count)d orphan plugins pulled from openmw.cfg"
msgstr[0] "  %(count)d plugin orfano recuperato da openmw.cfg"
msgstr[1] "  %(count)d plugin orfani recuperati da openmw.cfg"

msgid "  No unmanaged plugins found -- every content= plugin in the cfg is on the list or in your customizations."
msgstr "  Nessun plugin non gestito trovato -- ogni plugin content= nella cfg è nella lista o nelle tue personalizzazioni."

msgid "  %(count)d orphan data= path found in openmw.cfg"
msgid_plural "  %(count)d orphan data= paths found in openmw.cfg"
msgstr[0] "  %(count)d percorso data= orfano trovato in openmw.cfg"
msgstr[1] "  %(count)d percorsi data= orfani trovati in openmw.cfg"

msgid "  No unmanaged data= paths found -- every data= path in the cfg is on the '%(list)s' data-path order or in your customizations."
msgstr "  Nessun percorso data= non gestito trovato -- ogni percorso data= della cfg è nell'ordine data= della lista '%(list)s' o nelle tue personalizzazioni."

msgid "  data= paths not classified -- set a data-path-order.yml and list name to surface unmanaged (orphan) data= paths too."
msgstr "  percorsi data= non classificati -- imposta una data-path-order.yml e un nome di lista per mostrare anche i percorsi data= non gestiti (orfani)."

msgid "groundcover declared by this run"
msgstr "groundcover dichiarato da questa esecuzione"

msgid "  These are written as groundcover= rather than content=. Their data= folders are inserted normally -- OpenMW has to find the file."
msgstr "  Questi vengono scritti come groundcover= invece che content=. Le loro cartelle data= vengono inserite normalmente -- OpenMW deve trovare il file."

msgid "groundcover plugins held back"
msgstr "plugin groundcover trattenuti"

msgid "%(count)d plugin in your subset is already declared as groundcover in openmw.cfg, so it was NOT added to content=:"
msgid_plural "%(count)d plugins in your subset are already declared as groundcover in openmw.cfg, so they were NOT added to content=:"
msgstr[0] "%(count)d plugin nel tuo sottoinsieme è già dichiarato come groundcover in openmw.cfg, quindi NON è stato aggiunto a content=:"
msgstr[1] "%(count)d plugin nel tuo sottoinsieme sono già dichiarati come groundcover in openmw.cfg, quindi NON sono stati aggiunti a content=:"

msgid "  Their groundcover= lines are untouched and their data= paths are still written, so the grass stays enabled -- as grass. Loading one as content= too would spawn every blade as a real object."
msgstr "  Le loro righe groundcover= restano intatte e i loro percorsi data= vengono comunque scritti, così l'erba resta abilitata -- come erba. Caricarne uno anche come content= farebbe apparire ogni filo come un oggetto reale."

msgid "  openmw.cfg left untouched (pass --write-cfg to patch it directly)"
msgstr "  openmw.cfg lasciato intatto (passa --write-cfg per applicarvi la patch direttamente)"

msgid "  WARNING: configurator preview failed: %(error)s"
msgstr "  AVVISO: l'anteprima del configuratore è fallita: %(error)s"

msgid "\n  DRY RUN: would write %(path)s\n%(toml)s"
msgstr "\n  SIMULAZIONE: scriverebbe %(path)s\n%(toml)s"

msgid "  Wrote corrected customizations: %(path)s"
msgstr "  Personalizzazioni corrette scritte: %(path)s"

msgid "  Plugins sorted:        %(count)d"
msgstr "  Plugin ordinati:        %(count)d"

msgid "  Data paths inserted:   %(count)d"
msgstr "  Percorsi dati inseriti: %(count)d"

msgid "  Rule warnings raised:  %(count)d"
msgstr "  Avvisi di regole:       %(count)d"

msgid "  plugin-order.yml warnings: %(count)d"
msgstr "  Avvisi di plugin-order.yml: %(count)d"

msgid "  openmw.cfg written:    %(answer)s"
msgstr "  openmw.cfg scritto:     %(answer)s"

msgid "yes"
msgstr "sì"

msgid "no"
msgstr "no"

msgid "  customizations.toml written: %(answer)s"
msgstr "  customizations.toml scritto: %(answer)s"

msgid "Rule files (priority = order below, last = highest -- drag rows to reorder)"
msgstr "File delle regole (priorità = ordine sotto, ultimo = più alta -- trascina le righe per riordinare)"

msgid "mlox rule files (mlox_base.txt, mlox_user.txt, ...), applied in this order.\nLater files can override/extend earlier ones -- put mlox_base.txt first and your own mlox_user.txt last. Drag rows to reorder, or use the buttons."
msgstr "File delle regole mlox (mlox_base.txt, mlox_user.txt, …), applicati in questo ordine.\nI file successivi possono sovrascrivere/estendere i precedenti -- metti mlox_base.txt per primo e il tuo mlox_user.txt per ultimo. Trascina le righe per riordinare, o usa i pulsanti."

msgid "Add File(s)..."
msgstr "Aggiungi file…"

msgid "Browse for one or more mlox rule .txt files to add to the list."
msgstr "Sfoglia per aggiungere uno o più file .txt di regole mlox alla lista."

msgid "Remove Selected"
msgstr "Rimuovi selezione"

msgid "Remove the selected rule file from the list (doesn't delete anything on disk)."
msgstr "Rimuovi il file delle regole selezionato dalla lista (non elimina niente dal disco)."

msgid "Move Up"
msgstr "Sposta su"

msgid "Move the selected rule file earlier (lower priority)."
msgstr "Sposta il file delle regole selezionato prima (priorità inferiore)."

msgid "Move Down"
msgstr "Sposta giù"

msgid "Move the selected rule file later (higher priority)."
msgstr "Sposta il file delle regole selezionato dopo (priorità superiore)."

msgid "New Rule..."
msgstr "Nuova regola…"

msgid "Write your own mlox [Order]/[NearStart]/[NearEnd] rule without knowing the syntax: pick plugins (or grab the selected rows from the plugin panel), preview the rule, and append it to a personal rules file that loads LAST so it wins conflicts. This is how rules for modern mods get made -- consider contributing good ones upstream."
msgstr "Scrivi la tua regola mlox [Order]/[NearStart]/[NearEnd] senza conoscerne la sintassi: scegli plugin (o prendi le righe selezionate dal pannello dei plugin), anteprima la regola, e aggiungila a un file delle regole personale che si carica per ULTIMO così vince i conflitti. È così che nascono le regole dei mod moderni -- valuta di contribuirne di buone a monte."

msgid "Update Rules..."
msgstr "Aggiorna regole…"

msgid "Download the CURRENT mlox_base.txt / mlox_user.txt from the actively maintained rules repo (github.com/%(repo)s -- the same source plox uses, and mlox 1.1+ auto-updates from) over the matching files in this list. The old files are kept as timestamped .bak copies. Files with other names (your personal rules) are never touched. Source URL configurable via Sources..."
msgstr "Scarica i mlox_base.txt / mlox_user.txt ATTUALI dal repository di regole mantenuto attivamente (github.com/%(repo)s -- la stessa fonte che usa plox, e da cui mlox 1.1+ si aggiorna) sopra i file corrispondenti in questa lista. I vecchi file vengono conservati come copie .bak con marca temporale. I file con altri nomi (le tue regole personali) non vengono mai toccati. URL di origine configurabile tramite Origini…"

msgid "Sources..."
msgstr "Origini…"

msgid "Configure WHERE 'Update Rules...' and the plugin-order.yml 'Update...' button download from -- point them at a fork or mirror if upstream moves. Blank fields use the built-in defaults."
msgstr "Configura DA DOVE scaricano «Aggiorna regole…» e il pulsante «Aggiorna…» di plugin-order.yml -- puntali a un fork o mirror se la fonte a monte si sposta. I campi vuoti usano i valori predefiniti integrati."

msgid "(install tkinterdnd2 to drag files in from your file manager)"
msgstr "(installa tkinterdnd2 per trascinare file dal tuo gestore di file)"

msgid "Choose a folder for the mlox rule files"
msgstr "Scegli una cartella per i file delle regole mlox"

msgid "Update rules"
msgstr "Aggiorna regole"

msgid "Download the current mlox rules from github.com/%(repo)s?\n\n%(files)s\n\nThey don't exist yet -- they'll be created here."
msgstr "Scaricare le regole mlox attuali da github.com/%(repo)s?\n\n%(files)s\n\nNon esistono ancora -- verranno create qui."

msgid "Download the current rules from github.com/%(repo)s over these files?\n\n%(age)s\n\nTimestamped .bak copies of the old files are kept."
msgstr "Scaricare le regole attuali da github.com/%(repo)s sopra questi file?\n\n%(age)s\n\nVengono conservate copie .bak con marca temporale dei vecchi file."

msgid "Move the selected row(s) one position earlier. Works with a multi-selection; you can also drag a contiguous block up with the mouse."
msgstr "Sposta la(e) riga(he) selezionata(e) una posizione prima. Funziona con selezione multipla; puoi anche trascinare un blocco contiguo verso l'alto col mouse."

msgid "Move the selected row(s) one position later. Works with a multi-selection; you can also drag a contiguous block down with the mouse."
msgstr "Sposta la(e) riga(he) selezionata(e) una posizione dopo. Funziona con selezione multipla; puoi anche trascinare un blocco contiguo verso il basso col mouse."

msgid "Disable / Enable"
msgstr "Disabilita / Abilita"

msgid "Opt the selected row in or out of the load order. Disabled rows are dimmed and marked, and are left out of Export: a custom item is simply not inserted, and an item already in your openmw.cfg gets a removeContent/removeData entry in the emitted TOML so it's durably removed. Double-click a row to toggle it too."
msgstr "Includi o escludi la riga selezionata dall'ordine di caricamento. Le righe disabilitate vengono attenuate e contrassegnate, ed escluse dall'Export: un elemento personalizzato semplicemente non viene inserito, e un elemento già nel tuo openmw.cfg riceve una voce removeContent/removeData nel TOML emesso così viene rimosso in modo duraturo. Doppio clic su una riga la commuta anche."

msgid "Discard any manual dragging and restore the order from the last Sort (your disable/enable choices are kept)."
msgstr "Scarta qualsiasi trascinamento manuale e ripristina l'ordine dell'ultimo Ordinamento (le tue scelte di abilita/disabilita vengono mantenute)."

msgid "Plugin load order -- drag to override mlox (red = touched by this sort, purple = master problem)"
msgstr "Ordine di caricamento dei plugin -- trascina per scavalcare mlox (rosso = toccato da questo ordinamento, viola = problema di master)"

msgid "Data path order -- drag to adjust (highlighted = your custom paths)"
msgstr "Ordine dei percorsi dati -- trascina per regolare (evidenziato = i tuoi percorsi personalizzati)"

msgid "Drag & drop is unavailable (tkinterdnd2 or its tkdnd library is missing) -- use the Browse buttons below."
msgstr "Il trascina e rilascia non è disponibile (manca tkinterdnd2 o la sua libreria tkdnd) -- usa i pulsanti Sfoglia sotto."

msgid "Required. The openmw.cfg to read the current content= and data= order from, and (if 'Write openmw.cfg directly' is checked) to patch."
msgstr "Obbligatorio. Il openmw.cfg da cui leggere l'ordine content= e data= attuale e (se «Scrivi openmw.cfg direttamente» è spuntato) a cui applicare la patch."

msgid "A momw-configurator/umo customizations TOML to pull the plugin/data-path subset from automatically. Optional if you provide a subset file instead -- provide both and they're combined."
msgstr "Un TOML di personalizzazioni di momw-configurator/umo da cui estrarre automaticamente il sottoinsieme di plugin/percorsi dati. Facoltativo se fornisci invece un file di sottoinsieme -- forniscili entrambi e vengono combinati."

msgid "A plain text file (one plugin filename or data folder path per line, '#' comments allowed) or a minimal TOML with subset=[...]/data=[...]. Combined with --emit-toml, this alone is enough to generate a brand new customizations.toml with no existing one required."
msgstr "Un file di testo semplice (un nome di file di plugin o percorso di cartella dati per riga, commenti «#» consentiti) o un TOML minimo con subset=[...]/data=[...]. Combinato con --emit-toml, questo da solo basta a generare un customizations.toml nuovo senza che ne serva uno esistente."

msgid "Where to write a corrected customizations.toml (sorted insert blocks, re-anchored). Disabled when 'write directly back' below is checked."
msgstr "Dove scrivere un customizations.toml corretto (blocchi di inserimento ordinati, riancorati). Disabilitato quando «riscrivi direttamente» sotto è spuntato."

msgid "list name (optional):"
msgstr "nome della lista (facoltativo):"

msgid "MOMW's plugin-order.yml (source of truth for which plugins belong to which curated list). With the list name above set, curated plugins for that list are excluded from the sort (never reordered) so only your custom additions are touched, and read-only warnings are emitted: redundant, orphan, needs-cleaning, and a base-order drift check. PyYAML used if installed, else a built-in parser."
msgstr "Il plugin-order.yml di MOMW (la fonte di verità su quali plugin appartengono a quale lista curata). Con il nome della lista sopra impostato, i plugin curati di quella lista vengono esclusi dall'ordinamento (mai riordinati) così vengono toccate solo le tue aggiunte personalizzate, e vengono emessi avvisi in sola lettura: ridondante, orfano, needs-cleaning e un controllo di deriva dell'ordine base. PyYAML usato se installato, altrimenti un parser integrato."

msgid "MOMW's data-path-order.yml (the per-list order in which each mod's data directories should be added). Used to build a mod's expected data paths -- its folder is fuzzy-matched by name, then its extra_dirs appended in order. PyYAML used if installed, else a built-in parser."
msgstr "Il data-path-order.yml di MOMW (l'ordine, per lista, in cui aggiungere le cartelle dati di ogni mod). Usato per costruire i percorsi dati attesi di un mod -- la sua cartella viene abbinata per nome in modo approssimativo, poi le sue extra_dirs vengono aggiunte in ordine. Si usa PyYAML se installato, altrimenti un parser integrato."

msgid "Write directly back to customizations.toml (overwrite in place; a .bak-<timestamp> copy is made first unless backups are disabled below)"
msgstr "Riscrivi direttamente in customizations.toml (sovrascrivi sul posto; prima viene creata una copia .bak-<marca temporale> a meno che i backup siano disabilitati sotto)"

msgid "Instead of writing to a separate file above, overwrite the customizations.toml given above in place. A timestamped backup is made first (unless disabled), and you'll get a confirmation prompt before it actually happens."
msgstr "Invece di scrivere in un file separato sopra, sovrascrivi sul posto il customizations.toml indicato sopra. Prima viene creato un backup con marca temporale (a meno che sia disabilitato), e avrai una richiesta di conferma prima che accada davvero."

msgid "Options"
msgstr "Opzioni"

msgid "Dry run (preview only, don't write files)"
msgstr "Simulazione (solo anteprima, non scrive file)"

msgid "When checked, Export shows exactly what it would write without touching any files. Uncheck when you're ready to actually save."
msgstr "Quando è spuntato, l'Export mostra esattamente cosa scriverebbe senza toccare alcun file. Deselezionalo quando sei pronto a salvare davvero."

msgid "Write openmw.cfg directly"
msgstr "Scrivi openmw.cfg direttamente"

msgid "Patch the content=/data= lines in openmw.cfg in place on Export. A .bak-<timestamp> copy is made first unless backups are disabled."
msgstr "Applica la patch alle righe content=/data= di openmw.cfg sul posto all'Export. Prima viene creata una copia .bak-<marca temporale> a meno che i backup siano disabilitati."

msgid "Sort data= paths too"
msgstr "Ordina anche i percorsi data="

msgid "mlox has no concept of data= folder order -- this positions new data= paths using an explicit after/before anchor if you wrote one, or by scanning the folder for plugins and anchoring next to their neighbor in the sorted content= order. Off by default so a plugin-only run can't surprise-reorder data= too. Also required for the data path order panel to populate."
msgstr "mlox non ha un concetto di ordine delle cartelle data= -- questo posiziona i nuovi percorsi data= con un'ancora after/before esplicita se ne hai scritta una, o analizzando la cartella per plugin e ancorandola accanto al loro vicino nell'ordine content= ordinato. Disabilitato per impostazione predefinita così un'esecuzione solo-plugin non riordina data= a sorpresa. Richiesto anche perché il pannello dell'ordine dei percorsi dati si riempia."

msgid "Skip .bak backup of openmw.cfg"
msgstr "Salta il backup .bak di openmw.cfg"

msgid "Skip making a timestamped backup before overwriting openmw.cfg and/or an in-place customizations.toml. Not recommended."
msgstr "Salta la creazione di un backup con marca temporale prima di sovrascrivere openmw.cfg e/o un customizations.toml sul posto. Non consigliato."

msgid "Skip mlox Conflict/Requires/Note warnings"
msgstr "Salta gli avvisi Conflict/Requires/Note di mlox"

msgid "Skip evaluating [Conflict]/[Requires]/[Note] rules against the sorted plugin list. This is purely informational and read-only either way -- it never changes the computed order or what gets written, only whether warnings get printed."
msgstr "Salta la valutazione delle regole [Conflict]/[Requires]/[Note] contro la lista di plugin ordinata. È puramente informativa e in sola lettura in ogni caso -- non cambia mai l'ordine calcolato né ciò che viene scritto, solo se gli avvisi vengono stampati."

msgid "Create subset text document (on Scan)"
msgstr "Crea documento di testo del sottoinsieme (alla Scansione)"

msgid "Controls what 'Scan...' does with its result. Checked: write the scanned list to a .txt subset file you choose, and load it (the file stays on disk for reuse). Unchecked: keep the scanned list in memory just for this session and feed it straight to the sort -- nothing is written to disk."
msgstr "Controlla cosa fa «Scansiona…» del suo risultato. Spuntato: scrivere la lista analizzata in un file di sottoinsieme .txt che scegli, e caricarla (il file resta sul disco per il riuso). Non spuntato: mantenere la lista analizzata in memoria solo per questa sessione e passarla direttamente all'ordinamento -- niente viene scritto sul disco."

msgid "Pull unmanaged (orphan) plugins & data paths from openmw.cfg"
msgstr "Recupera plugin e percorsi dati non gestiti (orfani) da openmw.cfg"

msgid "Also capture what's ALREADY in openmw.cfg that nothing manages -- neither the curated list (plugin-order.yml) nor your customizations.toml -- so it survives the next momw-configurator rebuild. content= plugins are sorted in; their current cfg order is the starting order until the sort repositions them. Base masters (Morrowind/Tribunal/Bloodmoon) are never touched. Works on its own (no subset file needed) or alongside one.\n\ndata= paths are captured too when a data-path-order.yml and list name are set (that yml is how a path the list manages is told from one you added). Unmanaged data= paths are highlighted here and, on Export, written into the customizations.toml as inserts anchored to the curated paths -- they are never reordered in place, since they already sit in the cfg's data= order."
msgstr "Cattura anche ciò che è GIÀ in openmw.cfg e che nulla gestisce -- né la lista curata (plugin-order.yml) né la tua customizations.toml -- così sopravvive alla prossima ricostruzione di momw-configurator. I plugin content= vengono ordinati; il loro ordine attuale nella cfg è quello di partenza finché l'ordinamento non li riposiziona. I master di base (Morrowind/Tribunal/Bloodmoon) non vengono mai toccati. Funziona da solo (nessun file di sottoinsieme necessario) o insieme a uno.\n\nAnche i percorsi data= vengono catturati quando sono impostati una data-path-order.yml e un nome di lista (quel yml è ciò che distingue un percorso gestito dalla lista da uno aggiunto da te). I percorsi data= non gestiti sono evidenziati qui e, all'esportazione, scritti nella customizations.toml come insert ancorati ai percorsi curati -- non vengono mai riordinati sul posto, poiché sono già nell'ordine data= della cfg."

msgid "Exclude from conflict / cell scans:"
msgstr "Escludi dalle analisi di conflitti / celle:"

msgid "Declare as groundcover:"
msgstr "Dichiara come groundcover:"

msgid "Keep tes3conv JSON dump"
msgstr "Conserva l'esportazione JSON di tes3conv"

msgid "Tidy old HTML views"
msgstr "Pulisci le vecchie viste HTML"

msgid "Every conflict map, terrain view and path grid is written to its own timestamped file so you can compare two of them side by side -- which means they pile up, and one map can be several megabytes.\n\nChecked: on exit, the newest 3 of each kind are kept and older ones removed (with their data folders). Only files this tool generated are ever touched -- never anything you saved yourself with a name of your own choosing.\n\nUnchecked: nothing is ever deleted."
msgstr "Ogni mappa dei conflitti, vista del terreno e griglia dei percorsi viene scritta in un proprio file con marca temporale così puoi confrontarne due affiancate -- il che significa che si accumulano, e una mappa può essere di diversi megabyte.\n\nSpuntato: all'uscita, vengono mantenuti i 3 più recenti di ogni tipo e quelli più vecchi rimossi (con le loro cartelle dati). Vengono toccati solo i file generati da questo strumento -- mai qualcosa che hai salvato tu con un nome a tua scelta.\n\nNon spuntato: niente viene mai eliminato."

msgid "tes3conv conversions are written to disk (not held in RAM) and read per-plugin, so big load orders don't blow up memory. They always go to a 'tes3conv_json' folder next to the app and are reused within a run -- so Check Conflicts then Cell Map won't re-run tes3conv (a plugin is only re-converted if it changed). This box just decides what happens on exit: checked = keep that folder (reused next launch too); unchecked = delete it when you close the app."
msgstr "Le conversioni di tes3conv vengono scritte su disco (non tenute in RAM) e lette per plugin, così gli ordini di caricamento grandi non fanno esplodere la memoria. Vanno sempre in una cartella «tes3conv_json» accanto all'app e vengono riusate all'interno di un'esecuzione -- così Controlla conflitti e poi Mappa delle celle non rieseguono tes3conv (un plugin viene riconvertito solo se è cambiato). Questa casella decide solo cosa succede all'uscita: spuntato = mantenere quella cartella (riusata anche al prossimo avvio); non spuntato = eliminarla alla chiusura dell'app."

msgid "Verbose Merged Lands log"
msgstr "Registro dettagliato di Merged Lands"

msgid "Checked: a Merge Lands run also names every plugin that carries a .mergedlands.toml and exactly what it sets (per layer: on/off and the conflict strategy), and lists every plugin it could not read -- rather than the headline counts. For working out why a merge did what it did.\n\nUnchecked: the normal summary log."
msgstr "Spuntato: un'esecuzione di Merge Lands nomina anche ogni plugin che porta un .mergedlands.toml ed esattamente cosa imposta (per livello: attivo/disattivo e la strategia di conflitto), ed elenca ogni plugin che non è riuscito a leggere -- invece dei conteggi principali. Per capire perché un'unione ha fatto ciò che ha fatto.\n\nNon spuntato: il normale registro di riepilogo."

msgid "Log"
msgstr "Registro"

msgid "Full output from the last Sort and/or Export. Color key: green = a plugin/path this sort inserted or moved, orange = a heads-up (mlox warning, or a rule your curated cfg order overrode), blue = a section header, bright red = an error worth checking. Plain text = frozen base rows left untouched. Colors follow the syntax highlighting theme picked below."
msgstr "Output completo dell'ultimo Ordinamento e/o Export. Legenda dei colori: verde = un plugin/percorso che questo ordinamento ha inserito o spostato, arancione = un avviso (di mlox, o una regola che il tuo ordine cfg curato ha scavalcato), blu = un'intestazione di sezione, rosso acceso = un errore da controllare. Testo semplice = righe base congelate, lasciate intatte. I colori seguono il tema di evidenziazione sintassi scelto sotto."

msgid "Clear Log"
msgstr "Svuota il registro"

msgid "Clear the log panel. Doesn't affect the order panels or any files."
msgstr "Svuota il pannello del registro. Non influisce né sui pannelli dell'ordine né su alcun file."

msgid "Save Log As..."
msgstr "Salva il registro come…"

msgid "Save the current log contents to a text file."
msgstr "Salva il contenuto attuale del registro in un file di testo."

msgid "Theme:"
msgstr "Tema:"

msgid "Color theme for the whole GUI: window/button colors, syntax highlighting here in the Log panel, and the field-diff JSON viewer (Check Conflicts -> double-click a field). Switching re-themes everything immediately, including any windows already open. Built-in: Dracula, Monokai, Atom One Dark, Gruvbox Dark, plus anything you've imported."
msgstr "Tema di colore per l'intera interfaccia: colori di finestre/pulsanti, evidenziazione sintassi qui nel pannello del Registro, e il visualizzatore JSON delle differenze di campo (Controlla conflitti -> doppio clic su un campo). Cambiarlo ri-tematizza tutto all'istante, incluse le finestre già aperte. Integrati: Dracula, Monokai, Atom One Dark, Gruvbox Dark, più ciò che hai importato."

msgid "Import Theme..."
msgstr "Importa tema…"

msgid "Import a custom theme from a JSON file (background/foreground/select/section/warn/error/ok/inserted/dim as hex colors, plus an optional \"chrome\" object for explicit window/button colors) or a base16 scheme file (.yaml/.yml/.json with base00..base0F -- e.g. from the atelierbram/syntax-highlighting or chriskempson/base16 scheme repos). Window colors not given explicitly are derived from the background. Imported themes are saved and appear in the dropdown from then on."
msgstr "Importa un tema personalizzato da un file JSON (background/foreground/select/section/warn/error/ok/inserted/dim come colori hex, più un oggetto «chrome» facoltativo per colori di finestra/pulsante espliciti) o un file di schema base16 (.yaml/.yml/.json con base00..base0F -- es. dai repo atelierbram/syntax-highlighting o chriskempson/base16). I colori di finestra non dati esplicitamente vengono derivati dallo sfondo. I temi importati vengono salvati e appaiono da allora nel menu a discesa."

msgid "Clear Memory"
msgstr "Svuota la memoria"

msgid "Forget every plugin/folder added by hand (drag-drop or the Add buttons) and any scan result held only in memory (not saved to a .txt) -- none of that is shown anywhere on screen, and it otherwise keeps accumulating for the rest of the session. Does not touch any files."
msgstr "Dimentica ogni plugin/cartella aggiunto a mano (trascina-rilascia o i pulsanti Aggiungi) e qualsiasi risultato di analisi tenuto solo in memoria (non salvato in un .txt) -- niente di ciò è mostrato sullo schermo, e altrimenti si accumula per il resto della sessione. Non tocca alcun file."

msgid "Help"
msgstr "Aiuto"

msgid "Open the program's own documentation -- the Quick start (what to click, in order) or the Read me (every option, in detail) -- rendered as a readable page with a contents sidebar. Works offline; nothing is downloaded."
msgstr "Apri la documentazione propria del programma -- l'Avvio rapido (cosa cliccare, in ordine) o il Leggimi (ogni opzione in dettaglio) -- resa come una pagina leggibile con una barra laterale dei contenuti. Funziona offline; niente viene scaricato."

msgid "Log syntax highlighting: %(name)s"
msgstr "Evidenziazione sintassi del registro: %(name)s"

msgid "Import syntax highlighting theme"
msgstr "Importa tema di evidenziazione sintassi"

msgid "Import failed"
msgstr "Importazione non riuscita"

msgid "Couldn't import that theme:\n\n%(error)s"
msgstr "Impossibile importare quel tema:\n\n%(error)s"

msgid "Imported and applied theme: %(name)s"
msgstr "Tema importato e applicato: %(name)s"

msgid "Theme imported"
msgstr "Tema importato"

msgid "Imported \"%(name)s\" and set it as the active log theme."
msgstr "«%(name)s» importato e impostato come tema attivo del registro."

msgid "Missing input"
msgstr "Input mancante"

msgid "Select the mods folder to scan"
msgstr "Seleziona la cartella dei mod da analizzare"

msgid "Save generated subset file as"
msgstr "Salva il file di sottoinsieme generato come"

msgid "Scanning mods folder..."
msgstr "Analisi della cartella dei mod…"

msgid "Scan complete -- %(folders)d folder(s), %(plugins)d plugin(s). Subset file loaded."
msgstr "Scansione completa -- %(folders)d cartella(e), %(plugins)d plugin. File di sottoinsieme caricato."

msgid "Scan complete -- %(folders)d folder(s), %(plugins)d plugin(s). Held in memory (no file written)."
msgstr "Scansione completa -- %(folders)d cartella(e), %(plugins)d plugin. Tenuto in memoria (nessun file scritto)."

msgid "Add plugin..."
msgstr "Aggiungi plugin…"

msgid "Include a plugin the Scan missed -- e.g. one sitting outside a recognised mod folder. It joins your custom subset on the next Sort. You can also drag a plugin file onto the list above from your file manager."
msgstr "Includi un plugin che la Scansione ha mancato -- es. uno fuori da una cartella di mod riconosciuta. Si unisce al tuo sottoinsieme personalizzato al prossimo Ordinamento. Puoi anche trascinare un file di plugin sulla lista sopra dal tuo gestore di file."

msgid "(install tkinterdnd2 to drag a plugin in)"
msgstr "(installa tkinterdnd2 per trascinare un plugin)"

msgid "Add data folder..."
msgstr "Aggiungi cartella dati…"

msgid "Include a folder the Scan missed -- e.g. an OpenMW Lua mod with a non-standard layout (no meshes/textures/... folder and no plugin). It joins your data paths on the next Sort; tick 'Sort data= paths too' to place it in the load order. You can also drag a folder onto the list above from your file manager."
msgstr "Includi una cartella che la Scansione ha mancato -- es. un mod Lua di OpenMW con una struttura non standard (nessuna cartella meshes/textures/… e nessun plugin). Si unisce ai tuoi percorsi dati al prossimo Ordinamento; spunta «Ordina anche i percorsi data=» per collocarla nell'ordine di caricamento. Puoi anche trascinare una cartella sulla lista sopra dal tuo gestore di file."

msgid "(install tkinterdnd2 to drag a folder in)"
msgstr "(installa tkinterdnd2 per trascinare una cartella)"

msgid "Select a data folder to add"
msgstr "Seleziona una cartella dati da aggiungere"

msgid "Select plugin(s) to add"
msgstr "Seleziona i plugin da aggiungere"

msgid "Plugins"
msgstr "Plugin"

msgid "Added plugin"
msgstr "Plugin aggiunto"

msgid "Already added"
msgstr "Già aggiunto"

msgid "Added data folder"
msgstr "Cartella dati aggiunta"

msgid "  Tick 'Sort data= paths too' to place it."
msgstr "  Spunta «Ordina anche i percorsi data=» per collocarla."

msgid "Not a plugin or folder: %(path)s"
msgstr "Non è un plugin né una cartella: %(path)s"

msgid "Nothing to clear."
msgstr "Niente da svuotare."

msgid "%(n)d manual plugin(s)"
msgstr "%(n)d plugin manuale(i)"

msgid "%(n)d manual data folder(s)"
msgstr "%(n)d cartella(e) dati manuale(i)"

msgid "the in-memory scan result"
msgstr "il risultato di analisi in memoria"

msgid "Clear memory?"
msgstr "Svuotare la memoria?"

msgid "This forgets everything added by hand this session and any scan result held in memory (not written to a subset file):\n\n%(summary)s\n\nThey will no longer be included on the next Sort. This does not touch the subset file field, remembered paths, or any file on disk. Continue?"
msgstr "Questo dimentica tutto ciò che è stato aggiunto a mano in questa sessione e qualsiasi risultato di analisi tenuto in memoria (non scritto in un file di sottoinsieme):\n\n%(summary)s\n\nNon verranno più inclusi al prossimo Ordinamento. Questo non tocca né il campo del file di sottoinsieme, né i percorsi ricordati, né alcun file sul disco. Continuare?"

msgid "Cleared: %(summary)s"
msgstr "Svuotato: %(summary)s"

msgid "%(what)s (%(n)d added, applied on Sort): %(value)s"
msgstr "%(what)s (%(n)d aggiunti, applicati all'Ordinamento): %(value)s"

msgid "Sorting..."
msgstr "Ordinamento…"

msgid ", %(count)d yml warning(s)"
msgstr ", %(count)d avviso(i) yml"

msgid "Sorted %(plugins)d plugin(s), %(warnings)d rule warning(s)%(yml)s. Drag to adjust, then Export."
msgstr "%(plugins)d plugin ordinati, %(warnings)d avviso(i) di regole%(yml)s. Trascina per regolare, poi Esporta."

msgid "openmw.cfg changed"
msgstr "openmw.cfg cambiato"

msgid "openmw.cfg has changed on disk since you ran '1. Sort' (did momw-configurator re-run?).\n\nThe order on screen was computed against the OLD contents. It's safer to re-Sort first.\n\nExport anyway?"
msgstr "openmw.cfg è cambiato sul disco da quando hai eseguito «1. Ordina» (momw-configurator è stato rieseguito?).\n\nL'ordine sullo schermo è stato calcolato contro il contenuto VECCHIO. È più sicuro ri-Ordinare prima.\n\nEsportare comunque?"

msgid "Overwrite customizations.toml?"
msgstr "Sovrascrivere customizations.toml?"

msgid "This will overwrite:\n%(path)s\n\nin place%(note)s. Continue?"
msgstr "Questo sovrascriverà:\n%(path)s\n\nsul posto%(note)s. Continuare?"

msgid "Exporting..."
msgstr "Esportazione…"

msgid "Export done -- cfg written: %(cfg)s, toml written: %(toml)s."
msgstr "Export fatto -- cfg scritto: %(cfg)s, toml scritto: %(toml)s."

msgid "Building cell map..."
msgstr "Costruzione della mappa delle celle…"

msgid "\n\nThis REPLACES the existing %(name)s."
msgstr "\n\nQuesto SOSTITUISCE il %(name)s esistente."

msgid "Build Merged Lands.esp?"
msgstr "Costruire Merged Lands.esp?"

msgid "A new plugin will be written to:\n%(path)s\n\nIt carries terrain only -- no references, objects or scripts -- so everything placed in those cells stays where it is. Your mods are NOT modified, and deleting the merged plugin restores your previous behaviour completely.\n\nLoad it LAST, and back up your saves before playing with it the first time.%(existing)s\n\nYes: write it here.   No: choose a different folder."
msgstr "Un nuovo plugin verrà scritto in:\n%(path)s\n\nPorta solo terreno -- nessun riferimento, oggetto o script -- così tutto ciò che è collocato in quelle celle resta dov'è. I tuoi mod NON vengono modificati, ed eliminare il plugin unito ripristina completamente il tuo comportamento precedente.\n\nCaricalo per ULTIMO, e fai il backup dei salvataggi prima di giocarci la prima volta.%(existing)s\n\nSì: scriverlo qui.   No: scegliere un'altra cartella."

msgid "Merging land..."
msgstr "Unione del terreno…"

msgid "Folder not found"
msgstr "Cartella non trovata"

msgid "%(path)s no longer exists. Please choose where to write."
msgstr "%(path)s non esiste più. Scegli dove scrivere."

msgid "Data Files not found"
msgstr "Data Files non trovato"

msgid "Could not work out which folder holds your plugins, so there is no sensible place to put the merged plugin. Use 'Merged Lands folder...' to choose one."
msgstr "Impossibile capire quale cartella contiene i tuoi plugin, quindi non c'è un posto sensato per il plugin unito. Usa «Cartella di Merged Lands…» per sceglierne uno."

msgid "Where should Merged Lands.esp be written?"
msgstr "Dove va scritto Merged Lands.esp?"

msgid "Not a data folder"
msgstr "Non è una cartella dati"

msgid "%(path)s is not one of the folders OpenMW reads, so it will not find the merged plugin there.\n\nAdd this line to openmw.cfg:\n\ndata=\"%(path)s\"\n\nand put 'content=%(name)s' last."
msgstr "%(path)s non è una delle cartelle che OpenMW legge, quindi non vi troverà il plugin unito.\n\nAggiungi questa riga a openmw.cfg:\n\ndata=\"%(path)s\"\n\ne metti «content=%(name)s» per ultimo."

msgid " MERGE LANDS"
msgstr " UNIONE DEI TERRENI"

msgid "Merge produced nothing to write."
msgstr "L'unione non ha prodotto niente da scrivere."

msgid "Merged Lands written: %(cells)d cell(s)."
msgstr "Merged Lands scritto: %(cells)d cella(e)."

msgid "Merge failed -- see log."
msgstr "Unione non riuscita -- vedi il registro."

msgid "%(contested)d vertex/vertices were edited by more than one mod; the later one in your load order won each."
msgstr "%(contested)d vertice(i) sono stati modificati da più di un mod; quello più recente nel tuo ordine di caricamento ha vinto ciascuno."

msgid "%(major)d were blended far from a mod's intent where a .mergedlands.toml asked to Resolve."
msgstr "%(major)d sono stati fusi lontano dall'intento di un mod dove un .mergedlands.toml chiedeva Resolve."

msgid "Merged Lands built"
msgstr "Merged Lands costruito"

msgid "Written to:\n%(path)s\n\nEnable it and place it LAST in your load order.\n\n%(cells)d land record(s), %(textures)d land texture(s).\n%(detail)s"
msgstr "Scritto in:\n%(path)s\n\nAbilitalo e mettilo per ULTIMO nel tuo ordine di caricamento.\n\n%(cells)d record di terreno, %(textures)d texture di terreno.\n%(detail)s"

msgid "Pick a plugin to write a .mergedlands.toml for"
msgstr "Scegli un plugin per cui scrivere un .mergedlands.toml"

msgid "Morrowind plugins"
msgstr "Plugin di Morrowind"

msgid "Existing .mergedlands.toml could not be read"
msgstr "Impossibile leggere il .mergedlands.toml esistente"

msgid "%(name)s will be replaced from defaults:\n\n%(err)s"
msgstr "%(name)s verrà sostituito dai valori predefiniti:\n\n%(err)s"

msgid "Merge settings: %(name)s"
msgstr "Impostazioni di unione: %(name)s"

msgid "Choose how %(name)s's landscape edits merge. Uncheck a layer to keep this plugin from touching it; set a strategy for how its edits resolve where they collide with another mod. The defaults behave as if there were no file."
msgstr "Scegli come si uniscono le modifiche al paesaggio di %(name)s. Deseleziona un livello per impedire a questo plugin di toccarlo; imposta una strategia per come si risolvono le sue modifiche dove collidono con un altro mod. I valori predefiniti si comportano come se non ci fosse alcun file."

msgid "meta_type:"
msgstr "meta_type:"

msgid "Patch = a hand-written settings file (the usual choice). Auto = default behaviour. MergedLands marks a plugin the tool generated so a re-run ignores it -- do not set that on an ordinary mod."
msgstr "Patch = un file di impostazioni scritto a mano (la scelta abituale). Auto = comportamento predefinito. MergedLands contrassegna un plugin generato dallo strumento così una riesecuzione lo ignora -- non impostarlo su un mod ordinario."

msgid "Layers"
msgstr "Livelli"

msgid "include"
msgstr "includi"

msgid "layer"
msgstr "livello"

msgid "conflict strategy"
msgstr "strategia di conflitto"

msgid "Vertex heights -- and the normals stored with them."
msgstr "Altezze dei vertici -- e le normali memorizzate con esse."

msgid "Baked vertex colours (terrain lighting)."
msgstr "Colori dei vertici precalcolati (illuminazione del terreno)."

msgid "Which land texture paints each square."
msgstr "Quale texture di terreno dipinge ogni quadrato."

msgid "The low-resolution world-map heightmap."
msgstr "La mappa delle altezze a bassa risoluzione della mappa del mondo."

msgid "Auto = later plugin wins for entries it changed Â· Overwrite = this plugin wins collisions Â· Ignore = keep the earlier edit Â· Resolve = blend conflicting numbers Â· Curvature = structure-weighted blend (ours)."
msgstr "Auto = il plugin successivo vince per le voci che ha cambiato · Overwrite = questo plugin vince le collisioni · Ignore = mantieni la modifica precedente · Resolve = fondi i numeri in conflitto · Curvature = fusione pesata sulla struttura (la nostra)."

msgid "Preview:"
msgstr "Anteprima:"

msgid "Write .mergedlands.toml"
msgstr "Scrivi .mergedlands.toml"

msgid "Could not write .mergedlands.toml"
msgstr "Impossibile scrivere .mergedlands.toml"

msgid "Wrote %(name)s."
msgstr "%(name)s scritto."

msgid "Merge settings written"
msgstr "Impostazioni di unione scritte"

msgid "Wrote:\n%(path)s\n\nRun Merge Lands to apply it."
msgstr "Scritto:\n%(path)s\n\nEsegui Merge Lands per applicarlo."

msgid " CELL MAP"
msgstr " MAPPA DELLE CELLE"

msgid "native esp reader"
msgstr "lettore esp nativo"

msgid "  %(exterior)d exterior + %(interior)d interior cell(s) touched across %(scanned)d plugin(s)."
msgstr "  %(exterior)d cella(e) esterna(e) + %(interior)d interna(e) toccate su %(scanned)d plugin."

msgid "  Map written to: %(path)s"
msgstr "  Mappa scritta in: %(path)s"

msgid "Cell map ready (%(exterior)d exterior, %(interior)d interior)."
msgstr "Mappa delle celle pronta (%(exterior)d esterne, %(interior)d interne)."

msgid "Open in browser"
msgstr "Apri nel browser"

msgid "(inline render failed -- use 'Open in browser'. The 3D and nav views need a real browser engine.)"
msgstr "(il rendering in linea è fallito -- usa «Apri nel browser». Le viste 3D e di navigazione richiedono un vero motore di browser.)"

msgid "Save HTML..."
msgstr "Salva HTML…"

msgid "(inline render failed - use 'Open in browser' for the full map)"
msgstr "(il rendering in linea è fallito -- usa «Apri nel browser» per la mappa completa)"

msgid "Save cell map"
msgstr "Salva mappa delle celle"

msgid "Cell map saved: %(path)s"
msgstr "Mappa delle celle salvata: %(path)s"

msgid "If upstream moves or a new fork takes over, point the updaters at the new location here. Blank = built-in defaults. Downloads are always validated before anything is overwritten."
msgstr "Se la fonte a monte si sposta o un nuovo fork prende il sopravvento, punta gli aggiornatori alla nuova posizione qui. Vuoto = valori predefiniti integrati. I download vengono sempre validati prima di sovrascrivere qualcosa."

msgid "mlox rules URL template:"
msgstr "Modello di URL delle regole mlox:"

msgid "Where 'Update Rules...' downloads from. Must contain {name}, which is replaced with mlox_base.txt / mlox_user.txt per file.\nDefault: %(url)s"
msgstr "Da dove scarica «Aggiorna regole…». Deve contenere {name}, che viene sostituito con mlox_base.txt / mlox_user.txt per file.\nPredefinito: %(url)s"

msgid "default: %(url)s"
msgstr "predefinito: %(url)s"

msgid "plugin-order.yml URL:"
msgstr "URL di plugin-order.yml:"

msgid "Where the plugin-order.yml 'Update...' button downloads from. Blank tries the built-in candidates in order.\nDefault: %(url)s"
msgstr "Da dove scarica il pulsante «Aggiorna…» di plugin-order.yml. Vuoto prova i candidati integrati in ordine.\nPredefinito: %(url)s"

msgid "default: %(url)s..."
msgstr "predefinito: %(url)s…"

msgid "Download sources"
msgstr "Scarica origini"

msgid "The rules URL template must contain {name} (it's replaced with the rule filename)."
msgstr "Il modello di URL delle regole deve contenere {name} (viene sostituito con il nome del file delle regole)."

msgid "Reset to defaults"
msgstr "Ripristina valori predefiniti"

msgid "Save & Close"
msgstr "Salva e chiudi"

msgid "New mlox rule"
msgstr "Nuova regola mlox"

msgid "rules file:"
msgstr "file delle regole:"

msgid "Personal rules file the rule is appended to (created with a header if new). Use your OWN file, not mlox_base/mlox_user -- those get overwritten by 'Update Rules...'. It's auto-added to the rule-files list LAST, so your rules win conflicts."
msgstr "File delle regole personale a cui la regola viene aggiunta (creato con un'intestazione se nuovo). Usa il TUO file, non mlox_base/mlox_user -- quelli vengono sovrascritti da «Aggiorna regole…». Viene aggiunto automaticamente per ULTIMO alla lista dei file delle regole, così le tue regole vincono i conflitti."

msgid "Rule type"
msgstr "Tipo di regola"

msgid "Plugins (order matters for [Order])"
msgstr "Plugin (l'ordine conta per [Order])"

msgid "From plugin panel"
msgstr "Dal pannello dei plugin"

msgid "Add the rows currently SELECTED in the main plugin-order panel, in their displayed order (Ctrl/Shift-click there to multi-select first)."
msgstr "Aggiungi le righe attualmente SELEZIONATE nel pannello principale dell'ordine dei plugin, nel loro ordine visualizzato (Ctrl/Maiusc-clic per selezionarne più d'una prima)."

msgid "Group as ANY"
msgstr "Raggruppa come ANY"

msgid "Wrap the SELECTED plugins in an [ANY ...] group, for a rule that is satisfied by whichever of several versions someone has installed -- the shape the guidelines use for mods with an XB edition, a Tribunal edition and so on.\n\nSelect the grouped entry and press again to ungroup."
msgstr "Racchiudi i plugin SELEZIONATI in un gruppo [ANY …], per una regola soddisfatta da una qualsiasi di più versioni installate -- la forma che le linee guida usano per mod con edizione XB, edizione Tribunal, ecc.\n\nSeleziona la voce raggruppata e premi di nuovo per separare."

msgid "Type a plugin filename and press Enter. mlox wildcards are allowed: ? for one character, * for any run, <VER> for a version number -- though the guidelines ask for these to be used sparingly, since expanding them is slow."
msgstr "Digita un nome di file di plugin e premi Invio. I caratteri jolly mlox sono consentiti: ? per un carattere, * per qualsiasi sequenza, <VER> per un numero di versione -- anche se le linee guida chiedono di usarli con parsimonia, poiché espanderli è lento."

msgid "Add"
msgstr "Aggiungi"

msgid "Message and source"
msgstr "Messaggio e origine"

msgid "message:"
msgstr "messaggio:"

msgid "What to tell the person, and what to do about it. Ordering rules carry no message; the warning rules are much less useful without one.\n\nA message containing ']' is written in the block form automatically, because a ']' would otherwise close the rule label early."
msgstr "Cosa dire alla persona, e cosa farne. Le regole di ordine non portano un messaggio; le regole di avviso sono molto meno utili senza uno.\n\nUn messaggio che contiene «]» viene scritto automaticamente in forma di blocco, perché un «]» chiuderebbe altrimenti l'etichetta della regola troppo presto."

msgid "(Ref:) source:"
msgstr "(Rif.:) origine:"

msgid "Where this rule's claim comes from: a readme filename, a forum post, a URL. The guidelines ask for one on every rule so that someone else can check it, or correct it.\n\nA URL gets whitespace before the closing parenthesis automatically -- pages that auto-link URLs otherwise swallow the ')' into the link."
msgstr "Da dove viene l'affermazione di questa regola: un nome di file readme, un post di forum, un URL. Le linee guida ne chiedono uno su ogni regola così che qualcun altro possa verificarla, o correggerla.\n\nUn URL riceve automaticamente uno spazio prima della parentesi di chiusura -- le pagine che collegano automaticamente gli URL inghiottono altrimenti il «)» nel collegamento."

msgid "@section:"
msgstr "@section:"

msgid "Optional heading written above the rule. The rule-base groups rules into sections, roughly one per mod, to keep the file navigable."
msgstr "Intestazione facoltativa scritta sopra la regola. La base delle regole raggruppa le regole in sezioni, circa una per mod, per mantenere il file navigabile."

msgid "highlight:"
msgstr "evidenziazione:"

msgid "none"
msgstr "nessuno"

msgid "%(mark)s = %(meaning)s"
msgstr "%(mark)s = %(meaning)s"

msgid "; comment:"
msgstr "; commento:"

msgid "A ';' comment written above the rule. mlox strips these before reading."
msgstr "Un commento «;» scritto sopra la regola. mlox li rimuove prima della lettura."

msgid "Preview"
msgstr "Anteprima"

msgid "Append rule"
msgstr "Aggiungi la regola"

msgid "Write the rule to the file above. Refused while there is an error: mlox silently discards a rule it cannot use, so this is the only place you would find out.\n\nWarnings do not block -- they are the guidelines' advice, not the parser's requirements."
msgstr "Scrivi la regola nel file sopra. Rifiutato finché c'è un errore: mlox scarta silenziosamente una regola che non può usare, quindi questo è l'unico posto dove lo scopriresti.\n\nGli avvisi non bloccano -- sono il consiglio delle linee guida, non i requisiti del parser."

msgid "Rule guide"
msgstr "Guida alle regole"

msgid "Open the rule reference: what each rule kind says, how expressions nest, and the conventions the rule-base follows.\n\nIt opens in your browser, so it can sit beside this window while you work."
msgstr "Apri il riferimento delle regole: cosa dice ogni tipo di regola, come si annidano le espressioni e le convenzioni che la base delle regole segue.\n\nSi apre nel tuo browser, così può stare accanto a questa finestra mentre lavori."

msgid "No problems. This rule follows the guidelines.\n"
msgstr "Nessun problema. Questa regola segue le linee guida.\n"

msgid "Select row(s) in the plugin-order panel first."
msgstr "Seleziona prima una o più righe nel pannello dell'ordine dei plugin."

msgid "Personal rules file"
msgstr "File delle regole personale"

msgid "New rule"
msgstr "Nuova regola"

msgid "Set a rules file first."
msgstr "Imposta prima un file delle regole."

msgid "Don't append personal rules to mlox_base.txt / mlox_user.txt -- 'Update Rules...' overwrites those. Pick your own file (e.g. mlox_my_rules.txt)."
msgstr "Non aggiungere regole personali a mlox_base.txt / mlox_user.txt -- «Aggiorna regole…» le sovrascrive. Scegli il tuo file (es. mlox_my_rules.txt)."

msgid "Rule conflicts with the curated order"
msgstr "La regola è in conflitto con l'ordine curato"

msgid "This [Order] rule contradicts the frozen curated (MOMW) order for:\n\n%(pairs)s\n\nmlox will DISCARD those orderings (it never reorders the curated list), so the rule won't take effect for them. Write it anyway?"
msgstr "Questa regola [Order] contraddice l'ordine curato (MOMW) congelato per:\n\n%(pairs)s\n\nmlox SCARTERÀ quegli ordinamenti (non riordina mai la lista curata), quindi la regola non avrà effetto per essi. Scriverla comunque?"

msgid "Rule appended to %(file)s. Re-run '1. Sort' to apply it."
msgstr "Regola aggiunta a %(file)s. Riesegui «1. Ordina» per applicarla."

msgid "Update %(name)s"
msgstr "Aggiorna %(name)s"

msgid "Save %(name)s as"
msgstr "Salva %(name)s come"

msgid "the file doesn't exist yet -- it will be created"
msgstr "il file non esiste ancora -- verrà creato"

msgid "your copy is ~%(days)d day(s) old"
msgstr "la tua copia ha ~%(days)d giorno(i)"

msgid "Download the current %(name)s from MOMW?\n\n%(age)s.\n\nThe download is validated before anything is written; a timestamped .bak of the old file is kept."
msgstr "Scaricare il %(name)s attuale da MOMW?\n\n%(age)s.\n\nIl download viene validato prima di scrivere qualcosa; viene conservata una .bak con marca temporale del vecchio file."

msgid "Downloading %(name)s..."
msgstr "Download di %(name)s…"

msgid "Run '1. Sort' first so there's a load order to check against."
msgstr "Esegui prima «1. Ordina» così c'è un ordine di caricamento con cui confrontare."

msgid "Choose an OpenMW save"
msgstr "Scegli un salvataggio di OpenMW"

msgid "Save check failed: %(error)s"
msgstr "Controllo del salvataggio fallito: %(error)s"

msgid "Save check: %(count)d missing dependency! See the log."
msgid_plural "Save check: %(count)d missing dependencies! See the log."
msgstr[0] "Controllo del salvataggio: %(count)d dipendenza mancante! Vedi il registro."
msgstr[1] "Controllo del salvataggio: %(count)d dipendenze mancanti! Vedi il registro."

msgid "Save Check"
msgstr "Controllo salvataggio"

msgid "Save check: all %(count)d dependencies present."
msgstr "Controllo del salvataggio: tutte le %(count)d dipendenze presenti."

msgid "%(file)s: all %(count)d content files it needs are in the current load order. Safe to export."
msgstr "%(file)s: tutti i %(count)d file di contenuto di cui ha bisogno sono nell'ordine di caricamento attuale. Sicuro da esportare."

msgid "Quick start"
msgstr "Avvio rapido"

msgid "Read me"
msgstr "Leggimi"

msgid "Writing mlox rules"
msgstr "Scrivere regole mlox"

msgid "Documentation not found"
msgstr "Documentazione non trovata"

msgid "%(name)s was not found next to the program.\n\nIt ships alongside the app; if this is a build made without it, the same document is in the project folder."
msgstr "%(name)s non è stato trovato accanto al programma.\n\nViene distribuito con l'app; se questa è una build fatta senza di esso, lo stesso documento è nella cartella del progetto."

msgid "Could not open documentation"
msgstr "Impossibile aprire la documentazione"

msgid "%(name)s could not be rendered:\n%(error)s"
msgstr "%(name)s non è stato reso:\n%(error)s"

msgid "Set openmw.cfg (or run a Sort) so I know where to look."
msgstr "Imposta openmw.cfg (o esegui un Ordinamento) così so dove guardare."

msgid "Scanning for backups..."
msgstr "Ricerca dei backup…"

msgid "Found %(count)d backup file."
msgid_plural "Found %(count)d backup files."
msgstr[0] "%(count)d file di backup trovato."
msgstr[1] "%(count)d file di backup trovati."

msgid "Backup scan failed: %(error)s"
msgstr "Analisi dei backup fallita: %(error)s"

msgid "%(count)d backup file. Restore copies the backup over its original; Delete removes the backup file itself."
msgid_plural "%(count)d backup files. Restore copies the backup over its original; Delete removes the backup file itself."
msgstr[0] "%(count)d file di backup. Ripristina copia il backup sul suo originale; Elimina rimuove il file di backup stesso."
msgstr[1] "%(count)d file di backup. Ripristina copia il backup sul suo originale; Elimina rimuove il file di backup stesso."

msgid "Restore"
msgstr "Ripristina"

msgid "Copy %(count)d backup over its original (overwriting it)?"
msgid_plural "Copy %(count)d backups over their originals (overwriting them)?"
msgstr[0] "Copiare %(count)d backup sul suo originale (sovrascrivendolo)?"
msgstr[1] "Copiare %(count)d backup sui loro originali (sovrascrivendoli)?"

msgid "Restored %(count)d backup%(failed)s. Re-run '1. Sort' to refresh checks."
msgid_plural "Restored %(count)d backups%(failed)s. Re-run '1. Sort' to refresh checks."
msgstr[0] "%(count)d backup ripristinato%(failed)s. Riesegui «1. Ordina» per aggiornare i controlli."
msgstr[1] "%(count)d backup ripristinati%(failed)s. Riesegui «1. Ordina» per aggiornare i controlli."

msgid ", %(fail)d failed"
msgstr ", %(fail)d falliti"

msgid "Delete"
msgstr "Elimina"

msgid "Permanently delete %(count)d backup file?"
msgid_plural "Permanently delete %(count)d backup files?"
msgstr[0] "Eliminare definitivamente %(count)d file di backup?"
msgstr[1] "Eliminare definitivamente %(count)d file di backup?"

msgid "Deleted %(count)d backup file."
msgid_plural "Deleted %(count)d backup files."
msgstr[0] "%(count)d file di backup eliminato."
msgstr[1] "%(count)d file di backup eliminati."

msgid "Restore Selected"
msgstr "Ripristina selezione"

msgid "Delete Selected"
msgstr "Elimina selezione"

msgid "Refresh"
msgstr "Aggiorna"

msgid "Linting plugins..."
msgstr "Analisi dei plugin…"

msgid " LINT (tes3lint-style checks, native)"
msgstr " ANALISI (controlli in stile tes3lint, nativi)"

msgid "\n  No lint findings. Clean bill of health."
msgstr "\n  Nessun rilievo dall'analisi. Tutto a posto."

msgid "Lint: %(count)d finding. See the log."
msgid_plural "Lint: %(count)d findings. See the log."
msgstr[0] "Analisi: %(count)d rilievo. Vedi il registro."
msgstr[1] "Analisi: %(count)d rilievi. Vedi il registro."

msgid "Lint: no findings."
msgstr "Analisi: nessun rilievo."

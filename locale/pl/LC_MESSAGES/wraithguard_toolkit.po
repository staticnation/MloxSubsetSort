msgstr "Zamknij"

msgid "Could not read the meshes: %(error)s"
msgstr "Nie można odczytać siatek: %(error)s"

msgid "Cannot show this mesh"
msgstr "Nie można pokazać tej siatki"

msgid "Opened the 3D view for %(path)s"
msgstr "Otwarto widok 3D dla %(path)s"


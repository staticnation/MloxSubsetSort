msgstr "  %(name)s: OSTRZEŻENIE: pliku nadrzędnego „%(master)s” nie znaleziono w żadnym folderze danych -- jego pole rozmiaru pozostawiono nietknięte"

msgid "Resync: %(fixed)d plugin(s) updated, %(ok)d already in sync, %(failed)d error(s)."
msgstr "Resynchronizacja: zaktualizowano wtyczek %(fixed)d, już zsynchronizowanych %(ok)d, nieudanych %(failed)d."


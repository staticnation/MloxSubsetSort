msgstr "tes3cmd clean: wyczyszczono %(changed)d, już czystych %(clean)d, pominięto %(skipped)d (brak plików nadrzędnych), nieudanych %(failed)d."

msgid "  Re-run '1. Sort' to refresh checks."
msgstr "  Uruchom ponownie „1. Sortuj”, aby odświeżyć sprawdzenia."

msgid "tes3cmd %(command)s: %(ok)d ok, %(failed)d failed. See the log."
msgstr "tes3cmd %(command)s: OK %(ok)d, nieudanych %(failed)d. Zobacz dziennik."


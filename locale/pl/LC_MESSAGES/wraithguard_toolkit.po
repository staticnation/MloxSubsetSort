msgid_plural "Wrote %(count)d JSON files to %(folder)s"
msgstr[0] "Zapisano %(count)d plik JSON do %(folder)s"
msgstr[1] "Zapisano %(count)d pliki JSON do %(folder)s"
msgstr[2] "Zapisano %(count)d plików JSON do %(folder)s"


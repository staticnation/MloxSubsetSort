msgid_plural "tes3cmd: added %(count)d needs-cleaning plugins"
msgstr[0] "tes3cmd: dodano %(count)d wtyczkę wymagającą czyszczenia"
msgstr[1] "tes3cmd: dodano %(count)d wtyczki wymagające czyszczenia"
msgstr[2] "tes3cmd: dodano %(count)d wtyczek wymagających czyszczenia"

msgid "Choose plugin file(s)"
msgstr "Wybierz plik(i) wtyczek"

msgid "Resync master sizes"
msgstr "Zsynchronizuj rozmiary plików nadrzędnych"

msgid "Rewrite the recorded master sizes in %(count)d plugin file to match the installed masters?\n\nOnly the 8-byte size fields change; a one-time .masterfix.bak copy of each file is kept."
msgid_plural "Rewrite the recorded master sizes in %(count)d plugin files to match the installed masters?\n\nOnly the 8-byte size fields change; a one-time .masterfix.bak copy of each file is kept."
msgstr[0] "Przepisać zapisane rozmiary plików nadrzędnych w %(count)d pliku wtyczki, aby pasowały do zainstalowanych plików nadrzędnych?\n\nZmieniają się tylko 8-bajtowe pola rozmiaru; zachowywana jest jednorazowa kopia .masterfix.bak każdego pliku."
msgstr[1] "Przepisać zapisane rozmiary plików nadrzędnych w %(count)d plikach wtyczek, aby pasowały do zainstalowanych plików nadrzędnych?\n\nZmieniają się tylko 8-bajtowe pola rozmiaru; zachowywana jest jednorazowa kopia .masterfix.bak każdego pliku."
msgstr[2] "Przepisać zapisane rozmiary plików nadrzędnych w %(count)d plikach wtyczek, aby pasowały do zainstalowanych plików nadrzędnych?\n\nZmieniają się tylko 8-bajtowe pola rozmiaru; zachowywana jest jednorazowa kopia .masterfix.bak każdego pliku."

msgid "Resyncing master sizes..."
msgstr "Synchronizacja rozmiarów plików nadrzędnych…"

msgid "'%(path)s' does not exist. Fix the path or clear it to auto-detect."
msgstr "„%(path)s” nie istnieje. Popraw ścieżkę lub wyczyść ją, aby wykryć automatycznie."

msgid "tes3cmd"
msgstr "tes3cmd"

msgid "tes3cmd not found. Browse to the compiled tes3cmd.exe (MOMW Tools Pack)."
msgstr "Nie znaleziono tes3cmd. Wskaż skompilowany tes3cmd.exe (MOMW Tools Pack)."

msgid "Add at least one plugin file first."
msgstr "Najpierw dodaj przynajmniej jeden plik wtyczki."

msgid "tes3cmd clean"
msgstr "tes3cmd clean"

msgid "Clean %(count)d plugin file?\n\nEach is staged into a private 'Data Files' with its masters so tes3cmd sees the full VFS; plugins whose masters can't be found are skipped. A one-time .preclean.bak copy of each modified file is kept."
msgid_plural "Clean %(count)d plugin files?\n\nEach is staged into a private 'Data Files' with its masters so tes3cmd sees the full VFS; plugins whose masters can't be found are skipped. A one-time .preclean.bak copy of each modified file is kept."
msgstr[0] "Wyczyścić %(count)d plik wtyczki?\n\nKażdy jest przygotowywany w prywatnym „Data Files” z jego plikami nadrzędnymi, aby tes3cmd widział pełny VFS; wtyczki, których plików nadrzędnych nie można znaleźć, są pomijane. Zachowywana jest jednorazowa kopia .preclean.bak każdego zmodyfikowanego pliku."
msgstr[1] "Wyczyścić %(count)d pliki wtyczek?\n\nKażdy jest przygotowywany w prywatnym „Data Files” z jego plikami nadrzędnymi, aby tes3cmd widział pełny VFS; wtyczki, których plików nadrzędnych nie można znaleźć, są pomijane. Zachowywana jest jednorazowa kopia .preclean.bak każdego zmodyfikowanego pliku."
msgstr[2] "Wyczyścić %(count)d plików wtyczek?\n\nKażdy jest przygotowywany w prywatnym „Data Files” z jego plikami nadrzędnymi, aby tes3cmd widział pełny VFS; wtyczki, których plików nadrzędnych nie można znaleźć, są pomijane. Zachowywana jest jednorazowa kopia .preclean.bak każdego zmodyfikowanego pliku."

msgid "tes3cmd %(command)s running..."
msgstr "tes3cmd %(command)s uruchomione…"

msgid "  Engine: %(command)s"
msgstr "  Silnik: %(command)s"


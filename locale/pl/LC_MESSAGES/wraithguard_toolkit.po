msgstr "  POMINIĘTO: plików nadrzędnych nie znaleziono w żadnym folderze danych: %(names)s -- czyszczenie bez obecnych plików nadrzędnych daje błędne wyniki."

msgid "  (exit code %(code)d) -- original NOT touched"
msgstr "  (kod wyjścia %(code)d) -- oryginał NIE zmieniony"

msgid "  no changes -- already clean"
msgstr "  bez zmian -- już czyste"

msgid "  cleaned: %(before)d -> %(after)d bytes (backup: %(backup)s)"
msgstr "  wyczyszczono: %(before)d -> %(after)d bajtów (kopia: %(backup)s)"


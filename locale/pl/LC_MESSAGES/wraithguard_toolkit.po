msgid_plural "WARNING: %(count)d plugins could not be placed due to an unresolved cycle and were appended at the end: %(names)s"
msgstr[0] "OSTRZEŻENIE: %(count)d wtyczki nie udało się umieścić z powodu nierozwiązanego cyklu i dodano ją na końcu: %(names)s"
msgstr[1] "OSTRZEŻENIE: %(count)d wtyczek nie udało się umieścić z powodu nierozwiązanego cyklu i dodano je na końcu: %(names)s"
msgstr[2] "OSTRZEŻENIE: %(count)d wtyczek nie udało się umieścić z powodu nierozwiązanego cyklu i dodano je na końcu: %(names)s"


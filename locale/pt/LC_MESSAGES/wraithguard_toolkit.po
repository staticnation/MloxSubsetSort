msgid "  Engine: %(engine)s"
msgstr "  Motor: %(engine)s"

msgid "native esp reader (field-level)"
msgstr "leitor esp nativo (por campo)"

msgid "\n  Wrote conflict report: %(path)s"
msgstr "\n  Relatório de conflitos gravado: %(path)s"

msgid "could not write conflict CSV: %(error)s"
msgstr "não foi possível gravar o CSV de conflitos: %(error)s"

msgid "  Scanned %(scanned)d plugin(s): %(exterior)d exterior + %(interior)d interior cell(s) touched."
msgstr "  %(scanned)d plugin(s) analisados: %(exterior)d exterior(es) + %(interior)d interior(es) tocadas."

msgid "  Wrote cell map: %(path)s  (open it in a browser)"
msgstr "  Mapa de células gravado: %(path)s  (abra-o em um navegador)"

msgid "could not write cell map: %(error)s"
msgstr "não foi possível gravar o mapa de células: %(error)s"

msgid "  Scanned %(scanned)d plugin(s); %(cells)d interior cell(s), %(grids)d interior pathgrid(s)."
msgstr "  %(scanned)d plugin(s) analisados; %(cells)d célula(s) interior(es), %(grids)d grade(s) de caminhos interior(es)."

msgid "\n  No lint findings."
msgstr "\n  Nenhuma constatação de análise."

msgid "\n  Wrote resource report: %(path)s"
msgstr "\n  Relatório de recursos gravado: %(path)s"

msgid "could not write resource CSV: %(error)s"
msgstr "não foi possível gravar o CSV de recursos: %(error)s"

msgid "  Pass --sort-data-paths to enable:"
msgstr "  Passe --sort-data-paths para ativar:"

msgid "  <-- inserted"
msgstr "  <-- inserido"

msgid "UNMANAGED (ORPHAN) ENTRIES FROM openmw.cfg"
msgstr "ENTRADAS NÃO GERENCIADAS (ÓRFÃS) DE openmw.cfg"

msgid "  %(count)d orphan plugin pulled from openmw.cfg"
msgid_plural "  %(count)d orphan plugins pulled from openmw.cfg"
msgstr[0] "  %(count)d plugin órfão recuperado do openmw.cfg"
msgstr[1] "  %(count)d plugins órfãos recuperados do openmw.cfg"

msgid "  No unmanaged plugins found -- every content= plugin in the cfg is on the list or in your customizations."
msgstr "  Nenhum plugin não gerenciado encontrado -- cada plugin content= na cfg está na lista ou nas suas personalizações."

msgid "groundcover declared by this run"
msgstr "groundcover declarado por esta execução"

msgid "  These are written as groundcover= rather than content=. Their data= folders are inserted normally -- OpenMW has to find the file."
msgstr "  Estes são gravados como groundcover= em vez de content=. Suas pastas data= são inseridas normalmente -- o OpenMW precisa encontrar o arquivo."

msgid "groundcover plugins held back"
msgstr "plugins groundcover retidos"

msgid "%(count)d plugin in your subset is already declared as groundcover in openmw.cfg, so it was NOT added to content=:"
msgid_plural "%(count)d plugins in your subset are already declared as groundcover in openmw.cfg, so they were NOT added to content=:"
msgstr[0] "%(count)d plugin no seu subconjunto já está declarado como groundcover no openmw.cfg, então NÃO foi adicionado a content=:"
msgstr[1] "%(count)d plugins no seu subconjunto já estão declarados como groundcover no openmw.cfg, então NÃO foram adicionados a content=:"

msgid "  Their groundcover= lines are untouched and their data= paths are still written, so the grass stays enabled -- as grass. Loading one as content= too would spawn every blade as a real object."
msgstr "  Suas linhas groundcover= ficam intactas e seus caminhos data= continuam sendo gravados, então a grama fica ativada -- como grama. Carregar um também como content= faria cada folha surgir como um objeto real."

msgid "  openmw.cfg left untouched (pass --write-cfg to patch it directly)"
msgstr "  openmw.cfg deixado intacto (passe --write-cfg para aplicar o patch diretamente)"

msgid "  WARNING: configurator preview failed: %(error)s"
msgstr "  AVISO: a prévia do configurador falhou: %(error)s"

msgid "\n  DRY RUN: would write %(path)s\n%(toml)s"
msgstr "\n  SIMULAÇÃO: gravaria %(path)s\n%(toml)s"

msgid "  Wrote corrected customizations: %(path)s"
msgstr "  Personalizações corrigidas gravadas: %(path)s"

msgid "  Plugins sorted:        %(count)d"
msgstr "  Plugins ordenados:      %(count)d"

msgid "  Data paths inserted:   %(count)d"
msgstr "  Caminhos de dados inseridos: %(count)d"

msgid "  Rule warnings raised:  %(count)d"
msgstr "  Avisos de regras:       %(count)d"

msgid "  plugin-order.yml warnings: %(count)d"
msgstr "  Avisos de plugin-order.yml: %(count)d"

msgid "  openmw.cfg written:    %(answer)s"
msgstr "  openmw.cfg gravado:     %(answer)s"

msgid "yes"
msgstr "sim"

msgid "no"
msgstr "não"

msgid "  customizations.toml written: %(answer)s"
msgstr "  customizations.toml gravado: %(answer)s"

msgid "Rule files (priority = order below, last = highest -- drag rows to reorder)"
msgstr "Arquivos de regras (prioridade = ordem abaixo, último = mais alta -- arraste as linhas para reordenar)"

msgid "mlox rule files (mlox_base.txt, mlox_user.txt, ...), applied in this order.\nLater files can override/extend earlier ones -- put mlox_base.txt first and your own mlox_user.txt last. Drag rows to reorder, or use the buttons."
msgstr "Arquivos de regras mlox (mlox_base.txt, mlox_user.txt, …), aplicados nesta ordem.\nOs arquivos posteriores podem sobrescrever/estender os anteriores -- coloque mlox_base.txt primeiro e seu próprio mlox_user.txt por último. Arraste as linhas para reordenar, ou use os botões."

msgid "Add File(s)..."
msgstr "Adicionar arquivos…"

msgid "Browse for one or more mlox rule .txt files to add to the list."
msgstr "Procure para adicionar um ou mais arquivos .txt de regras mlox à lista."

msgid "Remove Selected"
msgstr "Remover selecionados"

msgid "Remove the selected rule file from the list (doesn't delete anything on disk)."
msgstr "Remover o arquivo de regras selecionado da lista (não exclui nada do disco)."

msgid "Move Up"
msgstr "Mover para cima"

msgid "Move the selected rule file earlier (lower priority)."
msgstr "Mover o arquivo de regras selecionado para antes (prioridade menor)."

msgid "Move Down"
msgstr "Mover para baixo"

msgid "Move the selected rule file later (higher priority)."
msgstr "Mover o arquivo de regras selecionado para depois (prioridade maior)."

msgid "New Rule..."
msgstr "Nova regra…"

msgid "Write your own mlox [Order]/[NearStart]/[NearEnd] rule without knowing the syntax: pick plugins (or grab the selected rows from the plugin panel), preview the rule, and append it to a personal rules file that loads LAST so it wins conflicts. This is how rules for modern mods get made -- consider contributing good ones upstream."
msgstr "Escreva sua própria regra mlox [Order]/[NearStart]/[NearEnd] sem conhecer a sintaxe: escolha plugins (ou pegue as linhas selecionadas do painel de plugins), pré-visualize a regra, e anexe-a a um arquivo de regras pessoal que carrega por ÚLTIMO para vencer os conflitos. É assim que nascem as regras dos mods modernos -- considere contribuir com as boas rio acima."

msgid "Update Rules..."
msgstr "Atualizar regras…"

msgid "Download the CURRENT mlox_base.txt / mlox_user.txt from the actively maintained rules repo (github.com/%(repo)s -- the same source plox uses, and mlox 1.1+ auto-updates from) over the matching files in this list. The old files are kept as timestamped .bak copies. Files with other names (your personal rules) are never touched. Source URL configurable via Sources..."
msgstr "Baixar os mlox_base.txt / mlox_user.txt ATUAIS do repositório de regras mantido ativamente (github.com/%(repo)s -- a mesma origem que o plox usa, e da qual o mlox 1.1+ se atualiza) sobre os arquivos correspondentes desta lista. Os arquivos antigos são mantidos como cópias .bak com data e hora. Arquivos com outros nomes (suas regras pessoais) nunca são tocados. URL de origem configurável via Origens…"

msgid "Sources..."
msgstr "Origens…"

msgid "Configure WHERE 'Update Rules...' and the plugin-order.yml 'Update...' button download from -- point them at a fork or mirror if upstream moves. Blank fields use the built-in defaults."
msgstr "Configurar DE ONDE «Atualizar regras…» e o botão «Atualizar…» do plugin-order.yml baixam -- aponte-os para um fork ou espelho se a origem se mudar. Os campos vazios usam os padrões integrados."

msgid "(install tkinterdnd2 to drag files in from your file manager)"
msgstr "(instale tkinterdnd2 para arrastar arquivos do seu gerenciador de arquivos)"

msgid "Choose a folder for the mlox rule files"
msgstr "Escolha uma pasta para os arquivos de regras mlox"

msgid "Update rules"
msgstr "Atualizar regras"

msgid "Download the current mlox rules from github.com/%(repo)s?\n\n%(files)s\n\nThey don't exist yet -- they'll be created here."
msgstr "Baixar as regras mlox atuais de github.com/%(repo)s?\n\n%(files)s\n\nElas ainda não existem -- serão criadas aqui."

msgid "Download the current rules from github.com/%(repo)s over these files?\n\n%(age)s\n\nTimestamped .bak copies of the old files are kept."
msgstr "Baixar as regras atuais de github.com/%(repo)s sobre estes arquivos?\n\n%(age)s\n\nCópias .bak com data e hora dos arquivos antigos são mantidas."

msgid "Move the selected row(s) one position earlier. Works with a multi-selection; you can also drag a contiguous block up with the mouse."
msgstr "Mover a(s) linha(s) selecionada(s) uma posição para antes. Funciona com seleção múltipla; você também pode arrastar um bloco contíguo para cima com o mouse."

msgid "Move the selected row(s) one position later. Works with a multi-selection; you can also drag a contiguous block down with the mouse."
msgstr "Mover a(s) linha(s) selecionada(s) uma posição para depois. Funciona com seleção múltipla; você também pode arrastar um bloco contíguo para baixo com o mouse."

msgid "Disable / Enable"
msgstr "Desativar / Ativar"

msgid "Opt the selected row in or out of the load order. Disabled rows are dimmed and marked, and are left out of Export: a custom item is simply not inserted, and an item already in your openmw.cfg gets a removeContent/removeData entry in the emitted TOML so it's durably removed. Double-click a row to toggle it too."
msgstr "Incluir ou excluir a linha selecionada da ordem de carregamento. As linhas desativadas são atenuadas e marcadas, e excluídas do Export: um item personalizado simplesmente não é inserido, e um item já no seu openmw.cfg recebe uma entrada removeContent/removeData no TOML emitido para ser removido de forma duradoura. Clique duplo em uma linha também a alterna."

msgid "Discard any manual dragging and restore the order from the last Sort (your disable/enable choices are kept)."
msgstr "Descartar qualquer arrasto manual e restaurar a ordem da última Ordenação (suas escolhas de ativar/desativar são mantidas)."

msgid "Plugin load order -- drag to override mlox (red = touched by this sort, purple = master problem)"
msgstr "Ordem de carregamento dos plugins -- arraste para sobrepor o mlox (vermelho = tocado por esta ordenação, roxo = problema de master)"

msgid "Data path order -- drag to adjust (highlighted = your custom paths)"
msgstr "Ordem dos caminhos de dados -- arraste para ajustar (destacado = seus caminhos personalizados)"

msgid "Drag & drop is unavailable (tkinterdnd2 or its tkdnd library is missing) -- use the Browse buttons below."
msgstr "Arrastar e soltar está indisponível (falta o tkinterdnd2 ou sua biblioteca tkdnd) -- use os botões Procurar abaixo."

msgid "Required. The openmw.cfg to read the current content= and data= order from, and (if 'Write openmw.cfg directly' is checked) to patch."
msgstr "Obrigatório. O openmw.cfg de onde ler a ordem content= e data= atual e (se «Gravar openmw.cfg diretamente» estiver marcado) ao qual aplicar o patch."

msgid "A momw-configurator/umo customizations TOML to pull the plugin/data-path subset from automatically. Optional if you provide a subset file instead -- provide both and they're combined."
msgstr "Um TOML de personalizações do momw-configurator/umo de onde extrair automaticamente o subconjunto de plugins/caminhos de dados. Opcional se você fornecer um arquivo de subconjunto em vez disso -- forneça ambos e eles são combinados."

msgid "A plain text file (one plugin filename or data folder path per line, '#' comments allowed) or a minimal TOML with subset=[...]/data=[...]. Combined with --emit-toml, this alone is enough to generate a brand new customizations.toml with no existing one required."
msgstr "Um arquivo de texto simples (um nome de arquivo de plugin ou caminho de pasta de dados por linha, comentários «#» permitidos) ou um TOML mínimo com subset=[...]/data=[...]. Combinado com --emit-toml, isso sozinho basta para gerar um customizations.toml novo sem que seja necessário um existente."

msgid "Where to write a corrected customizations.toml (sorted insert blocks, re-anchored). Disabled when 'write directly back' below is checked."
msgstr "Onde gravar um customizations.toml corrigido (blocos de inserção ordenados, reancorados). Desativado quando «regravar diretamente» abaixo está marcado."

msgid "list name (optional):"
msgstr "nome da lista (opcional):"

msgid "MOMW's plugin-order.yml (source of truth for which plugins belong to which curated list). With the list name above set, curated plugins for that list are excluded from the sort (never reordered) so only your custom additions are touched, and read-only warnings are emitted: redundant, orphan, needs-cleaning, and a base-order drift check. PyYAML used if installed, else a built-in parser."
msgstr "O plugin-order.yml do MOMW (a fonte de verdade sobre quais plugins pertencem a qual lista curada). Com o nome da lista acima definido, os plugins curados dessa lista são excluídos da ordenação (nunca reordenados) para que apenas suas adições personalizadas sejam tocadas, e avisos de somente leitura são emitidos: redundante, órfão, needs-cleaning e uma verificação de desvio da ordem base. PyYAML usado se instalado, senão um analisador integrado."

msgid "Write directly back to customizations.toml (overwrite in place; a .bak-<timestamp> copy is made first unless backups are disabled below)"
msgstr "Regravar diretamente no customizations.toml (sobrescrever no local; primeiro é feita uma cópia .bak-<data e hora> a menos que os backups estejam desativados abaixo)"

msgid "Instead of writing to a separate file above, overwrite the customizations.toml given above in place. A timestamped backup is made first (unless disabled), and you'll get a confirmation prompt before it actually happens."
msgstr "Em vez de gravar num arquivo separado acima, sobrescrever no local o customizations.toml indicado acima. Primeiro é feito um backup com data e hora (a menos que desativado), e você terá uma confirmação antes de acontecer de fato."

msgid "Options"
msgstr "Opções"

msgid "Dry run (preview only, don't write files)"
msgstr "Simulação (apenas prévia, não grava arquivos)"

msgid "When checked, Export shows exactly what it would write without touching any files. Uncheck when you're ready to actually save."
msgstr "Quando marcado, o Export mostra exatamente o que gravaria sem tocar em nenhum arquivo. Desmarque quando estiver pronto para salvar de fato."

msgid "Write openmw.cfg directly"
msgstr "Gravar openmw.cfg diretamente"

msgid "Patch the content=/data= lines in openmw.cfg in place on Export. A .bak-<timestamp> copy is made first unless backups are disabled."
msgstr "Aplicar patch às linhas content=/data= do openmw.cfg no local ao Exportar. Primeiro é feita uma cópia .bak-<data e hora> a menos que os backups estejam desativados."

msgid "Sort data= paths too"
msgstr "Ordenar também os caminhos data="

msgid "mlox has no concept of data= folder order -- this positions new data= paths using an explicit after/before anchor if you wrote one, or by scanning the folder for plugins and anchoring next to their neighbor in the sorted content= order. Off by default so a plugin-only run can't surprise-reorder data= too. Also required for the data path order panel to populate."
msgstr "o mlox não tem noção de ordem de pastas data= -- isto posiciona os novos caminhos data= com uma âncora after/before explícita se você escreveu uma, ou analisando a pasta em busca de plugins e ancorando ao lado do vizinho deles na ordem content= ordenada. Desativado por padrão para que uma execução só de plugins não reordene data= de surpresa. Também necessário para o painel de ordem de caminhos de dados ser preenchido."

msgid "Skip .bak backup of openmw.cfg"
msgstr "Pular o backup .bak do openmw.cfg"

msgid "Skip making a timestamped backup before overwriting openmw.cfg and/or an in-place customizations.toml. Not recommended."
msgstr "Pular a criação de um backup com data e hora antes de sobrescrever o openmw.cfg e/ou um customizations.toml no local. Não recomendado."

msgid "Skip mlox Conflict/Requires/Note warnings"
msgstr "Pular os avisos Conflict/Requires/Note do mlox"

msgid "Skip evaluating [Conflict]/[Requires]/[Note] rules against the sorted plugin list. This is purely informational and read-only either way -- it never changes the computed order or what gets written, only whether warnings get printed."
msgstr "Pular a avaliação das regras [Conflict]/[Requires]/[Note] contra a lista de plugins ordenada. É puramente informativo e de somente leitura de qualquer forma -- nunca muda a ordem calculada nem o que é gravado, apenas se os avisos são impressos."

msgid "Create subset text document (on Scan)"
msgstr "Criar documento de texto de subconjunto (na Análise)"

msgid "Controls what 'Scan...' does with its result. Checked: write the scanned list to a .txt subset file you choose, and load it (the file stays on disk for reuse). Unchecked: keep the scanned list in memory just for this session and feed it straight to the sort -- nothing is written to disk."
msgstr "Controla o que «Analisar…» faz com o resultado. Marcado: gravar a lista analisada num arquivo de subconjunto .txt que você escolher, e carregá-la (o arquivo fica no disco para reutilização). Desmarcado: manter a lista analisada em memória apenas nesta sessão e passá-la diretamente à ordenação -- nada é gravado no disco."

msgid "Pull unmanaged (orphan) plugins from openmw.cfg"
msgstr "Recuperar plugins não gerenciados (órfãos) do openmw.cfg"

msgid "Also sort the content= plugins ALREADY in openmw.cfg that nothing manages -- neither the curated list (plugin-order.yml) nor your customizations.toml. Their current cfg order is kept as the starting order until the sort repositions them. Base masters (Morrowind/Tribunal/Bloodmoon) are never touched. Works on its own (no subset file needed) or alongside one.\n\ndata= paths are left exactly as openmw.cfg has them: they are already in the cfg's own data= order, and there is no reliable way to tell a path the list manages from one you added, so pulling them would reorder the whole VFS."
msgstr "Ordenar também os plugins content= JÁ no openmw.cfg que nada gerencia -- nem a lista curada (plugin-order.yml) nem o seu customizations.toml. A ordem cfg atual deles é mantida como ordem de partida até a ordenação reposicioná-los. Os masters base (Morrowind/Tribunal/Bloodmoon) nunca são tocados. Funciona sozinho (nenhum arquivo de subconjunto necessário) ou junto de um.\n\nOs caminhos data= são deixados exatamente como o openmw.cfg os tem: já estão na ordem data= própria da cfg, e não há forma confiável de distinguir um caminho gerenciado pela lista de um que você adicionou, então recuperá-los reordenaria todo o VFS."

msgid "Exclude from conflict / cell scans:"
msgstr "Excluir das análises de conflitos / células:"

msgid "Declare as groundcover:"
msgstr "Declarar como groundcover:"

msgid "Keep tes3conv JSON dump"
msgstr "Manter a exportação JSON do tes3conv"

msgid "Tidy old HTML views"
msgstr "Limpar visualizações HTML antigas"

msgid "Every conflict map, terrain view and path grid is written to its own timestamped file so you can compare two of them side by side -- which means they pile up, and one map can be several megabytes.\n\nChecked: on exit, the newest 3 of each kind are kept and older ones removed (with their data folders). Only files this tool generated are ever touched -- never anything you saved yourself with a name of your own choosing.\n\nUnchecked: nothing is ever deleted."
msgstr "Cada mapa de conflitos, vista de terreno e grade de caminhos é gravado em seu próprio arquivo com data e hora para você comparar dois lado a lado -- o que significa que eles se acumulam, e um mapa pode ter vários megabytes.\n\nMarcado: ao sair, os 3 mais recentes de cada tipo são mantidos e os mais antigos removidos (com suas pastas de dados). Apenas os arquivos que esta ferramenta gerou são tocados -- nunca algo que você salvou com um nome à sua escolha.\n\nDesmarcado: nada é jamais excluído."

msgid "tes3conv conversions are written to disk (not held in RAM) and read per-plugin, so big load orders don't blow up memory. They always go to a 'tes3conv_json' folder next to the app and are reused within a run -- so Check Conflicts then Cell Map won't re-run tes3conv (a plugin is only re-converted if it changed). This box just decides what happens on exit: checked = keep that folder (reused next launch too); unchecked = delete it when you close the app."
msgstr "As conversões do tes3conv são gravadas em disco (não mantidas em RAM) e lidas por plugin, para que ordens de carregamento grandes não estourem a memória. Vão sempre para uma pasta «tes3conv_json» ao lado do app e são reutilizadas dentro de uma execução -- então Verificar conflitos e depois Mapa de células não reexecutam o tes3conv (um plugin só é reconvertido se mudou). Esta caixa só decide o que acontece ao sair: marcado = manter essa pasta (reutilizada no próximo início também); desmarcado = excluí-la ao fechar o app."

msgid "Verbose Merged Lands log"
msgstr "Registro detalhado do Merged Lands"

msgid "Checked: a Merge Lands run also names every plugin that carries a .mergedlands.toml and exactly what it sets (per layer: on/off and the conflict strategy), and lists every plugin it could not read -- rather than the headline counts. For working out why a merge did what it did.\n\nUnchecked: the normal summary log."
msgstr "Marcado: uma execução do Merge Lands também nomeia cada plugin que leva um .mergedlands.toml e exatamente o que ele define (por camada: ativo/inativo e a estratégia de conflito), e lista cada plugin que não conseguiu ler -- em vez das contagens principais. Para descobrir por que uma mesclagem fez o que fez.\n\nDesmarcado: o registro de resumo normal."

msgid "Log"
msgstr "Registro"

msgid "Full output from the last Sort and/or Export. Color key: green = a plugin/path this sort inserted or moved, orange = a heads-up (mlox warning, or a rule your curated cfg order overrode), blue = a section header, bright red = an error worth checking. Plain text = frozen base rows left untouched. Colors follow the syntax highlighting theme picked below."
msgstr "Saída completa da última Ordenação e/ou Export. Legenda de cores: verde = um plugin/caminho que esta ordenação inseriu ou moveu, laranja = um aviso (do mlox, ou uma regra que sua ordem cfg curada sobrepôs), azul = um cabeçalho de seção, vermelho vivo = um erro que vale verificar. Texto simples = linhas base congeladas, deixadas intactas. As cores seguem o tema de realce de sintaxe escolhido abaixo."

msgid "Clear Log"
msgstr "Limpar o registro"

msgid "Clear the log panel. Doesn't affect the order panels or any files."
msgstr "Limpar o painel do registro. Não afeta nem os painéis de ordem nem nenhum arquivo."

msgid "Save Log As..."
msgstr "Salvar o registro como…"

msgid "Save the current log contents to a text file."
msgstr "Salvar o conteúdo atual do registro num arquivo de texto."

msgid "Theme:"
msgstr "Tema:"

msgid "Color theme for the whole GUI: window/button colors, syntax highlighting here in the Log panel, and the field-diff JSON viewer (Check Conflicts -> double-click a field). Switching re-themes everything immediately, including any windows already open. Built-in: Dracula, Monokai, Atom One Dark, Gruvbox Dark, plus anything you've imported."
msgstr "Tema de cores para toda a interface: cores de janelas/botões, realce de sintaxe aqui no painel do Registro, e o visualizador JSON de diferenças de campo (Verificar conflitos -> clique duplo num campo). Trocar re-tematiza tudo na hora, inclusive as janelas já abertas. Integrados: Dracula, Monokai, Atom One Dark, Gruvbox Dark, mais o que você importou."

msgid "Import Theme..."
msgstr "Importar tema…"

msgid "Import a custom theme from a JSON file (background/foreground/select/section/warn/error/ok/inserted/dim as hex colors, plus an optional \"chrome\" object for explicit window/button colors) or a base16 scheme file (.yaml/.yml/.json with base00..base0F -- e.g. from the atelierbram/syntax-highlighting or chriskempson/base16 scheme repos). Window colors not given explicitly are derived from the background. Imported themes are saved and appear in the dropdown from then on."
msgstr "Importar um tema personalizado de um arquivo JSON (background/foreground/select/section/warn/error/ok/inserted/dim como cores hex, mais um objeto «chrome» opcional para cores de janela/botão explícitas) ou um arquivo de esquema base16 (.yaml/.yml/.json com base00..base0F -- p. ex. dos repos atelierbram/syntax-highlighting ou chriskempson/base16). As cores de janela não dadas explicitamente são derivadas do fundo. Os temas importados são salvos e aparecem daí em diante no menu suspenso."

msgid "Clear Memory"
msgstr "Limpar a memória"

msgid "Forget every plugin/folder added by hand (drag-drop or the Add buttons) and any scan result held only in memory (not saved to a .txt) -- none of that is shown anywhere on screen, and it otherwise keeps accumulating for the rest of the session. Does not touch any files."
msgstr "Esquecer cada plugin/pasta adicionado à mão (arrastar-soltar ou os botões Adicionar) e qualquer resultado de análise mantido só em memória (não salvo num .txt) -- nada disso é mostrado na tela, e de outra forma se acumula pelo resto da sessão. Não toca em nenhum arquivo."

msgid "Help"
msgstr "Ajuda"

msgid "Open the program's own documentation -- the Quick start (what to click, in order) or the Read me (every option, in detail) -- rendered as a readable page with a contents sidebar. Works offline; nothing is downloaded."
msgstr "Abrir a documentação própria do programa -- o Início rápido (o que clicar, em ordem) ou o Leia-me (cada opção em detalhe) -- renderizada como uma página legível com uma barra lateral de conteúdo. Funciona offline; nada é baixado."

msgid "Log syntax highlighting: %(name)s"
msgstr "Realce de sintaxe do registro: %(name)s"

msgid "Import syntax highlighting theme"
msgstr "Importar tema de realce de sintaxe"

msgid "Import failed"
msgstr "Falha ao importar"

msgid "Couldn't import that theme:\n\n%(error)s"
msgstr "Não foi possível importar esse tema:\n\n%(error)s"

msgid "Imported and applied theme: %(name)s"
msgstr "Tema importado e aplicado: %(name)s"

msgid "Theme imported"
msgstr "Tema importado"

msgid "Imported \"%(name)s\" and set it as the active log theme."
msgstr "«%(name)s» importado e definido como tema ativo do registro."

msgid "Missing input"
msgstr "Entrada ausente"

msgid "Select the mods folder to scan"
msgstr "Selecione a pasta de mods para analisar"

msgid "Save generated subset file as"
msgstr "Salvar o arquivo de subconjunto gerado como"

msgid "Scanning mods folder..."
msgstr "Analisando a pasta de mods…"

msgid "Scan complete -- %(folders)d folder(s), %(plugins)d plugin(s). Subset file loaded."
msgstr "Análise concluída -- %(folders)d pasta(s), %(plugins)d plugin(s). Arquivo de subconjunto carregado."

msgid "Scan complete -- %(folders)d folder(s), %(plugins)d plugin(s). Held in memory (no file written)."
msgstr "Análise concluída -- %(folders)d pasta(s), %(plugins)d plugin(s). Mantido em memória (nenhum arquivo gravado)."

msgid "Add plugin..."
msgstr "Adicionar plugin…"

msgid "Include a plugin the Scan missed -- e.g. one sitting outside a recognised mod folder. It joins your custom subset on the next Sort. You can also drag a plugin file onto the list above from your file manager."
msgstr "Incluir um plugin que a Análise deixou passar -- p. ex. um fora de uma pasta de mod reconhecida. Junta-se ao seu subconjunto personalizado na próxima Ordenação. Você também pode arrastar um arquivo de plugin para a lista acima do seu gerenciador de arquivos."

msgid "(install tkinterdnd2 to drag a plugin in)"
msgstr "(instale tkinterdnd2 para arrastar um plugin)"

msgid "Add data folder..."
msgstr "Adicionar pasta de dados…"

msgid "Include a folder the Scan missed -- e.g. an OpenMW Lua mod with a non-standard layout (no meshes/textures/... folder and no plugin). It joins your data paths on the next Sort; tick 'Sort data= paths too' to place it in the load order. You can also drag a folder onto the list above from your file manager."
msgstr "Incluir uma pasta que a Análise deixou passar -- p. ex. um mod Lua do OpenMW com estrutura fora do padrão (sem pasta meshes/textures/… e sem plugin). Junta-se aos seus caminhos de dados na próxima Ordenação; marque «Ordenar também os caminhos data=» para colocá-la na ordem de carregamento. Você também pode arrastar uma pasta para a lista acima do seu gerenciador de arquivos."

msgid "(install tkinterdnd2 to drag a folder in)"
msgstr "(instale tkinterdnd2 para arrastar uma pasta)"

msgid "Select a data folder to add"
msgstr "Selecione uma pasta de dados para adicionar"

msgid "Select plugin(s) to add"
msgstr "Selecione os plugins para adicionar"

msgid "Plugins"
msgstr "Plugins"

msgid "Added plugin"
msgstr "Plugin adicionado"

msgid "Already added"
msgstr "Já adicionado"

msgid "Added data folder"
msgstr "Pasta de dados adicionada"

msgid "  Tick 'Sort data= paths too' to place it."
msgstr "  Marque «Ordenar também os caminhos data=» para colocá-la."

msgid "Not a plugin or folder: %(path)s"
msgstr "Não é um plugin nem uma pasta: %(path)s"

msgid "Nothing to clear."
msgstr "Nada a limpar."

msgid "%(n)d manual plugin(s)"
msgstr "%(n)d plugin(s) manual(is)"

msgid "%(n)d manual data folder(s)"
msgstr "%(n)d pasta(s) de dados manual(is)"

msgid "the in-memory scan result"
msgstr "o resultado de análise em memória"

msgid "Clear memory?"
msgstr "Limpar a memória?"

msgid "This forgets everything added by hand this session and any scan result held in memory (not written to a subset file):\n\n%(summary)s\n\nThey will no longer be included on the next Sort. This does not touch the subset file field, remembered paths, or any file on disk. Continue?"
msgstr "Isto esquece tudo o que foi adicionado à mão nesta sessão e qualquer resultado de análise mantido em memória (não gravado num arquivo de subconjunto):\n\n%(summary)s\n\nEles não serão mais incluídos na próxima Ordenação. Isto não toca nem no campo do arquivo de subconjunto, nem nos caminhos lembrados, nem em nenhum arquivo do disco. Continuar?"

msgid "Cleared: %(summary)s"
msgstr "Limpo: %(summary)s"

msgid "%(what)s (%(n)d added, applied on Sort): %(value)s"
msgstr "%(what)s (%(n)d adicionados, aplicados na Ordenação): %(value)s"

msgid "Sorting..."
msgstr "Ordenando…"

msgid ", %(count)d yml warning(s)"
msgstr ", %(count)d aviso(s) yml"

msgid "Sorted %(plugins)d plugin(s), %(warnings)d rule warning(s)%(yml)s. Drag to adjust, then Export."
msgstr "%(plugins)d plugin(s) ordenados, %(warnings)d aviso(s) de regras%(yml)s. Arraste para ajustar, e depois Exporte."

msgid "openmw.cfg changed"
msgstr "openmw.cfg alterado"

msgid "openmw.cfg has changed on disk since you ran '1. Sort' (did momw-configurator re-run?).\n\nThe order on screen was computed against the OLD contents. It's safer to re-Sort first.\n\nExport anyway?"
msgstr "openmw.cfg mudou no disco desde que você executou «1. Ordenar» (o momw-configurator foi reexecutado?).\n\nA ordem na tela foi calculada contra o conteúdo ANTIGO. É mais seguro re-Ordenar primeiro.\n\nExportar mesmo assim?"

msgid "Overwrite customizations.toml?"
msgstr "Sobrescrever customizations.toml?"

msgid "This will overwrite:\n%(path)s\n\nin place%(note)s. Continue?"
msgstr "Isto sobrescreverá:\n%(path)s\n\nno local%(note)s. Continuar?"

msgid "Exporting..."
msgstr "Exportando…"

msgid "Export done -- cfg written: %(cfg)s, toml written: %(toml)s."
msgstr "Export concluído -- cfg gravado: %(cfg)s, toml gravado: %(toml)s."

msgid "Building cell map..."
msgstr "Construindo o mapa de células…"

msgid "\n\nThis REPLACES the existing %(name)s."
msgstr "\n\nIsto SUBSTITUI o %(name)s existente."

msgid "Build Merged Lands.esp?"
msgstr "Construir Merged Lands.esp?"

msgid "A new plugin will be written to:\n%(path)s\n\nIt carries terrain only -- no references, objects or scripts -- so everything placed in those cells stays where it is. Your mods are NOT modified, and deleting the merged plugin restores your previous behaviour completely.\n\nLoad it LAST, and back up your saves before playing with it the first time.%(existing)s\n\nYes: write it here.   No: choose a different folder."
msgstr "Um novo plugin será gravado em:\n%(path)s\n\nEle leva só terreno -- sem referências, objetos ou scripts -- então tudo colocado nessas células fica onde está. Seus mods NÃO são modificados, e excluir o plugin mesclado restaura completamente o seu comportamento anterior.\n\nCarregue-o por ÚLTIMO, e faça backup dos seus salvamentos antes de jogar com ele pela primeira vez.%(existing)s\n\nSim: gravá-lo aqui.   Não: escolher outra pasta."

msgid "Merging land..."
msgstr "Mesclando terreno…"

msgid "Folder not found"
msgstr "Pasta não encontrada"

msgid "%(path)s no longer exists. Please choose where to write."
msgstr "%(path)s não existe mais. Por favor, escolha onde gravar."

msgid "Data Files not found"
msgstr "Data Files não encontrado"

msgid "Could not work out which folder holds your plugins, so there is no sensible place to put the merged plugin. Use 'Merged Lands folder...' to choose one."
msgstr "Não foi possível descobrir qual pasta contém seus plugins, então não há um lugar sensato para o plugin mesclado. Use «Pasta do Merged Lands…» para escolher um."

msgid "Where should Merged Lands.esp be written?"
msgstr "Onde o Merged Lands.esp deve ser gravado?"

msgid "Not a data folder"
msgstr "Não é uma pasta de dados"

msgid "%(path)s is not one of the folders OpenMW reads, so it will not find the merged plugin there.\n\nAdd this line to openmw.cfg:\n\ndata=\"%(path)s\"\n\nand put 'content=%(name)s' last."
msgstr "%(path)s não é uma das pastas que o OpenMW lê, então ele não encontrará o plugin mesclado ali.\n\nAdicione esta linha ao openmw.cfg:\n\ndata=\"%(path)s\"\n\ne coloque «content=%(name)s» por último."

msgid " MERGE LANDS"
msgstr " MESCLAGEM DE TERRENOS"

msgid "Merge produced nothing to write."
msgstr "A mesclagem não produziu nada a gravar."

msgid "Merged Lands written: %(cells)d cell(s)."
msgstr "Merged Lands gravado: %(cells)d célula(s)."

msgid "Merge failed -- see log."
msgstr "Falha na mesclagem -- veja o registro."

msgid "%(contested)d vertex/vertices were edited by more than one mod; the later one in your load order won each."
msgstr "%(contested)d vértice(s) foram editados por mais de um mod; o mais recente na sua ordem de carregamento venceu cada um."

msgid "%(major)d were blended far from a mod's intent where a .mergedlands.toml asked to Resolve."
msgstr "%(major)d foram mesclados longe da intenção de um mod onde um .mergedlands.toml pedia Resolve."

msgid "Merged Lands built"
msgstr "Merged Lands construído"

msgid "Written to:\n%(path)s\n\nEnable it and place it LAST in your load order.\n\n%(cells)d land record(s), %(textures)d land texture(s).\n%(detail)s"
msgstr "Gravado em:\n%(path)s\n\nAtive-o e coloque-o por ÚLTIMO na sua ordem de carregamento.\n\n%(cells)d registro(s) de terreno, %(textures)d textura(s) de terreno.\n%(detail)s"

msgid "Pick a plugin to write a .mergedlands.toml for"
msgstr "Escolha um plugin para o qual gravar um .mergedlands.toml"

msgid "Morrowind plugins"
msgstr "Plugins do Morrowind"

msgid "Existing .mergedlands.toml could not be read"
msgstr "Não foi possível ler o .mergedlands.toml existente"

msgid "%(name)s will be replaced from defaults:\n\n%(err)s"
msgstr "%(name)s será substituído pelos valores padrão:\n\n%(err)s"

msgid "Merge settings: %(name)s"
msgstr "Configurações de mesclagem: %(name)s"

msgid "Choose how %(name)s's landscape edits merge. Uncheck a layer to keep this plugin from touching it; set a strategy for how its edits resolve where they collide with another mod. The defaults behave as if there were no file."
msgstr "Escolha como as edições de paisagem de %(name)s se mesclam. Desmarque uma camada para impedir este plugin de tocá-la; defina uma estratégia de como suas edições se resolvem onde colidem com outro mod. Os valores padrão se comportam como se não houvesse arquivo."

msgid "meta_type:"
msgstr "meta_type:"

msgid "Patch = a hand-written settings file (the usual choice). Auto = default behaviour. MergedLands marks a plugin the tool generated so a re-run ignores it -- do not set that on an ordinary mod."
msgstr "Patch = um arquivo de configurações escrito à mão (a escolha usual). Auto = comportamento padrão. O MergedLands marca um plugin gerado pela ferramenta para que uma reexecução o ignore -- não defina isso num mod comum."

msgid "Layers"
msgstr "Camadas"

msgid "include"
msgstr "incluir"

msgid "layer"
msgstr "camada"

msgid "conflict strategy"
msgstr "estratégia de conflito"

msgid "Vertex heights -- and the normals stored with them."
msgstr "Alturas de vértices -- e as normais armazenadas com elas."

msgid "Baked vertex colours (terrain lighting)."
msgstr "Cores de vértices pré-calculadas (iluminação do terreno)."

msgid "Which land texture paints each square."
msgstr "Qual textura de terreno pinta cada quadrado."

msgid "The low-resolution world-map heightmap."
msgstr "O mapa de alturas de baixa resolução do mapa-múndi."

msgid "Auto = later plugin wins for entries it changed Â· Overwrite = this plugin wins collisions Â· Ignore = keep the earlier edit Â· Resolve = blend conflicting numbers Â· Curvature = structure-weighted blend (ours)."
msgstr "Auto = o plugin posterior vence para as entradas que mudou · Overwrite = este plugin vence as colisões · Ignore = manter a edição anterior · Resolve = mesclar os números em conflito · Curvature = mesclagem ponderada pela estrutura (a nossa)."

msgid "Preview:"
msgstr "Prévia:"

msgid "Write .mergedlands.toml"
msgstr "Gravar .mergedlands.toml"

msgid "Could not write .mergedlands.toml"
msgstr "Não foi possível gravar .mergedlands.toml"

msgid "Wrote %(name)s."
msgstr "%(name)s gravado."

msgid "Merge settings written"
msgstr "Configurações de mesclagem gravadas"

msgid "Wrote:\n%(path)s\n\nRun Merge Lands to apply it."
msgstr "Gravado:\n%(path)s\n\nExecute o Merge Lands para aplicá-lo."

msgid " CELL MAP"
msgstr " MAPA DE CÉLULAS"

msgid "native esp reader"
msgstr "leitor esp nativo"

msgid "  %(exterior)d exterior + %(interior)d interior cell(s) touched across %(scanned)d plugin(s)."
msgstr "  %(exterior)d célula(s) exterior(es) + %(interior)d interior(es) tocadas em %(scanned)d plugin(s)."

msgid "  Map written to: %(path)s"
msgstr "  Mapa gravado em: %(path)s"

msgid "Cell map ready (%(exterior)d exterior, %(interior)d interior)."
msgstr "Mapa de células pronto (%(exterior)d exteriores, %(interior)d interiores)."

msgid "Open in browser"
msgstr "Abrir no navegador"

msgid "(inline render failed -- use 'Open in browser'. The 3D and nav views need a real browser engine.)"
msgstr "(a renderização embutida falhou -- use «Abrir no navegador». As vistas 3D e de navegação precisam de um mecanismo de navegador real.)"

msgid "Save HTML..."
msgstr "Salvar HTML…"

msgid "(inline render failed - use 'Open in browser' for the full map)"
msgstr "(a renderização embutida falhou -- use «Abrir no navegador» para o mapa completo)"

msgid "Save cell map"
msgstr "Salvar mapa de células"

msgid "Cell map saved: %(path)s"
msgstr "Mapa de células salvo: %(path)s"

msgid "If upstream moves or a new fork takes over, point the updaters at the new location here. Blank = built-in defaults. Downloads are always validated before anything is overwritten."
msgstr "Se a origem se mudar ou um novo fork assumir, aponte os atualizadores para o novo local aqui. Vazio = padrões integrados. Os downloads são sempre validados antes de sobrescrever qualquer coisa."

msgid "mlox rules URL template:"
msgstr "Modelo de URL de regras mlox:"

msgid "Where 'Update Rules...' downloads from. Must contain {name}, which is replaced with mlox_base.txt / mlox_user.txt per file.\nDefault: %(url)s"
msgstr "De onde «Atualizar regras…» baixa. Deve conter {name}, que é substituído por mlox_base.txt / mlox_user.txt por arquivo.\nPadrão: %(url)s"

msgid "default: %(url)s"
msgstr "padrão: %(url)s"

msgid "plugin-order.yml URL:"
msgstr "URL do plugin-order.yml:"

msgid "Where the plugin-order.yml 'Update...' button downloads from. Blank tries the built-in candidates in order.\nDefault: %(url)s"
msgstr "De onde o botão «Atualizar…» do plugin-order.yml baixa. Vazio tenta os candidatos integrados em ordem.\nPadrão: %(url)s"

msgid "default: %(url)s..."
msgstr "padrão: %(url)s…"

msgid "Download sources"
msgstr "Baixar origens"

msgid "The rules URL template must contain {name} (it's replaced with the rule filename)."
msgstr "O modelo de URL de regras deve conter {name} (é substituído pelo nome do arquivo de regras)."

msgid "Reset to defaults"
msgstr "Restaurar valores padrão"

msgid "Save & Close"
msgstr "Salvar e fechar"

msgid "New mlox rule"
msgstr "Nova regra mlox"

msgid "rules file:"
msgstr "arquivo de regras:"

msgid "Personal rules file the rule is appended to (created with a header if new). Use your OWN file, not mlox_base/mlox_user -- those get overwritten by 'Update Rules...'. It's auto-added to the rule-files list LAST, so your rules win conflicts."
msgstr "Arquivo de regras pessoal ao qual a regra é anexada (criado com um cabeçalho se novo). Use o SEU próprio arquivo, não mlox_base/mlox_user -- esses são sobrescritos por «Atualizar regras…». Ele é adicionado automaticamente por ÚLTIMO à lista de arquivos de regras, para que suas regras vençam os conflitos."

msgid "Rule type"
msgstr "Tipo de regra"

msgid "Plugins (order matters for [Order])"
msgstr "Plugins (a ordem importa para [Order])"

msgid "From plugin panel"
msgstr "Do painel de plugins"

msgid "Add the rows currently SELECTED in the main plugin-order panel, in their displayed order (Ctrl/Shift-click there to multi-select first)."
msgstr "Adicionar as linhas atualmente SELECIONADAS no painel principal de ordem de plugins, na ordem exibida (Ctrl/Shift-clique para selecionar várias primeiro)."

msgid "Group as ANY"
msgstr "Agrupar como ANY"

msgid "Wrap the SELECTED plugins in an [ANY ...] group, for a rule that is satisfied by whichever of several versions someone has installed -- the shape the guidelines use for mods with an XB edition, a Tribunal edition and so on.\n\nSelect the grouped entry and press again to ungroup."
msgstr "Envolver os plugins SELECIONADOS num grupo [ANY …], para uma regra satisfeita por qualquer uma de várias versões instaladas -- a forma que as diretrizes usam para mods com edição XB, edição Tribunal, etc.\n\nSelecione a entrada agrupada e pressione novamente para desagrupar."

msgid "Type a plugin filename and press Enter. mlox wildcards are allowed: ? for one character, * for any run, <VER> for a version number -- though the guidelines ask for these to be used sparingly, since expanding them is slow."
msgstr "Digite um nome de arquivo de plugin e pressione Enter. Curingas do mlox são permitidos: ? para um caractere, * para qualquer sequência, <VER> para um número de versão -- embora as diretrizes peçam usá-los com moderação, já que expandi-los é lento."

msgid "Add"
msgstr "Adicionar"

msgid "Message and source"
msgstr "Mensagem e origem"

msgid "message:"
msgstr "mensagem:"

msgid "What to tell the person, and what to do about it. Ordering rules carry no message; the warning rules are much less useful without one.\n\nA message containing ']' is written in the block form automatically, because a ']' would otherwise close the rule label early."
msgstr "O que dizer à pessoa, e o que fazer a respeito. As regras de ordem não levam mensagem; as regras de aviso são bem menos úteis sem uma.\n\nUma mensagem que contém «]» é escrita automaticamente na forma de bloco, porque um «]» fecharia a etiqueta da regra cedo demais de outra forma."

msgid "(Ref:) source:"
msgstr "(Ref.:) origem:"

msgid "Where this rule's claim comes from: a readme filename, a forum post, a URL. The guidelines ask for one on every rule so that someone else can check it, or correct it.\n\nA URL gets whitespace before the closing parenthesis automatically -- pages that auto-link URLs otherwise swallow the ')' into the link."
msgstr "De onde vem a afirmação desta regra: um nome de arquivo readme, uma postagem de fórum, uma URL. As diretrizes pedem uma em cada regra para que outra pessoa possa verificá-la, ou corrigi-la.\n\nUma URL recebe automaticamente um espaço antes do parêntese de fechamento -- as páginas que vinculam URLs automaticamente engolem o «)» no link de outra forma."

msgid "@section:"
msgstr "@section:"

msgid "Optional heading written above the rule. The rule-base groups rules into sections, roughly one per mod, to keep the file navigable."
msgstr "Cabeçalho opcional escrito acima da regra. A base de regras agrupa as regras em seções, cerca de uma por mod, para manter o arquivo navegável."

msgid "highlight:"
msgstr "destaque:"

msgid "none"
msgstr "nenhum"

msgid "%(mark)s = %(meaning)s"
msgstr "%(mark)s = %(meaning)s"

msgid "; comment:"
msgstr "; comentário:"

msgid "A ';' comment written above the rule. mlox strips these before reading."
msgstr "Um comentário «;» escrito acima da regra. O mlox os remove antes de ler."

msgid "Preview"
msgstr "Prévia"

msgid "Append rule"
msgstr "Anexar a regra"

msgid "Write the rule to the file above. Refused while there is an error: mlox silently discards a rule it cannot use, so this is the only place you would find out.\n\nWarnings do not block -- they are the guidelines' advice, not the parser's requirements."
msgstr "Gravar a regra no arquivo acima. Recusado enquanto houver um erro: o mlox descarta silenciosamente uma regra que não pode usar, então este é o único lugar onde você descobriria.\n\nOs avisos não bloqueiam -- são o conselho das diretrizes, não os requisitos do analisador."

msgid "Rule guide"
msgstr "Guia de regras"

msgid "Open the rule reference: what each rule kind says, how expressions nest, and the conventions the rule-base follows.\n\nIt opens in your browser, so it can sit beside this window while you work."
msgstr "Abrir a referência de regras: o que cada tipo de regra diz, como as expressões se aninham e as convenções que a base de regras segue.\n\nAbre no seu navegador, para poder ficar ao lado desta janela enquanto você trabalha."

msgid "No problems. This rule follows the guidelines.\n"
msgstr "Sem problemas. Esta regra segue as diretrizes.\n"

msgid "Select row(s) in the plugin-order panel first."
msgstr "Selecione primeiro uma ou mais linhas no painel de ordem de plugins."

msgid "Personal rules file"
msgstr "Arquivo de regras pessoal"

msgid "New rule"
msgstr "Nova regra"

msgid "Set a rules file first."
msgstr "Defina primeiro um arquivo de regras."

msgid "Don't append personal rules to mlox_base.txt / mlox_user.txt -- 'Update Rules...' overwrites those. Pick your own file (e.g. mlox_my_rules.txt)."
msgstr "Não anexe regras pessoais a mlox_base.txt / mlox_user.txt -- «Atualizar regras…» as sobrescreve. Escolha o seu próprio arquivo (p. ex. mlox_my_rules.txt)."

msgid "Rule conflicts with the curated order"
msgstr "A regra entra em conflito com a ordem curada"

msgid "This [Order] rule contradicts the frozen curated (MOMW) order for:\n\n%(pairs)s\n\nmlox will DISCARD those orderings (it never reorders the curated list), so the rule won't take effect for them. Write it anyway?"
msgstr "Esta regra [Order] contradiz a ordem curada (MOMW) congelada para:\n\n%(pairs)s\n\no mlox DESCARTARÁ essas ordenações (nunca reordena a lista curada), então a regra não terá efeito para elas. Gravá-la mesmo assim?"

msgid "Rule appended to %(file)s. Re-run '1. Sort' to apply it."
msgstr "Regra anexada a %(file)s. Execute «1. Ordenar» novamente para aplicá-la."

msgid "Update %(name)s"
msgstr "Atualizar %(name)s"

msgid "Save %(name)s as"
msgstr "Salvar %(name)s como"

msgid "the file doesn't exist yet -- it will be created"
msgstr "o arquivo ainda não existe -- ele será criado"

msgid "your copy is ~%(days)d day(s) old"
msgstr "sua cópia tem ~%(days)d dia(s)"

msgid "Download the current %(name)s from MOMW?\n\n%(age)s.\n\nThe download is validated before anything is written; a timestamped .bak of the old file is kept."
msgstr "Baixar o %(name)s atual do MOMW?\n\n%(age)s.\n\nO download é validado antes de gravar qualquer coisa; uma .bak com data e hora do arquivo antigo é mantida."

msgid "Downloading %(name)s..."
msgstr "Baixando %(name)s…"

msgid "Run '1. Sort' first so there's a load order to check against."
msgstr "Execute primeiro «1. Ordenar» para haver uma ordem de carregamento com a qual comparar."

msgid "Choose an OpenMW save"
msgstr "Escolher um salvamento do OpenMW"

msgid "Save check failed: %(error)s"
msgstr "Falha na verificação de salvamento: %(error)s"

msgid "Save check: %(count)d missing dependency! See the log."
msgid_plural "Save check: %(count)d missing dependencies! See the log."
msgstr[0] "Verificação de salvamento: %(count)d dependência ausente! Veja o registro."
msgstr[1] "Verificação de salvamento: %(count)d dependências ausentes! Veja o registro."

msgid "Save Check"
msgstr "Verificação de salvamento"

msgid "Save check: all %(count)d dependencies present."
msgstr "Verificação de salvamento: todas as %(count)d dependências presentes."

msgid "%(file)s: all %(count)d content files it needs are in the current load order. Safe to export."
msgstr "%(file)s: todos os %(count)d arquivos de conteúdo de que precisa estão na ordem de carregamento atual. Seguro para exportar."

msgid "Quick start"
msgstr "Início rápido"

msgid "Read me"
msgstr "Leia-me"

msgid "Writing mlox rules"
msgstr "Escrever regras mlox"

msgid "Documentation not found"
msgstr "Documentação não encontrada"

msgid "%(name)s was not found next to the program.\n\nIt ships alongside the app; if this is a build made without it, the same document is in the project folder."
msgstr "%(name)s não foi encontrado ao lado do programa.\n\nEle é distribuído com o app; se esta é uma build feita sem ele, o mesmo documento está na pasta do projeto."

msgid "Could not open documentation"
msgstr "Não foi possível abrir a documentação"

msgid "%(name)s could not be rendered:\n%(error)s"

msgstr "Экспортировано: %(path)s"

msgid "Cannot edit this mesh"
msgstr "Не удаётся редактировать этот меш"

msgid "Its file could not be read."
msgstr "Не удалось прочитать его файл."

msgid "This mesh does not parse completely, so an edit cannot be written back safely."
msgstr "Этот меш разбирается не полностью, поэтому правку нельзя безопасно записать обратно."

msgid "Editing %(path)s"
msgstr "Редактирование %(path)s"


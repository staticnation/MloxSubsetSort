msgstr[1] "  Забрано %(count)d осиротевших плагина из openmw.cfg"
msgstr[2] "  Забрано %(count)d осиротевших плагинов из openmw.cfg"

msgid "  No unmanaged plugins found -- every content= plugin in the cfg is on the list or in your customizations."
msgstr "  Неуправляемых плагинов не найдено -- каждый плагин content= в cfg есть в списке или в ваших настройках."

msgid "  %(count)d orphan data= path found in openmw.cfg"
msgid_plural "  %(count)d orphan data= paths found in openmw.cfg"
msgstr[0] "  Найден %(count)d осиротевший путь data= в openmw.cfg"
msgstr[1] "  Найдено %(count)d осиротевших пути data= в openmw.cfg"
msgstr[2] "  Найдено %(count)d осиротевших путей data= в openmw.cfg"

msgid "  No unmanaged data= paths found -- every data= path in the cfg is on the list's data-path order or in your customizations."
msgstr "  Неуправляемых путей data= не найдено -- каждый путь data= в cfg есть в порядке data= списка или в ваших настройках."

msgid "  data= paths not classified -- fetch a data-paths cache for this list to surface unmanaged (orphan) data= paths too."
msgstr "  пути data= не классифицированы -- получите кэш data= для этого списка, чтобы также показать неуправляемые (осиротевшие) пути data=."

msgid "groundcover declared by this run"
msgstr "groundcover, объявленный этим запуском"

msgid "  These are written as groundcover= rather than content=. Their data= folders are inserted normally -- OpenMW has to find the file."
msgstr "  Они записываются как groundcover=, а не content=. Их папки data= вставляются как обычно -- OpenMW должен найти файл."

msgid "groundcover plugins held back"
msgstr "плагины groundcover придержаны"

msgid "%(count)d plugin in your subset is already declared as groundcover in openmw.cfg, so it was NOT added to content=:"
msgid_plural "%(count)d plugins in your subset are already declared as groundcover in openmw.cfg, so they were NOT added to content=:"
msgstr[0] "%(count)d плагин в вашем подмножестве уже объявлен как groundcover в openmw.cfg, поэтому он НЕ добавлен в content=:"
msgstr[1] "%(count)d плагина в вашем подмножестве уже объявлены как groundcover в openmw.cfg, поэтому они НЕ добавлены в content=:"
msgstr[2] "%(count)d плагинов в вашем подмножестве уже объявлены как groundcover в openmw.cfg, поэтому они НЕ добавлены в content=:"

msgid "  Their groundcover= lines are untouched and their data= paths are still written, so the grass stays enabled -- as grass. Loading one as content= too would spawn every blade as a real object."
msgstr "  Их строки groundcover= не тронуты, а пути data= всё равно записываются, поэтому трава остаётся включённой -- как трава. Загрузка одного ещё и как content= породила бы каждую травинку как реальный объект."

msgid "  openmw.cfg left untouched (pass --write-cfg to patch it directly)"
msgstr "  openmw.cfg не тронут (передайте --write-cfg, чтобы патчить его напрямую)"

msgid "  WARNING: configurator preview failed: %(error)s"
msgstr "  ПРЕДУПРЕЖДЕНИЕ: предпросмотр конфигуратора не удался: %(error)s"

msgid "\n  DRY RUN: would write %(path)s\n%(toml)s"
msgstr "\n  ПРОБНЫЙ ПРОГОН: записал бы %(path)s\n%(toml)s"

msgid "  Wrote corrected customizations: %(path)s"
msgstr "  Записаны исправленные настройки: %(path)s"

msgid "  Plugins sorted:        %(count)d"
msgstr "  Плагинов отсортировано: %(count)d"

msgid "  Data paths inserted:   %(count)d"
msgstr "  Путей данных вставлено: %(count)d"

msgid "  Rule warnings raised:  %(count)d"
msgstr "  Предупреждений правил:  %(count)d"

msgid "  plugin-order.yml warnings: %(count)d"
msgstr "  Предупреждений plugin-order.yml: %(count)d"

msgid "  openmw.cfg written:    %(answer)s"
msgstr "  openmw.cfg записан:     %(answer)s"

msgid "yes"
msgstr "да"

msgid "no"
msgstr "нет"

msgid "  customizations.toml written: %(answer)s"
msgstr "  customizations.toml записан: %(answer)s"

msgid "Rule files (priority = order below, last = highest -- drag rows to reorder)"
msgstr "Файлы правил (приоритет = порядок ниже, последний = высший -- тяните строки для переупорядочивания)"

msgid "mlox rule files (mlox_base.txt, mlox_user.txt, ...), applied in this order.\nLater files can override/extend earlier ones -- put mlox_base.txt first and your own mlox_user.txt last. Drag rows to reorder, or use the buttons."
msgstr "Файлы правил mlox (mlox_base.txt, mlox_user.txt, …), применяемые в этом порядке.\nБолее поздние файлы могут переопределять/расширять более ранние -- поставьте mlox_base.txt первым, а свой mlox_user.txt последним. Тяните строки для переупорядочивания или используйте кнопки."

msgid "Add File(s)..."
msgstr "Добавить файлы…"

msgid "Browse for one or more mlox rule .txt files to add to the list."
msgstr "Выберите один или несколько .txt-файлов правил mlox для добавления в список."

msgid "Remove Selected"
msgstr "Удалить выбранное"

msgid "Remove the selected rule file from the list (doesn't delete anything on disk)."
msgstr "Удалить выбранный файл правил из списка (ничего не удаляет с диска)."

msgid "Move Up"
msgstr "Вверх"

msgid "Move the selected rule file earlier (lower priority)."
msgstr "Переместить выбранный файл правил раньше (более низкий приоритет)."

msgid "Move Down"
msgstr "Вниз"

msgid "Move the selected rule file later (higher priority)."
msgstr "Переместить выбранный файл правил позже (более высокий приоритет)."

msgid "New Rule..."
msgstr "Новое правило…"

msgid "Write your own mlox [Order]/[NearStart]/[NearEnd] rule without knowing the syntax: pick plugins (or grab the selected rows from the plugin panel), preview the rule, and append it to a personal rules file that loads LAST so it wins conflicts. This is how rules for modern mods get made -- consider contributing good ones upstream."
msgstr "Напишите своё правило mlox [Order]/[NearStart]/[NearEnd], не зная синтаксиса: выберите плагины (или возьмите выбранные строки из панели плагинов), предпросмотрите правило и добавьте его в личный файл правил, который загружается ПОСЛЕДНИМ, чтобы побеждать в конфликтах. Так и создаются правила для современных модов -- подумайте о том, чтобы отправлять хорошие вверх по течению."

msgid "Update Rules..."
msgstr "Обновить правила…"

msgid "Download the CURRENT mlox_base.txt / mlox_user.txt from the actively maintained rules repo (github.com/%(repo)s -- the same source plox uses, and mlox 1.1+ auto-updates from) over the matching files in this list. The old files are kept as timestamped .bak copies. Files with other names (your personal rules) are never touched. Source URL configurable via Sources..."
msgstr "Скачать ТЕКУЩИЕ mlox_base.txt / mlox_user.txt из активно поддерживаемого репозитория правил (github.com/%(repo)s -- тот же источник, что и у plox, и из которого mlox 1.1+ обновляется) поверх соответствующих файлов в этом списке. Старые файлы сохраняются как копии .bak с меткой времени. Файлы с другими именами (ваши личные правила) никогда не трогаются. URL источника настраивается через Источники…"

msgid "Sources..."
msgstr "Источники…"

msgid "Configure WHERE 'Update Rules...' and the plugin-order.yml 'Update...' button download from -- point them at a fork or mirror if upstream moves. Blank fields use the built-in defaults."
msgstr "Настроить, ОТКУДА «Обновить правила…» и кнопка «Обновить…» plugin-order.yml скачивают -- укажите форк или зеркало, если источник переехал. Пустые поля используют встроенные значения по умолчанию."

msgid "(install tkinterdnd2 to drag files in from your file manager)"
msgstr "(установите tkinterdnd2, чтобы перетаскивать файлы из файлового менеджера)"

msgid "Choose a folder for the mlox rule files"
msgstr "Выберите папку для файлов правил mlox"

msgid "Update rules"
msgstr "Обновить правила"

msgid "Download the current mlox rules from github.com/%(repo)s?\n\n%(files)s\n\nThey don't exist yet -- they'll be created here."
msgstr "Скачать текущие правила mlox с github.com/%(repo)s?\n\n%(files)s\n\nИх ещё нет -- они будут созданы здесь."

msgid "Download the current rules from github.com/%(repo)s over these files?\n\n%(age)s\n\nTimestamped .bak copies of the old files are kept."
msgstr "Скачать текущие правила с github.com/%(repo)s поверх этих файлов?\n\n%(age)s\n\nКопии .bak старых файлов с меткой времени сохраняются."

msgid "Move the selected row(s) one position earlier. Works with a multi-selection; you can also drag a contiguous block up with the mouse."
msgstr "Переместить выбранные строки на одну позицию раньше. Работает с множественным выбором; можно также перетащить непрерывный блок вверх мышью."

msgid "Move the selected row(s) one position later. Works with a multi-selection; you can also drag a contiguous block down with the mouse."
msgstr "Переместить выбранные строки на одну позицию позже. Работает с множественным выбором; можно также перетащить непрерывный блок вниз мышью."

msgid "Disable / Enable"
msgstr "Отключить / Включить"

msgid "Opt the selected row in or out of the load order. Disabled rows are dimmed and marked, and are left out of Export: a custom item is simply not inserted, and an item already in your openmw.cfg gets a removeContent/removeData entry in the emitted TOML so it's durably removed. Double-click a row to toggle it too."
msgstr "Включить или исключить выбранную строку из порядка загрузки. Отключённые строки затемняются и помечаются и исключаются из Экспорта: пользовательский элемент просто не вставляется, а элемент, уже имеющийся в вашем openmw.cfg, получает запись removeContent/removeData в сформированном TOML, чтобы быть надёжно удалённым. Двойной щелчок по строке также переключает её."

msgid "Discard any manual dragging and restore the order from the last Sort (your disable/enable choices are kept)."
msgstr "Отбросить любое ручное перетаскивание и восстановить порядок из последней Сортировки (ваш выбор включения/отключения сохраняется)."

msgid "Plugin load order -- drag to override mlox (red = touched by this sort, purple = master problem)"
msgstr "Порядок загрузки плагинов -- тяните, чтобы переопределить mlox (красный = затронуто этой сортировкой, фиолетовый = проблема мастера)"

msgid "Data path order -- drag to adjust (highlighted = your custom paths)"
msgstr "Порядок путей данных -- тяните для настройки (подсвечено = ваши пользовательские пути)"

msgid "Drag & drop is unavailable (tkinterdnd2 or its tkdnd library is missing) -- use the Browse buttons below."
msgstr "Перетаскивание недоступно (отсутствует tkinterdnd2 или его библиотека tkdnd) -- используйте кнопки Обзор ниже."

msgid "Required. The openmw.cfg to read the current content= and data= order from, and (if 'Write openmw.cfg directly' is checked) to patch."
msgstr "Обязательно. openmw.cfg, из которого читать текущий порядок content= и data= и (если отмечено «Записывать openmw.cfg напрямую») который патчить."

msgid "A momw-configurator/umo customizations TOML to pull the plugin/data-path subset from automatically. Optional if you provide a subset file instead -- provide both and they're combined."
msgstr "TOML настроек momw-configurator/umo, из которого автоматически брать подмножество плагинов/путей данных. Необязательно, если вы вместо этого предоставляете файл подмножества -- предоставьте оба, и они объединятся."

msgid "A plain text file (one plugin filename or data folder path per line, '#' comments allowed) or a minimal TOML with subset=[...]/data=[...]. Combined with --emit-toml, this alone is enough to generate a brand new customizations.toml with no existing one required."
msgstr "Обычный текстовый файл (одно имя файла плагина или путь папки данных на строку, комментарии «#» разрешены) или минимальный TOML с subset=[...]/data=[...]. В сочетании с --emit-toml этого одного достаточно, чтобы создать новый customizations.toml без необходимости в существующем."

msgid "Where to write a corrected customizations.toml (sorted insert blocks, re-anchored). Disabled when 'write directly back' below is checked."
msgstr "Куда записать исправленный customizations.toml (отсортированные блоки вставки, переякоренные). Отключено, когда отмечено «переписать напрямую» ниже."

msgid "list name (optional):"
msgstr "имя списка (необязательно):"

msgid "MOMW's plugin-order.yml (source of truth for which plugins belong to which curated list). With the list name above set, curated plugins for that list are excluded from the sort (never reordered) so only your custom additions are touched, and read-only warnings are emitted: redundant, orphan, needs-cleaning, and a base-order drift check. PyYAML used if installed, else a built-in parser."
msgstr "plugin-order.yml от MOMW (источник истины о том, какие плагины принадлежат какому курируемому списку). С заданным именем списка выше курируемые плагины этого списка исключаются из сортировки (никогда не переупорядочиваются), чтобы затрагивались только ваши пользовательские добавления, и выдаются предупреждения только для чтения: избыточный, осиротевший, needs-cleaning и проверка отклонения базового порядка. PyYAML используется, если установлен, иначе встроенный парсер."

msgid "A cached MOMW list data-path order (one relative data-path tail per line). Fetch it for the list named above with the button, then it's read offline: the exact set/order of data= paths that list manages, used to tell a list-managed data= folder from an unmanaged (orphan) one, and to warn on data= paths whose cfg order contradicts the list's."
msgstr "Кэшированный порядок путей данных списка MOMW (по одному относительному пути данных на строку). Получите его для указанного выше списка кнопкой, затем он читается офлайн: точный набор/порядок путей data=, которыми управляет этот список, чтобы отличать управляемую списком папку data= от неуправляемой (осиротевшей) и предупреждать о путях data=, порядок которых в cfg противоречит списку."

msgid "Write directly back to customizations.toml (overwrite in place; a .bak-<timestamp> copy is made first unless backups are disabled below)"
msgstr "Записывать напрямую обратно в customizations.toml (перезаписать на месте; сначала делается копия .bak-<метка времени>, если резервные копии не отключены ниже)"

msgid "Instead of writing to a separate file above, overwrite the customizations.toml given above in place. A timestamped backup is made first (unless disabled), and you'll get a confirmation prompt before it actually happens."
msgstr "Вместо записи в отдельный файл выше перезаписать на месте customizations.toml, указанный выше. Сначала делается резервная копия с меткой времени (если не отключена), и вы получите запрос подтверждения, прежде чем это действительно произойдёт."

msgid "Options"
msgstr "Параметры"

msgid "Dry run (preview only, don't write files)"
msgstr "Пробный прогон (только предпросмотр, файлы не пишутся)"

msgid "When checked, Export shows exactly what it would write without touching any files. Uncheck when you're ready to actually save."
msgstr "Когда отмечено, Экспорт показывает ровно то, что записал бы, не трогая файлы. Снимите отметку, когда готовы действительно сохранить."

msgid "Write openmw.cfg directly"
msgstr "Записывать openmw.cfg напрямую"

msgid "Patch the content=/data= lines in openmw.cfg in place on Export. A .bak-<timestamp> copy is made first unless backups are disabled."
msgstr "Патчить строки content=/data= в openmw.cfg на месте при Экспорте. Сначала делается копия .bak-<метка времени>, если резервные копии не отключены."

msgid "Sort data= paths too"
msgstr "Сортировать также пути data="

msgid "mlox has no concept of data= folder order -- this positions new data= paths using an explicit after/before anchor if you wrote one, or by scanning the folder for plugins and anchoring next to their neighbor in the sorted content= order. Off by default so a plugin-only run can't surprise-reorder data= too. Also required for the data path order panel to populate."
msgstr "mlox не имеет понятия порядка папок data= -- это располагает новые пути data= с явным якорем after/before, если вы его написали, или сканируя папку на плагины и якоря её рядом с их соседом в отсортированном порядке content=. Отключено по умолчанию, чтобы запуск только с плагинами не переупорядочивал data= неожиданно. Также требуется, чтобы панель порядка путей данных заполнялась."

msgid "Skip .bak backup of openmw.cfg"
msgstr "Пропускать резервную копию .bak для openmw.cfg"

msgid "Skip making a timestamped backup before overwriting openmw.cfg and/or an in-place customizations.toml. Not recommended."
msgstr "Пропускать создание резервной копии с меткой времени перед перезаписью openmw.cfg и/или customizations.toml на месте. Не рекомендуется."

msgid "Skip mlox Conflict/Requires/Note warnings"
msgstr "Пропускать предупреждения mlox Conflict/Requires/Note"

msgid "Skip evaluating [Conflict]/[Requires]/[Note] rules against the sorted plugin list. This is purely informational and read-only either way -- it never changes the computed order or what gets written, only whether warnings get printed."
msgstr "Пропускать вычисление правил [Conflict]/[Requires]/[Note] относительно отсортированного списка плагинов. Это чисто информативно и только для чтения в любом случае -- оно никогда не меняет вычисленный порядок или то, что записывается, только печатаются ли предупреждения."

msgid "Create subset text document (on Scan)"
msgstr "Создавать текстовый документ подмножества (при Сканировании)"

msgid "Controls what 'Scan...' does with its result. Checked: write the scanned list to a .txt subset file you choose, and load it (the file stays on disk for reuse). Unchecked: keep the scanned list in memory just for this session and feed it straight to the sort -- nothing is written to disk."
msgstr "Управляет тем, что «Сканировать…» делает с результатом. Отмечено: записать просканированный список в выбранный вами файл подмножества .txt и загрузить его (файл остаётся на диске для повторного использования). Без отметки: держать просканированный список в памяти только для этой сессии и передать его прямо в сортировку -- на диск ничего не записывается."

msgid "Pull unmanaged (orphan) plugins & data paths from openmw.cfg"
msgstr "Забирать неуправляемые (осиротевшие) плагины и пути данных из openmw.cfg"

msgid "Also capture what's ALREADY in openmw.cfg that nothing manages -- neither the curated list (plugin-order.yml) nor your customizations.toml -- so it survives the next momw-configurator rebuild. content= plugins are sorted in; their current cfg order is the starting order until the sort repositions them. Base masters (Morrowind/Tribunal/Bloodmoon) are never touched. Works on its own (no subset file needed) or alongside one.\n\ndata= paths are captured too when a data paths cache is set (fetch it for the list above; it's how a path the list manages is told from one you added). Unmanaged data= paths are highlighted here and, on Export, written into the customizations.toml as inserts anchored to the curated paths -- they are never reordered in place, since they already sit in the cfg's data= order."
msgstr "Также захватывает то, что УЖЕ есть в openmw.cfg и чем ничто не управляет -- ни курируемый список (plugin-order.yml), ни ваш customizations.toml -- чтобы это пережило следующую пересборку momw-configurator. Плагины content= сортируются; их текущий порядок в cfg является начальным, пока сортировка не переставит их. Базовые мастера (Morrowind/Tribunal/Bloodmoon) никогда не затрагиваются. Работает сам по себе (файл подмножества не нужен) или вместе с ним.\n\nПути data= тоже захватываются, когда задан кэш data= (получите его для списка выше; он позволяет отличить путь, которым управляет список, от добавленного вами). Неуправляемые пути data= подсвечиваются здесь и при экспорте записываются в customizations.toml как вставки, привязанные к курируемым путям -- они никогда не переупорядочиваются на месте, поскольку уже находятся в порядке data= из cfg."

msgid "Exclude from conflict / cell scans:"
msgstr "Исключить из сканирований конфликтов / ячеек:"

msgid "Declare as groundcover:"
msgstr "Объявить как groundcover:"

msgid "Keep tes3conv JSON dump"
msgstr "Сохранять экспорт JSON tes3conv"

msgid "Tidy old HTML views"
msgstr "Удалять старые HTML-представления"

msgid "Every conflict map, terrain view and path grid is written to its own timestamped file so you can compare two of them side by side -- which means they pile up, and one map can be several megabytes.\n\nChecked: on exit, the newest 3 of each kind are kept and older ones removed (with their data folders). Only files this tool generated are ever touched -- never anything you saved yourself with a name of your own choosing.\n\nUnchecked: nothing is ever deleted."
msgstr "Каждая карта конфликтов, вид ландшафта и сетка путей записывается в свой файл с меткой времени, чтобы вы могли сравнить две рядом -- а значит, они накапливаются, и одна карта может быть в несколько мегабайт.\n\nОтмечено: при выходе сохраняются 3 новейших каждого вида, а более старые удаляются (с их папками данных). Трогаются только файлы, сгенерированные этим инструментом -- никогда то, что вы сохранили сами под своим именем.\n\nБез отметки: ничего никогда не удаляется."

msgid "tes3conv conversions are written to disk (not held in RAM) and read per-plugin, so big load orders don't blow up memory. They always go to a 'tes3conv_json' folder next to the app and are reused within a run -- so Check Conflicts then Cell Map won't re-run tes3conv (a plugin is only re-converted if it changed). This box just decides what happens on exit: checked = keep that folder (reused next launch too); unchecked = delete it when you close the app."
msgstr "Преобразования tes3conv записываются на диск (не хранятся в ОЗУ) и читаются по плагину, чтобы большие порядки загрузки не раздували память. Они всегда идут в папку «tes3conv_json» рядом с приложением и переиспользуются в пределах запуска -- поэтому «Проверить конфликты», а затем «Карта ячеек» не запустят tes3conv заново (плагин переконвертируется, только если изменился). Этот флажок лишь решает, что происходит при выходе: отмечено = сохранить эту папку (переиспользуется и при следующем запуске); без отметки = удалить её при закрытии приложения."

msgid "Verbose Merged Lands log"
msgstr "Подробный журнал Merged Lands"

msgid "Checked: a Merge Lands run also names every plugin that carries a .mergedlands.toml and exactly what it sets (per layer: on/off and the conflict strategy), and lists every plugin it could not read -- rather than the headline counts. For working out why a merge did what it did.\n\nUnchecked: the normal summary log."
msgstr "Отмечено: запуск Merge Lands также называет каждый плагин, несущий .mergedlands.toml, и ровно то, что он задаёт (по слою: вкл/выкл и стратегия конфликта), и перечисляет каждый плагин, который не удалось прочитать -- вместо основных подсчётов. Чтобы понять, почему объединение сделало то, что сделало.\n\nБез отметки: обычный сводный журнал."

msgid "Log"
msgstr "Журнал"

msgid "Full output from the last Sort and/or Export. Color key: green = a plugin/path this sort inserted or moved, orange = a heads-up (mlox warning, or a rule your curated cfg order overrode), blue = a section header, bright red = an error worth checking. Plain text = frozen base rows left untouched. Colors follow the syntax highlighting theme picked below."
msgstr "Полный вывод последней Сортировки и/или Экспорта. Легенда цветов: зелёный = плагин/путь, который эта сортировка вставила или переместила, оранжевый = уведомление (предупреждение mlox или правило, которое ваш курируемый порядок cfg переопределил), синий = заголовок раздела, ярко-красный = ошибка, которую стоит проверить. Обычный текст = замороженные базовые строки, оставленные нетронутыми. Цвета следуют выбранной ниже теме подсветки синтаксиса."

msgid "Clear Log"
msgstr "Очистить журнал"

msgid "Clear the log panel. Doesn't affect the order panels or any files."
msgstr "Очистить панель журнала. Не влияет ни на панели порядка, ни на какие-либо файлы."

msgid "Save Log As..."
msgstr "Сохранить журнал как…"

msgid "Save the current log contents to a text file."
msgstr "Сохранить текущее содержимое журнала в текстовый файл."

msgid "Theme:"
msgstr "Тема:"

msgid "Color theme for the whole GUI: window/button colors, syntax highlighting here in the Log panel, and the field-diff JSON viewer (Check Conflicts -> double-click a field). Switching re-themes everything immediately, including any windows already open. Built-in: Dracula, Monokai, Atom One Dark, Gruvbox Dark, plus anything you've imported."
msgstr "Цветовая тема для всего интерфейса: цвета окон/кнопок, подсветка синтаксиса здесь в панели Журнала и просмотрщик JSON различий полей (Проверить конфликты -> двойной щелчок по полю). Переключение перекрашивает всё сразу, включая уже открытые окна. Встроенные: Dracula, Monokai, Atom One Dark, Gruvbox Dark, плюс всё, что вы импортировали."

msgid "Import Theme..."
msgstr "Импорт темы…"

msgid "Import a custom theme from a JSON file (background/foreground/select/section/warn/error/ok/inserted/dim as hex colors, plus an optional \"chrome\" object for explicit window/button colors) or a base16 scheme file (.yaml/.yml/.json with base00..base0F -- e.g. from the atelierbram/syntax-highlighting or chriskempson/base16 scheme repos). Window colors not given explicitly are derived from the background. Imported themes are saved and appear in the dropdown from then on."
msgstr "Импортировать пользовательскую тему из файла JSON (background/foreground/select/section/warn/error/ok/inserted/dim как hex-цвета, плюс необязательный объект «chrome» для явных цветов окна/кнопок) или файла схемы base16 (.yaml/.yml/.json с base00..base0F -- напр. из репозиториев atelierbram/syntax-highlighting или chriskempson/base16). Цвета окон, не заданные явно, выводятся из фона. Импортированные темы сохраняются и с тех пор появляются в выпадающем списке."

msgid "Clear Memory"
msgstr "Очистить память"

msgid "Forget every plugin/folder added by hand (drag-drop or the Add buttons) and any scan result held only in memory (not saved to a .txt) -- none of that is shown anywhere on screen, and it otherwise keeps accumulating for the rest of the session. Does not touch any files."
msgstr "Забыть каждый плагин/папку, добавленные вручную (перетаскиванием или кнопками Добавить), и любой результат сканирования, хранимый только в памяти (не сохранённый в .txt) -- ничего из этого не показывается на экране, и иначе оно накапливается до конца сессии. Не трогает никакие файлы."

msgid "Help"
msgstr "Справка"

msgid "Open the program's own documentation -- the Quick start (what to click, in order) or the Read me (every option, in detail) -- rendered as a readable page with a contents sidebar. Works offline; nothing is downloaded."
msgstr "Открыть собственную документацию программы -- Быстрый старт (что нажимать, по порядку) или Прочти меня (каждый параметр подробно) -- в виде читаемой страницы с боковой панелью содержания. Работает офлайн; ничего не скачивается."

msgid "Log syntax highlighting: %(name)s"
msgstr "Подсветка синтаксиса журнала: %(name)s"

msgid "Import syntax highlighting theme"
msgstr "Импорт темы подсветки синтаксиса"

msgid "Import failed"
msgstr "Импорт не удался"

msgid "Couldn't import that theme:\n\n%(error)s"
msgstr "Не удалось импортировать эту тему:\n\n%(error)s"

msgid "Imported and applied theme: %(name)s"
msgstr "Тема импортирована и применена: %(name)s"

msgid "Theme imported"
msgstr "Тема импортирована"

msgid "Imported \"%(name)s\" and set it as the active log theme."
msgstr "«%(name)s» импортирована и задана как активная тема журнала."

msgid "Missing input"
msgstr "Отсутствует ввод"

msgid "Select the mods folder to scan"
msgstr "Выберите папку модов для сканирования"

msgid "Save generated subset file as"
msgstr "Сохранить созданный файл подмножества как"

msgid "Scanning mods folder..."
msgstr "Сканирование папки модов…"

msgid "Scan complete -- %(folders)d folder(s), %(plugins)d plugin(s). Subset file loaded."
msgstr "Сканирование завершено -- папок %(folders)d, плагинов %(plugins)d. Файл подмножества загружен."

msgid "Scan complete -- %(folders)d folder(s), %(plugins)d plugin(s). Held in memory (no file written)."
msgstr "Сканирование завершено -- папок %(folders)d, плагинов %(plugins)d. Хранится в памяти (файл не записан)."

msgid "Add plugin..."
msgstr "Добавить плагин…"

msgid "Include a plugin the Scan missed -- e.g. one sitting outside a recognised mod folder. It joins your custom subset on the next Sort. You can also drag a plugin file onto the list above from your file manager."
msgstr "Включить плагин, который Сканирование пропустило -- напр. находящийся вне распознанной папки мода. Он присоединится к вашему пользовательскому подмножеству при следующей Сортировке. Можно также перетащить файл плагина в список выше из файлового менеджера."

msgid "(install tkinterdnd2 to drag a plugin in)"
msgstr "(установите tkinterdnd2, чтобы перетащить плагин)"

msgid "Add data folder..."
msgstr "Добавить папку данных…"

msgid "Include a folder the Scan missed -- e.g. an OpenMW Lua mod with a non-standard layout (no meshes/textures/... folder and no plugin). It joins your data paths on the next Sort; tick 'Sort data= paths too' to place it in the load order. You can also drag a folder onto the list above from your file manager."
msgstr "Включить папку, которую Сканирование пропустило -- напр. Lua-мод OpenMW с нестандартной структурой (нет папки meshes/textures/… и нет плагина). Она присоединится к вашим путям данных при следующей Сортировке; отметьте «Сортировать также пути data=», чтобы поместить её в порядок загрузки. Можно также перетащить папку в список выше из файлового менеджера."

msgid "(install tkinterdnd2 to drag a folder in)"
msgstr "(установите tkinterdnd2, чтобы перетащить папку)"

msgid "Select a data folder to add"
msgstr "Выберите папку данных для добавления"

msgid "Select plugin(s) to add"
msgstr "Выберите плагины для добавления"

msgid "Plugins"
msgstr "Плагины"

msgid "Added plugin"
msgstr "Плагин добавлен"

msgid "Already added"
msgstr "Уже добавлено"

msgid "Added data folder"
msgstr "Папка данных добавлена"

msgid "  Tick 'Sort data= paths too' to place it."
msgstr "  Отметьте «Сортировать также пути data=», чтобы поместить её."

msgid "Not a plugin or folder: %(path)s"
msgstr "Не плагин и не папка: %(path)s"

msgid "Nothing to clear."
msgstr "Нечего очищать."

msgid "%(n)d manual plugin(s)"
msgstr "плагинов вручную: %(n)d"

msgid "%(n)d manual data folder(s)"
msgstr "папок данных вручную: %(n)d"

msgid "the in-memory scan result"
msgstr "результат сканирования в памяти"

msgid "Clear memory?"
msgstr "Очистить память?"

msgid "This forgets everything added by hand this session and any scan result held in memory (not written to a subset file):\n\n%(summary)s\n\nThey will no longer be included on the next Sort. This does not touch the subset file field, remembered paths, or any file on disk. Continue?"
msgstr "Это забывает всё, добавленное вручную в этой сессии, и любой результат сканирования, хранимый в памяти (не записанный в файл подмножества):\n\n%(summary)s\n\nОни больше не будут включены при следующей Сортировке. Это не трогает ни поле файла подмножества, ни запомненные пути, ни какой-либо файл на диске. Продолжить?"

msgid "Cleared: %(summary)s"
msgstr "Очищено: %(summary)s"

msgid "%(what)s (%(n)d added, applied on Sort): %(value)s"
msgstr "%(what)s (добавлено %(n)d, применяется при Сортировке): %(value)s"

msgid "Sorting..."
msgstr "Сортировка…"

msgid ", %(count)d yml warning(s)"
msgstr ", предупреждений yml: %(count)d"

msgid "Sorted %(plugins)d plugin(s), %(warnings)d rule warning(s)%(yml)s. Drag to adjust, then Export."
msgstr "Отсортировано плагинов: %(plugins)d, предупреждений правил: %(warnings)d%(yml)s. Тяните для настройки, затем Экспорт."

msgid "openmw.cfg changed"
msgstr "openmw.cfg изменён"

msgid "openmw.cfg has changed on disk since you ran '1. Sort' (did momw-configurator re-run?).\n\nThe order on screen was computed against the OLD contents. It's safer to re-Sort first.\n\nExport anyway?"
msgstr "openmw.cfg изменился на диске с тех пор, как вы выполнили «1. Сортировать» (был ли momw-configurator перезапущен?).\n\nПорядок на экране был вычислен относительно СТАРОГО содержимого. Безопаснее сначала пересортировать.\n\nВсё равно экспортировать?"

msgid "Overwrite customizations.toml?"
msgstr "Перезаписать customizations.toml?"

msgid "This will overwrite:\n%(path)s\n\nin place%(note)s. Continue?"
msgstr "Это перезапишет:\n%(path)s\n\nна месте%(note)s. Продолжить?"

msgid "Exporting..."
msgstr "Экспорт…"

msgid "Export done -- cfg written: %(cfg)s, toml written: %(toml)s."
msgstr "Экспорт завершён -- cfg записан: %(cfg)s, toml записан: %(toml)s."

msgid "Building cell map..."
msgstr "Построение карты ячеек…"

msgid "\n\nThis REPLACES the existing %(name)s."
msgstr "\n\nЭто ЗАМЕНЯЕТ существующий %(name)s."

msgid "Build Merged Lands.esp?"
msgstr "Построить Merged Lands.esp?"

msgid "A new plugin will be written to:\n%(path)s\n\nIt carries terrain only -- no references, objects or scripts -- so everything placed in those cells stays where it is. Your mods are NOT modified, and deleting the merged plugin restores your previous behaviour completely.\n\nLoad it LAST, and back up your saves before playing with it the first time.%(existing)s\n\nYes: write it here.   No: choose a different folder."
msgstr "Новый плагин будет записан в:\n%(path)s\n\nОн несёт только ландшафт -- без ссылок, объектов или скриптов -- поэтому всё размещённое в этих ячейках остаётся на месте. Ваши моды НЕ изменяются, а удаление объединённого плагина полностью восстанавливает ваше прежнее поведение.\n\nЗагружайте его ПОСЛЕДНИМ и делайте резервные копии сохранений, прежде чем играть с ним впервые.%(existing)s\n\nДа: записать здесь.   Нет: выбрать другую папку."

msgid "Merging land..."
msgstr "Объединение ландшафта…"

msgid "Folder not found"
msgstr "Папка не найдена"

msgid "%(path)s no longer exists. Please choose where to write."
msgstr "%(path)s больше не существует. Пожалуйста, выберите, куда записать."

msgid "Data Files not found"
msgstr "Data Files не найдена"

msgid "Could not work out which folder holds your plugins, so there is no sensible place to put the merged plugin. Use 'Merged Lands folder...' to choose one."
msgstr "Не удалось определить, в какой папке ваши плагины, поэтому нет разумного места для объединённого плагина. Используйте «Папка Merged Lands…», чтобы выбрать её."

msgid "Where should Merged Lands.esp be written?"
msgstr "Куда записать Merged Lands.esp?"

msgid "Not a data folder"
msgstr "Не папка данных"

msgid "%(path)s is not one of the folders OpenMW reads, so it will not find the merged plugin there.\n\nAdd this line to openmw.cfg:\n\ndata=\"%(path)s\"\n\nand put 'content=%(name)s' last."
msgstr "%(path)s не является одной из папок, которые читает OpenMW, поэтому он не найдёт там объединённый плагин.\n\nДобавьте эту строку в openmw.cfg:\n\ndata=\"%(path)s\"\n\nи поставьте «content=%(name)s» последним."

msgid " MERGE LANDS"
msgstr " ОБЪЕДИНЕНИЕ ЛАНДШАФТА"

msgid "Merge produced nothing to write."
msgstr "Объединение не дало ничего для записи."

msgid "Merged Lands written: %(cells)d cell(s)."
msgstr "Merged Lands записан: ячеек %(cells)d."

msgid "Merge failed -- see log."
msgstr "Объединение не удалось -- см. журнал."

msgid "%(contested)d vertex/vertices were edited by more than one mod; the later one in your load order won each."
msgstr "Вершин, отредактированных более чем одним модом: %(contested)d; более поздний в вашем порядке загрузки победил в каждой."

msgid "%(major)d were blended far from a mod's intent where a .mergedlands.toml asked to Resolve."
msgstr "%(major)d были смешаны далеко от замысла мода там, где .mergedlands.toml просил Resolve."

msgid "Merged Lands built"
msgstr "Merged Lands построен"

msgid "Written to:\n%(path)s\n\nEnable it and place it LAST in your load order.\n\n%(cells)d land record(s), %(textures)d land texture(s).\n%(detail)s"
msgstr "Записано в:\n%(path)s\n\nВключите его и поставьте ПОСЛЕДНИМ в порядке загрузки.\n\nЗаписей ландшафта: %(cells)d, текстур земли: %(textures)d.\n%(detail)s"

msgid "Pick a plugin to write a .mergedlands.toml for"
msgstr "Выберите плагин, для которого записать .mergedlands.toml"

msgid "Morrowind plugins"
msgstr "Плагины Morrowind"

msgid "Existing .mergedlands.toml could not be read"
msgstr "Не удалось прочитать существующий .mergedlands.toml"

msgid "%(name)s will be replaced from defaults:\n\n%(err)s"
msgstr "%(name)s будет заменён значениями по умолчанию:\n\n%(err)s"

msgid "Merge settings: %(name)s"
msgstr "Настройки объединения: %(name)s"

msgid "Choose how %(name)s's landscape edits merge. Uncheck a layer to keep this plugin from touching it; set a strategy for how its edits resolve where they collide with another mod. The defaults behave as if there were no file."
msgstr "Выберите, как объединяются правки ландшафта от %(name)s. Снимите отметку со слоя, чтобы не дать этому плагину его трогать; задайте стратегию, как его правки разрешаются там, где сталкиваются с другим модом. Значения по умолчанию ведут себя так, будто файла нет."

msgid "meta_type:"
msgstr "meta_type:"

msgid "Patch = a hand-written settings file (the usual choice). Auto = default behaviour. MergedLands marks a plugin the tool generated so a re-run ignores it -- do not set that on an ordinary mod."
msgstr "Patch = написанный вручную файл настроек (обычный выбор). Auto = поведение по умолчанию. MergedLands помечает плагин, сгенерированный инструментом, чтобы повторный запуск его игнорировал -- не ставьте это на обычный мод."

msgid "Layers"
msgstr "Слои"

msgid "include"
msgstr "включить"

msgid "layer"
msgstr "слой"

msgid "conflict strategy"
msgstr "стратегия конфликта"

msgid "Vertex heights -- and the normals stored with them."
msgstr "Высоты вершин -- и хранящиеся с ними нормали."

msgid "Baked vertex colours (terrain lighting)."
msgstr "Запечённые цвета вершин (освещение ландшафта)."

msgid "Which land texture paints each square."
msgstr "Какая текстура земли красит каждый квадрат."

msgid "The low-resolution world-map heightmap."
msgstr "Низкоразрешающая карта высот мировой карты."

msgid "Auto = later plugin wins for entries it changed Â· Overwrite = this plugin wins collisions Â· Ignore = keep the earlier edit Â· Resolve = blend conflicting numbers Â· Curvature = structure-weighted blend (ours)."
msgstr "Auto = более поздний плагин побеждает для записей, которые изменил · Overwrite = этот плагин побеждает в столкновениях · Ignore = сохранить более раннюю правку · Resolve = смешать конфликтующие числа · Curvature = взвешенное по структуре смешивание (наше)."

msgid "Preview:"
msgstr "Предпросмотр:"

msgid "Write .mergedlands.toml"
msgstr "Записать .mergedlands.toml"

msgid "Could not write .mergedlands.toml"
msgstr "Не удалось записать .mergedlands.toml"

msgid "Wrote %(name)s."
msgstr "%(name)s записан."

msgid "Merge settings written"
msgstr "Настройки объединения записаны"

msgid "Wrote:\n%(path)s\n\nRun Merge Lands to apply it."
msgstr "Записано:\n%(path)s\n\nЗапустите Merge Lands, чтобы применить это."

msgid " CELL MAP"
msgstr " КАРТА ЯЧЕЕК"

msgid "native esp reader"
msgstr "встроенный чтец esp"

msgid "  %(exterior)d exterior + %(interior)d interior cell(s) touched across %(scanned)d plugin(s)."
msgstr "  Затронуто внешних ячеек %(exterior)d + внутренних %(interior)d в %(scanned)d плагинах."

msgid "  Map written to: %(path)s"
msgstr "  Карта записана в: %(path)s"

msgid "Cell map ready (%(exterior)d exterior, %(interior)d interior)."
msgstr "Карта ячеек готова (внешних %(exterior)d, внутренних %(interior)d)."

msgid "Open in browser"
msgstr "Открыть в браузере"

msgid "(inline render failed -- use 'Open in browser'. The 3D and nav views need a real browser engine.)"
msgstr "(встроенная отрисовка не удалась -- используйте «Открыть в браузере». Виды 3D и навигации требуют настоящего браузерного движка.)"

msgid "Save HTML..."
msgstr "Сохранить HTML…"

msgid "(inline render failed - use 'Open in browser' for the full map)"
msgstr "(встроенная отрисовка не удалась -- используйте «Открыть в браузере» для полной карты)"

msgid "Save cell map"
msgstr "Сохранить карту ячеек"

msgid "Cell map saved: %(path)s"
msgstr "Карта ячеек сохранена: %(path)s"

msgid "If upstream moves or a new fork takes over, point the updaters at the new location here. Blank = built-in defaults. Downloads are always validated before anything is overwritten."
msgstr "Если источник переедет или новый форк возьмёт верх, укажите обновляющим здесь новое расположение. Пусто = встроенные значения по умолчанию. Загрузки всегда проверяются, прежде чем что-либо перезаписывается."

msgid "mlox rules URL template:"
msgstr "Шаблон URL правил mlox:"

msgid "Where 'Update Rules...' downloads from. Must contain {name}, which is replaced with mlox_base.txt / mlox_user.txt per file.\nDefault: %(url)s"
msgstr "Откуда «Обновить правила…» скачивает. Должен содержать {name}, который заменяется на mlox_base.txt / mlox_user.txt для каждого файла.\nПо умолчанию: %(url)s"

msgid "default: %(url)s"
msgstr "по умолчанию: %(url)s"

msgid "plugin-order.yml URL:"
msgstr "URL plugin-order.yml:"

msgid "Where the plugin-order.yml 'Update...' button downloads from. Blank tries the built-in candidates in order.\nDefault: %(url)s"
msgstr "Откуда скачивает кнопка «Обновить…» plugin-order.yml. Пусто пробует встроенные варианты по порядку.\nПо умолчанию: %(url)s"

msgid "default: %(url)s..."
msgstr "по умолчанию: %(url)s…"

msgid "Download sources"
msgstr "Скачать источники"

msgid "The rules URL template must contain {name} (it's replaced with the rule filename)."
msgstr "Шаблон URL правил должен содержать {name} (он заменяется на имя файла правил)."

msgid "Reset to defaults"
msgstr "Сбросить к значениям по умолчанию"

msgid "Save & Close"
msgstr "Сохранить и закрыть"

msgid "New mlox rule"
msgstr "Новое правило mlox"

msgid "rules file:"
msgstr "файл правил:"

msgid "Personal rules file the rule is appended to (created with a header if new). Use your OWN file, not mlox_base/mlox_user -- those get overwritten by 'Update Rules...'. It's auto-added to the rule-files list LAST, so your rules win conflicts."
msgstr "Личный файл правил, к которому добавляется правило (создаётся с заголовком, если новый). Используйте СВОЙ файл, не mlox_base/mlox_user -- те перезаписываются «Обновить правила…». Он автоматически добавляется ПОСЛЕДНИМ в список файлов правил, чтобы ваши правила побеждали в конфликтах."

msgid "Rule type"
msgstr "Тип правила"

msgid "Plugins (order matters for [Order])"
msgstr "Плагины (порядок важен для [Order])"

msgid "From plugin panel"
msgstr "Из панели плагинов"

msgid "Add the rows currently SELECTED in the main plugin-order panel, in their displayed order (Ctrl/Shift-click there to multi-select first)."
msgstr "Добавить строки, сейчас ВЫДЕЛЕННЫЕ в главной панели порядка плагинов, в их отображаемом порядке (Ctrl/Shift-щелчок, чтобы сначала выделить несколько)."

msgid "Group as ANY"
msgstr "Сгруппировать как ANY"

msgid "Wrap the SELECTED plugins in an [ANY ...] group, for a rule that is satisfied by whichever of several versions someone has installed -- the shape the guidelines use for mods with an XB edition, a Tribunal edition and so on.\n\nSelect the grouped entry and press again to ungroup."
msgstr "Обернуть ВЫДЕЛЕННЫЕ плагины в группу [ANY …], для правила, удовлетворяемого любой из нескольких установленных версий -- форма, которую руководства используют для модов с изданием XB, изданием Tribunal и т. д.\n\nВыделите сгруппированную запись и нажмите снова, чтобы разгруппировать."

msgid "Type a plugin filename and press Enter. mlox wildcards are allowed: ? for one character, * for any run, <VER> for a version number -- though the guidelines ask for these to be used sparingly, since expanding them is slow."
msgstr "Введите имя файла плагина и нажмите Enter. Разрешены подстановочные знаки mlox: ? для одного символа, * для любой последовательности, <VER> для номера версии -- хотя руководства просят использовать их умеренно, так как их раскрытие медленно."

msgid "Add"
msgstr "Добавить"

msgid "Message and source"
msgstr "Сообщение и источник"

msgid "message:"
msgstr "сообщение:"

msgid "What to tell the person, and what to do about it. Ordering rules carry no message; the warning rules are much less useful without one.\n\nA message containing ']' is written in the block form automatically, because a ']' would otherwise close the rule label early."
msgstr "Что сказать человеку и что с этим делать. Правила порядка не несут сообщения; правила-предупреждения без него гораздо менее полезны.\n\nСообщение, содержащее «]», автоматически записывается в блочной форме, потому что «]» иначе закрыло бы метку правила слишком рано."

msgid "(Ref:) source:"
msgstr "(Ссылка:) источник:"

msgid "Where this rule's claim comes from: a readme filename, a forum post, a URL. The guidelines ask for one on every rule so that someone else can check it, or correct it.\n\nA URL gets whitespace before the closing parenthesis automatically -- pages that auto-link URLs otherwise swallow the ')' into the link."
msgstr "Откуда исходит утверждение этого правила: имя файла readme, сообщение форума, URL. Руководства просят его на каждом правиле, чтобы кто-то другой мог его проверить или исправить.\n\nURL автоматически получает пробел перед закрывающей скобкой -- страницы, которые автоматически делают ссылки из URL, иначе проглатывают «)» в ссылку."

msgid "@section:"
msgstr "@section:"

msgid "Optional heading written above the rule. The rule-base groups rules into sections, roughly one per mod, to keep the file navigable."
msgstr "Необязательный заголовок, написанный над правилом. База правил группирует правила в разделы, примерно по одному на мод, чтобы файл оставался удобным для навигации."

msgid "highlight:"
msgstr "подсветка:"

msgid "none"
msgstr "нет"

msgid "%(mark)s = %(meaning)s"
msgstr "%(mark)s = %(meaning)s"

msgid "; comment:"
msgstr "; комментарий:"

msgid "A ';' comment written above the rule. mlox strips these before reading."
msgstr "Комментарий «;», написанный над правилом. mlox удаляет их перед чтением."

msgid "Append rule"
msgstr "Добавить правило"

msgid "Write the rule to the file above. Refused while there is an error: mlox silently discards a rule it cannot use, so this is the only place you would find out.\n\nWarnings do not block -- they are the guidelines' advice, not the parser's requirements."
msgstr "Записать правило в файл выше. Отклоняется, пока есть ошибка: mlox молча отбрасывает правило, которое не может использовать, поэтому это единственное место, где вы об этом узнаете.\n\nПредупреждения не блокируют -- это совет руководств, не требования парсера."

msgid "Rule guide"
msgstr "Руководство по правилам"

msgid "Open the rule reference: what each rule kind says, how expressions nest, and the conventions the rule-base follows.\n\nIt opens in your browser, so it can sit beside this window while you work."
msgstr "Открыть справку по правилам: что говорит каждый вид правила, как вкладываются выражения и каким соглашениям следует база правил.\n\nОна открывается в вашем браузере, чтобы могла стоять рядом с этим окном, пока вы работаете."

msgid "No problems. This rule follows the guidelines.\n"
msgstr "Проблем нет. Это правило следует руководствам.\n"

msgid "Select row(s) in the plugin-order panel first."
msgstr "Сначала выберите строки в панели порядка плагинов."

msgid "Personal rules file"
msgstr "Личный файл правил"

msgid "New rule"
msgstr "Новое правило"

msgid "Set a rules file first."
msgstr "Сначала задайте файл правил."

msgid "Don't append personal rules to mlox_base.txt / mlox_user.txt -- 'Update Rules...' overwrites those. Pick your own file (e.g. mlox_my_rules.txt)."
msgstr "Не добавляйте личные правила в mlox_base.txt / mlox_user.txt -- «Обновить правила…» их перезаписывает. Выберите свой файл (напр. mlox_my_rules.txt)."

msgid "Rule conflicts with the curated order"
msgstr "Правило конфликтует с курируемым порядком"

msgid "This [Order] rule contradicts the frozen curated (MOMW) order for:\n\n%(pairs)s\n\nmlox will DISCARD those orderings (it never reorders the curated list), so the rule won't take effect for them. Write it anyway?"
msgstr "Это правило [Order] противоречит замороженному курируемому (MOMW) порядку для:\n\n%(pairs)s\n\nmlox ОТБРОСИТ эти упорядочивания (он никогда не переупорядочивает курируемый список), поэтому правило для них не подействует. Всё равно записать?"

msgid "Rule appended to %(file)s. Re-run '1. Sort' to apply it."
msgstr "Правило добавлено в %(file)s. Выполните «1. Сортировать» снова, чтобы применить его."

msgid "Update %(name)s"
msgstr "Обновить %(name)s"

msgid "Save %(name)s as"
msgstr "Сохранить %(name)s как"

msgid "the file doesn't exist yet -- it will be created"
msgstr "файла ещё нет -- он будет создан"

msgid "your copy is ~%(days)d day(s) old"
msgstr "вашей копии около %(days)d дн."

msgid "Download the current %(name)s from MOMW?\n\n%(age)s.\n\nThe download is validated before anything is written; a timestamped .bak of the old file is kept."
msgstr "Скачать текущий %(name)s с MOMW?\n\n%(age)s.\n\nЗагрузка проверяется, прежде чем что-либо записывается; сохраняется копия .bak старого файла с меткой времени."

msgid "Downloading %(name)s..."
msgstr "Скачивание %(name)s…"

msgid "Fetch data paths"
msgstr "Получить пути данных"

msgid "Set the list name field first -- data paths are fetched per list."
msgstr "Сначала заполните поле имени списка -- пути данных получаются по списку."

msgid "Save data paths cache as"
msgstr "Сохранить кэш путей данных как"

msgid "Fetch the data-path order for '%(list)s' from MOMW's cfg-generator API and cache it to:\n%(path)s\n\nThe response is validated before anything is written; any old cache is kept as a timestamped .bak."
msgstr "Получить порядок путей данных для '%(list)s' из API cfg-generator MOMW и сохранить в кэш:\n%(path)s\n\nОтвет проверяется до записи; старый кэш сохраняется как .bak с меткой времени."

msgid "Fetching data paths for '%(list)s'..."
msgstr "Получение путей данных для '%(list)s'..."

msgid "Run '1. Sort' first so there's a load order to check against."
msgstr "Сначала выполните «1. Сортировать», чтобы было с чем сверять порядок загрузки."

msgid "Choose an OpenMW save"
msgstr "Выберите сохранение OpenMW"

msgid "Save check failed: %(error)s"
msgstr "Проверка сохранения не удалась: %(error)s"

msgid "Save check: %(count)d missing dependency! See the log."
msgid_plural "Save check: %(count)d missing dependencies! See the log."
msgstr[0] "Проверка сохранения: отсутствует %(count)d зависимость! См. журнал."
msgstr[1] "Проверка сохранения: отсутствуют %(count)d зависимости! См. журнал."
msgstr[2] "Проверка сохранения: отсутствует %(count)d зависимостей! См. журнал."

msgid "Save Check"
msgstr "Проверка сохранения"

msgid "Save check: all %(count)d dependencies present."
msgstr "Проверка сохранения: все зависимости присутствуют (%(count)d)."

msgid "%(file)s: all %(count)d content files it needs are in the current load order. Safe to export."
msgstr "%(file)s: все нужные ему файлы контента (%(count)d) есть в текущем порядке загрузки. Безопасно экспортировать."

msgid "Quick start"
msgstr "Быстрый старт"

msgid "Read me"
msgstr "Прочти меня"

msgid "Writing mlox rules"
msgstr "Написание правил mlox"

msgid "Documentation not found"
msgstr "Документация не найдена"

msgid "%(name)s was not found next to the program.\n\nIt ships alongside the app; if this is a build made without it, the same document is in the project folder."
msgstr "%(name)s не найден рядом с программой.\n\nОн поставляется вместе с приложением; если это сборка без него, тот же документ находится в папке проекта."

msgid "Could not open documentation"
msgstr "Не удалось открыть документацию"

msgid "%(name)s could not be rendered:\n%(error)s"
msgstr "%(name)s не удалось отрисовать:\n%(error)s"

msgid "Set openmw.cfg (or run a Sort) so I know where to look."
msgstr "Задайте openmw.cfg (или выполните Сортировку), чтобы я знал, где искать."

msgid "Scanning for backups..."
msgstr "Поиск резервных копий…"

msgid "Found %(count)d backup file."
msgid_plural "Found %(count)d backup files."
msgstr[0] "Найден %(count)d файл резервной копии."
msgstr[1] "Найдено %(count)d файла резервных копий."
msgstr[2] "Найдено %(count)d файлов резервных копий."

msgid "Backup scan failed: %(error)s"
msgstr "Сканирование резервных копий не удалось: %(error)s"

msgid "%(count)d backup file. Restore copies the backup over its original; Delete removes the backup file itself."
msgid_plural "%(count)d backup files. Restore copies the backup over its original; Delete removes the backup file itself."
msgstr[0] "%(count)d файл резервной копии. Восстановление копирует копию поверх её оригинала; Удаление убирает сам файл копии."
msgstr[1] "%(count)d файла резервных копий. Восстановление копирует копию поверх её оригинала; Удаление убирает сам файл копии."
msgstr[2] "%(count)d файлов резервных копий. Восстановление копирует копию поверх её оригинала; Удаление убирает сам файл копии."

msgid "Restore"
msgstr "Восстановить"

msgid "Copy %(count)d backup over its original (overwriting it)?"
msgid_plural "Copy %(count)d backups over their originals (overwriting them)?"
msgstr[0] "Скопировать %(count)d копию поверх её оригинала (перезаписав его)?"
msgstr[1] "Скопировать %(count)d копии поверх их оригиналов (перезаписав их)?"
msgstr[2] "Скопировать %(count)d копий поверх их оригиналов (перезаписав их)?"

msgid "Restored %(count)d backup%(failed)s. Re-run '1. Sort' to refresh checks."
msgid_plural "Restored %(count)d backups%(failed)s. Re-run '1. Sort' to refresh checks."
msgstr[0] "Восстановлена %(count)d копия%(failed)s. Выполните «1. Сортировать» снова для обновления проверок."
msgstr[1] "Восстановлено %(count)d копии%(failed)s. Выполните «1. Сортировать» снова для обновления проверок."
msgstr[2] "Восстановлено %(count)d копий%(failed)s. Выполните «1. Сортировать» снова для обновления проверок."

msgid ", %(fail)d failed"
msgstr ", с ошибкой %(fail)d"

msgid "Delete"
msgstr "Удалить"

msgid "Permanently delete %(count)d backup file?"
msgid_plural "Permanently delete %(count)d backup files?"
msgstr[0] "Безвозвратно удалить %(count)d файл резервной копии?"
msgstr[1] "Безвозвратно удалить %(count)d файла резервных копий?"
msgstr[2] "Безвозвратно удалить %(count)d файлов резервных копий?"

msgid "Deleted %(count)d backup file."
msgid_plural "Deleted %(count)d backup files."
msgstr[0] "Удалён %(count)d файл резервной копии."
msgstr[1] "Удалено %(count)d файла резервных копий."
msgstr[2] "Удалено %(count)d файлов резервных копий."

msgid "Restore Selected"
msgstr "Восстановить выбранное"

msgid "Delete Selected"
msgstr "Удалить выбранное"

msgid "Refresh"
msgstr "Обновить"

msgid "Linting plugins..."
msgstr "Проверка плагинов…"

msgid " LINT (tes3lint-style checks, native)"
msgstr " ПРОВЕРКА (проверки в стиле tes3lint, встроенные)"

msgid "\n  No lint findings. Clean bill of health."
msgstr "\n  Замечаний по проверке нет. Всё в порядке."

msgid "Lint: %(count)d finding. See the log."
msgid_plural "Lint: %(count)d findings. See the log."
msgstr[0] "Проверка: %(count)d замечание. См. журнал."
msgstr[1] "Проверка: %(count)d замечания. См. журнал."
msgstr[2] "Проверка: %(count)d замечаний. См. журнал."

msgid "Lint: no findings."
msgstr "Проверка: замечаний нет."
